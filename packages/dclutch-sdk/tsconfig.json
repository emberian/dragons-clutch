{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "verbatimModuleSyntax": false,
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "incremental": false,
    "lib": ["esnext"],
    "types": ["node"]
  },
  "include": ["index.ts", "lib/**/*.ts", "fixtures/**/*.ts"],
  "exclude": ["node_modules"]
}
