die() { printf 'dclutch-successor-validator: %s\n' "$*" >&2; exit 1; }

# Derive the whole port block from one base. Sole owner of the offsets.
set_port_block() {
  local base=$1
  [[ "$base" =~ ^[1-9][0-9]*$ ]] || die "RPC port must be a positive decimal: $base"
  [[ "$base" -ge "$MIN_RPC_PORT" ]] || die "RPC port must be >= $MIN_RPC_PORT: $base"
  [[ "$base" -le "$MAX_RPC_PORT" ]] || die "RPC port must be <= $MAX_RPC_PORT so the block ($base-$((base + 41))) fits: $base"
  RPC_PORT="$base"
  FAUCET_PORT=$((base + 2))
  GOSSIP_PORT=$((base + 3))
  DYNAMIC_PORT_RANGE="$((base + 10))-$((base + 41))"
}

# Precedence: `--rpc-port` flag, then DCLUTCH_RPC_PORT, then 20890. The flag
# wins because a caller that passes it is coordinating two processes and must
# not be silently overridden by an environment it did not set.
resolve_start_port() {
  local flag=${1-}
  if [[ -n "$flag" ]]; then set_port_block "$flag"; return; fi
  set_port_block "${DCLUTCH_RPC_PORT:-$DEFAULT_RPC_PORT}"
}

# A started ledger records its own origin in its profile. `status` and `stop`
# read it back from there rather than re-deriving it, so a ledger started on a
# nonstandard port is still addressable by a caller that knows only its path.
port_from_profile() {
  local ledger=$1 port
  [[ -f "$ledger/$PROFILE_NAME" ]] || return 1
  port=$(jq -r '.network.rpc_url | capture(":(?<port>[0-9]+)$") | .port' \
    "$ledger/$PROFILE_NAME" 2>/dev/null) || return 1
  [[ "$port" =~ ^[1-9][0-9]*$ ]] || return 1
  printf '%s\n' "$port"
}


# ------------------------------------------------------------- the watchdog
#
# The supervisor owns this validator's lifetime and kills it on Drop. That is
# correct and it is not enough: a supervisor that is SIGKILLed -- a rate-limit
# kill, a harness timeout, a `kill -9` on the wrong pid -- never runs Drop, and
# the validator reparents to PID 1 and lives forever. That happened on
# 2026-08-27: a finished campaign left a validator with PPID 1 holding the one
# port every tier-1 run needed, with no bootstrap, launcher or gauntlet process
# alive anywhere. Nothing could reach it either: the founder key existed only
# in the dead supervisor's memory, so the chain it was holding was unusable by
# anyone while blocking everyone.
#
# Containment has to be STRUCTURAL, not a caller remembering to be polite. This
# runs before the exec, so `$$` is already the pid the validator will have --
# exec preserves it. When the supervisor is gone, the validator goes.
#
# Pid reuse is the one hazard, and it is closed rather than narrowed: the
# watchdog exits the moment its target stops being a solana-test-validator, and
# it re-checks the command line immediately before signalling. It never sends a
# signal to a pid it has not just confirmed.
spawn_supervisor_watchdog() {
  local supervisor=$1 target=$$
  (
    still_ours() {
      local command_line
      command_line=$(ps -o command= -p "$target" 2>/dev/null) || return 1
      [[ "$command_line" == *"solana-test-validator"* ]]
    }
    while kill -0 "$supervisor" 2>/dev/null; do
      still_ours || exit 0
      sleep 1
    done
    still_ours || exit 0
    kill -TERM "$target" 2>/dev/null || exit 0
    for _ in $(seq 1 40); do
      sleep 0.25
      still_ours || exit 0
    done
    still_ours && kill -KILL "$target" 2>/dev/null
  ) </dev/null >/dev/null 2>&1 &
  disown 2>/dev/null || true
}

