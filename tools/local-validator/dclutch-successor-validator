#!/usr/bin/env bash
# Fresh localhost Registry + Resolution + real-Pyth successor profile.
set -euo pipefail

readonly LAUNCHER_VERSION="1"
readonly RECEIVER_ID="rec2HHDDnjLfj4kE7VyEtFA1HPGQLK33259532cRyHp"
readonly ROUTER_ID="HDw2E7P8X1SkCyjvoGsfBGAVUutKcj874bXjHrpVYrVL"
readonly RPC_PORT="20890"
readonly FAUCET_PORT="20892"
readonly GOSSIP_PORT="20893"
readonly DYNAMIC_PORT_RANGE="20900-20931"
readonly MINT_PUBKEY="11111111111111111111111111111111"

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
REPO_ROOT=$(cd -- "$SCRIPT_DIR/../.." && pwd -P)
FIXTURE_DIR="$REPO_ROOT/fixtures/pyth/local-upgraded-2026-08-22"
PROFILE_NAME="dclutch-successor-validator-profile.json"
SENTINEL_NAME=".dclutch-successor-validator-owner"
PID_NAME="dclutch-successor-validator.pid"

die() { printf 'dclutch-successor-validator: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage:
  dclutch-successor-validator start --ledger ABSOLUTE_NEW_DIR \
    --account-dir ABSOLUTE_DIR --plan ABSOLUTE_JSON \
    --registry-program-id PUBKEY --registry-elf ABSOLUTE_ELF \
    --registry-sha256 SHA256 --registry-attestation ABSOLUTE_JSON \
    --resolution-program-id PUBKEY --resolution-elf ABSOLUTE_ELF \
    --resolution-sha256 SHA256 --resolution-attestation ABSOLUTE_JSON \
    [--foreground]
  dclutch-successor-validator status --ledger ABSOLUTE_DIR
  dclutch-successor-validator stop --ledger ABSOLUTE_DIR

The profile binds only to 127.0.0.1 on ports 20890-20931. It never reads a
Solana CLI configuration or caller wallet. The account directory must come
from the successor prepare command and remains explicitly genesis evidence.
Foreground mode preserves the validator as the launcher's process, which is
useful for supervised local execution and process-lifetime-safe automation.
EOF
}

sha256() { shasum -a 256 "$1" | awk '{print $1}'; }
is_sha256() { [[ "$1" =~ ^[0-9a-f]{64}$ ]]; }
is_pubkey() { [[ "$1" =~ ^[1-9A-HJ-NP-Za-km-z]{32,44}$ ]]; }
require_command() { command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"; }

canonical_file() {
  [[ "$1" = /* && -f "$1" && ! -L "$1" ]] || die "not an absolute regular file: $1"
  local parent base
  parent=$(cd -- "$(dirname -- "$1")" && pwd -P)
  base=$(basename -- "$1")
  printf '%s/%s\n' "$parent" "$base"
}

canonical_directory() {
  [[ "$1" = /* && -d "$1" && ! -L "$1" ]] || die "not an absolute directory: $1"
  cd -- "$1" && pwd -P
}

canonical_new_ledger() {
  [[ "$1" = /* ]] || die "--ledger must be absolute"
  [[ ! -e "$1" && ! -L "$1" ]] || die "ledger must be fresh and nonexistent: $1"
  local parent base
  parent=$(cd -- "$(dirname -- "$1")" && pwd -P) || die "ledger parent does not exist"
  base=$(basename -- "$1")
  [[ -n "$base" && "$base" != "." && "$base" != ".." && "$parent" != "/" ]] || die "unsafe ledger path"
  printf '%s/%s\n' "$parent" "$base"
}

canonical_owned_ledger() {
  [[ "$1" = /* && -d "$1" && ! -L "$1" ]] || die "not a successor ledger directory: $1"
  local ledger
  ledger=$(cd -- "$1" && pwd -P)
  [[ -f "$ledger/$SENTINEL_NAME" ]] || die "refusing directory without successor sentinel"
  [[ "$(<"$ledger/$SENTINEL_NAME")" = "dclutch-successor-validator-ledger-v1" ]] || die "invalid successor sentinel"
  printf '%s\n' "$ledger"
}

json_string() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  printf '"%s"' "$value"
}

rpc_ready() {
  curl --fail --silent --show-error --max-time 1 \
    -H 'content-type: application/json' \
    --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' \
    "http://127.0.0.1:$RPC_PORT" | grep -q '"result":"ok"'
}

pid_is_ours() {
  local ledger=$1 pid=$2 command_line
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  command_line=$(ps -p "$pid" -o command= 2>/dev/null || true)
  [[ "$command_line" == *"solana-test-validator"* && "$command_line" == *"--ledger $ledger"* && "$command_line" == *"--rpc-port $RPC_PORT"* ]]
}

validate_attestation() {
  local attestation=$1 elf=$2 elf_hash=$3 program_id=$4
  jq -e \
    --arg elf "$elf" \
    --arg elf_hash "$elf_hash" \
    --arg program_id "$program_id" \
    '.elf_path == $elf and
     .elf_sha256 == $elf_hash and
     .program_id == $program_id and
     (.commit | type == "string" and test("^[0-9a-f]{40}$")) and
     (.archive_sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
     (.cargo_build_sbf_version | type == "string" and length > 0) and
     (.platform_tools_version | type == "string" and length > 0) and
     (.rustc_version | type == "string" and length > 0) and
     (.build_command | type == "string" and length > 0) and
     (.build_log_sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
     .verifier.status == "clean" and
     .verifier.diagnostic_count == 0' \
    "$attestation" >/dev/null || die "artifact attestation is missing, malformed, non-clean, or not bound to exact ELF/program pins"
}

validate_plan() {
  local plan=$1 account_dir=$2 registry_id=$3 registry_elf=$4 registry_hash=$5 resolution_id=$6 resolution_elf=$7 resolution_hash=$8
  jq -e \
    --arg account_dir "$account_dir" \
    --arg registry_id "$registry_id" \
    --arg registry_elf "$registry_elf" \
    --arg registry_hash "$registry_hash" \
    --arg resolution_id "$resolution_id" \
    --arg resolution_elf "$resolution_elf" \
    --arg resolution_hash "$resolution_hash" \
    '.schema == "dclutch-local-successor-genesis-plan-v1" and
     .account_dir == $account_dir and
     .registry.program_id == $registry_id and
     .registry.elf_path == $registry_elf and
     .registry.elf_sha256 == $registry_hash and
     .genesis_accounts["loader.registry.program"].address == $registry_id and
     .genesis_accounts["loader.registry.programdata"].address == .registry.programdata_id and
     .resolution.program_id == $resolution_id and
     .resolution.elf_path == $resolution_elf and
     .resolution.elf_sha256 == $resolution_hash and
     .genesis_accounts["loader.resolution.program"].address == $resolution_id and
     .genesis_accounts["loader.resolution.programdata"].address == .resolution.programdata_id and
     (.genesis_boundary | length == 4) and
     (.genesis_accounts | length > 0)' \
    "$plan" >/dev/null || die "successor plan does not match exact account/artifact pins or hides its genesis boundary"
}

validate_account_dir() {
  local plan=$1 account_dir=$2 address expected path observed count expected_count
  expected_count=$(jq -r '.genesis_accounts | length' "$plan")
  count=0
  while IFS=$'\t' read -r address expected; do
    is_pubkey "$address" || die "plan contains an invalid genesis account address"
    is_sha256 "$expected" || die "plan contains an invalid genesis account file hash"
    path="$account_dir/$address.json"
    [[ -f "$path" && ! -L "$path" ]] || die "missing exact genesis account file: $path"
    observed=$(sha256 "$path")
    [[ "$observed" = "$expected" ]] || die "genesis account file hash mismatch: $path"
    count=$((count + 1))
  done < <(jq -r '.genesis_accounts[] | [.address,.json_file_sha256] | @tsv' "$plan")
  [[ "$count" -eq "$expected_count" ]] || die "genesis account plan enumeration was incomplete"
  local files=("$account_dir"/*.json)
  [[ "${#files[@]}" -eq "$expected_count" ]] || die "account directory contains unpinned or missing JSON files"
}

write_profile() {
  local ledger=$1 account_dir=$2 plan=$3 registry_id=$4 registry_elf=$5 registry_hash=$6 registry_attestation=$7 resolution_id=$8 resolution_elf=$9 resolution_hash=${10} resolution_attestation=${11} validator=${12} version=${13}
  {
    printf '{\n'
    printf '  "schema":"dclutch-successor-local-validator-profile-v1",\n'
    printf '  "launcher_version":"%s",\n' "$LAUNCHER_VERSION"
    printf '  "network":{"bind_address":"127.0.0.1","rpc_url":"http://127.0.0.1:%s","faucet_port":%s,"gossip_port":%s,"dynamic_port_range":"%s"},\n' "$RPC_PORT" "$FAUCET_PORT" "$GOSSIP_PORT" "$DYNAMIC_PORT_RANGE"
    printf '  "ledger":'; json_string "$ledger"; printf ',\n'
    printf '  "account_dir":'; json_string "$account_dir"; printf ',\n'
    printf '  "genesis_plan":'; json_string "$plan"; printf ',\n'
    printf '  "genesis_boundary":"Registry records, Markets, Source states, and funding are prepared inputs; only activation and Resolution transitions are transactions.",\n'
    printf '  "key_policy":"No caller wallet/config is read; validator keys are ledger-scoped and bootstrap keys exist only in process memory.",\n'
    printf '  "validator":{"path":'; json_string "$validator"; printf ',"version":'; json_string "$version"; printf '},\n'
    printf '  "programs":[\n'
    printf '    {"name":"registry","program_id":"%s","elf_path":' "$registry_id"; json_string "$registry_elf"; printf ',"elf_sha256":"%s","attestation":' "$registry_hash"; json_string "$registry_attestation"; printf '},\n'
    printf '    {"name":"resolution","program_id":"%s","elf_path":' "$resolution_id"; json_string "$resolution_elf"; printf ',"elf_sha256":"%s","attestation":' "$resolution_hash"; json_string "$resolution_attestation"; printf '},\n'
    printf '    {"name":"pyth-receiver","program_id":"%s","elf_sha256":"c5079559864fc34dbd5fe87b4aa9fba3a1ed22690363ec490449e8660e73af64"},\n' "$RECEIVER_ID"
    printf '    {"name":"pyth-router","program_id":"%s","elf_sha256":"f9061f03a81b89db29f4603677e3b3d89b3bbf08d67827b2832f18a4e2b61acb"}\n' "$ROUTER_ID"
    printf '  ],\n'
    printf '  "loader_time_boundary":"Registry and Resolution use exact slot-0 immutable genesis Loader headers with canonical zero padding before the fixed 45-byte ELF boundary. Current wall clock differs from the captured provider fixture, and evidence makes no captured-release or production-release claim."\n'
    printf '}\n'
  } > "$ledger/$PROFILE_NAME"
}

start() {
  local ledger_arg='' account_dir_arg='' plan_arg='' registry_id='' registry_elf_arg='' registry_hash='' registry_attestation_arg='' resolution_id='' resolution_elf_arg='' resolution_hash='' resolution_attestation_arg='' foreground=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --ledger) ledger_arg=${2-}; shift 2 ;;
      --account-dir) account_dir_arg=${2-}; shift 2 ;;
      --plan) plan_arg=${2-}; shift 2 ;;
      --registry-program-id) registry_id=${2-}; shift 2 ;;
      --registry-elf) registry_elf_arg=${2-}; shift 2 ;;
      --registry-sha256) registry_hash=${2-}; shift 2 ;;
      --registry-attestation) registry_attestation_arg=${2-}; shift 2 ;;
      --resolution-program-id) resolution_id=${2-}; shift 2 ;;
      --resolution-elf) resolution_elf_arg=${2-}; shift 2 ;;
      --resolution-sha256) resolution_hash=${2-}; shift 2 ;;
      --resolution-attestation) resolution_attestation_arg=${2-}; shift 2 ;;
      --foreground) foreground=1; shift ;;
      *) die "unknown start option: $1" ;;
    esac
  done
  [[ -n "$ledger_arg" && -n "$account_dir_arg" && -n "$plan_arg" && -n "$registry_id" && -n "$registry_elf_arg" && -n "$registry_hash" && -n "$registry_attestation_arg" && -n "$resolution_id" && -n "$resolution_elf_arg" && -n "$resolution_hash" && -n "$resolution_attestation_arg" ]] || die "start requires every plan and artifact pin"
  is_pubkey "$registry_id" || die "invalid Registry program ID"
  is_pubkey "$resolution_id" || die "invalid Resolution program ID"
  [[ "$registry_id" != "$resolution_id" ]] || die "Registry and Resolution IDs must differ"
  is_sha256 "$registry_hash" || die "invalid Registry SHA-256"
  is_sha256 "$resolution_hash" || die "invalid Resolution SHA-256"
  require_command shasum
  require_command jq
  require_command curl
  require_command solana-test-validator
  "$SCRIPT_DIR/dclutch-local-validator" verify-fixtures >/dev/null

  local ledger account_dir plan registry_elf registry_attestation resolution_elf resolution_attestation validator version
  ledger=$(canonical_new_ledger "$ledger_arg")
  account_dir=$(canonical_directory "$account_dir_arg")
  plan=$(canonical_file "$plan_arg")
  registry_elf=$(canonical_file "$registry_elf_arg")
  registry_attestation=$(canonical_file "$registry_attestation_arg")
  resolution_elf=$(canonical_file "$resolution_elf_arg")
  resolution_attestation=$(canonical_file "$resolution_attestation_arg")
  [[ "$(sha256 "$registry_elf")" = "$registry_hash" ]] || die "Registry ELF hash mismatch"
  [[ "$(sha256 "$resolution_elf")" = "$resolution_hash" ]] || die "Resolution ELF hash mismatch"
  [[ "$(od -An -tx1 -N4 "$registry_elf" | tr -d '[:space:]')" = "7f454c46" ]] || die "Registry input is not ELF"
  [[ "$(od -An -tx1 -N4 "$resolution_elf" | tr -d '[:space:]')" = "7f454c46" ]] || die "Resolution input is not ELF"
  validate_attestation "$registry_attestation" "$registry_elf" "$registry_hash" "$registry_id"
  validate_attestation "$resolution_attestation" "$resolution_elf" "$resolution_hash" "$resolution_id"
  validate_plan "$plan" "$account_dir" "$registry_id" "$registry_elf" "$registry_hash" "$resolution_id" "$resolution_elf" "$resolution_hash"
  validate_account_dir "$plan" "$account_dir"
  validator=$(canonical_file "$(command -v solana-test-validator)")
  version=$("$validator" --version 2>&1 | head -n 1)
  [[ "$version" == solana-test-validator\ 4.0.2\ * ]] || die "requires solana-test-validator 4.0.2; found $version"

  mkdir -- "$ledger"
  printf 'dclutch-successor-validator-ledger-v1\n' > "$ledger/$SENTINEL_NAME"
  write_profile "$ledger" "$account_dir" "$plan" "$registry_id" "$registry_elf" "$registry_hash" "$registry_attestation" "$resolution_id" "$resolution_elf" "$resolution_hash" "$resolution_attestation" "$validator" "$version"
  local validator_args=(
    --config /dev/null \
    --ledger "$ledger" \
    --account-dir "$account_dir" \
    --mint "$MINT_PUBKEY" \
    --bind-address 127.0.0.1 \
    --rpc-port "$RPC_PORT" \
    --faucet-port "$FAUCET_PORT" \
    --gossip-port "$GOSSIP_PORT" \
    --dynamic-port-range "$DYNAMIC_PORT_RANGE" \
    --upgradeable-program "$RECEIVER_ID" "$FIXTURE_DIR/receiver.so" none \
    --upgradeable-program "$ROUTER_ID" "$FIXTURE_DIR/router.so" none
  )
  if [[ "$foreground" -eq 1 ]]; then
    printf '%s\n' "$$" > "$ledger/$PID_NAME"
    printf 'starting foreground validator at http://127.0.0.1:%s\nprofile: %s\n' "$RPC_PORT" "$ledger/$PROFILE_NAME"
    exec "$validator" "${validator_args[@]}"
  fi
  nohup "$validator" "${validator_args[@]}" \
    > "$ledger/launcher.log" 2>&1 < /dev/null &
  local pid=$!
  printf '%s\n' "$pid" > "$ledger/$PID_NAME"
  local _
  for _ in $(seq 1 60); do
    if rpc_ready; then
      printf 'ready: http://127.0.0.1:%s\npid: %s\nprofile: %s\n' "$RPC_PORT" "$pid" "$ledger/$PROFILE_NAME"
      return 0
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      die "validator exited before readiness; inspect $ledger/launcher.log"
    fi
    sleep 1
  done
  kill "$pid" 2>/dev/null || true
  die "validator did not become ready; inspect $ledger/launcher.log"
}

status() {
  [[ $# -eq 2 && "$1" = "--ledger" ]] || die "usage: status --ledger ABSOLUTE_DIR"
  local ledger pid=''
  ledger=$(canonical_owned_ledger "$2")
  [[ -f "$ledger/$PID_NAME" ]] && pid=$(<"$ledger/$PID_NAME")
  if pid_is_ours "$ledger" "$pid" && rpc_ready; then
    printf '{"status":"ready","pid":%s,"rpc_url":"http://127.0.0.1:%s","profile":' "$pid" "$RPC_PORT"; json_string "$ledger/$PROFILE_NAME"; printf '}\n'
  else
    printf '{"status":"not-ready","pid":null}\n'
    return 1
  fi
}

stop() {
  [[ $# -eq 2 && "$1" = "--ledger" ]] || die "usage: stop --ledger ABSOLUTE_DIR"
  local ledger pid
  ledger=$(canonical_owned_ledger "$2")
  [[ -f "$ledger/$PID_NAME" ]] || die "missing managed validator pid"
  pid=$(<"$ledger/$PID_NAME")
  pid_is_ours "$ledger" "$pid" || die "refusing stale or unrecognized pid"
  kill "$pid"
  printf 'sent TERM to managed successor validator pid %s\n' "$pid"
}

main() {
  [[ $# -ge 1 ]] || { usage >&2; exit 1; }
  case "$1" in
    start) shift; start "$@" ;;
    status) shift; status "$@" ;;
    stop) shift; stop "$@" ;;
    help|-h|--help) usage ;;
    *) die "unknown command: $1" ;;
  esac
}

main "$@"
