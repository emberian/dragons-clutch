sha256() { shasum -a 256 "$1" | awk '{print $1}'; }
is_sha256() { [[ "$1" =~ ^[0-9a-f]{64}$ ]]; }
is_pubkey() { [[ "$1" =~ ^[1-9A-HJ-NP-Za-km-z]{32,44}$ ]]; }
require_command() { command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"; }

assert_elf() {
  local magic
  magic=$(od -An -tx1 -N4 "$1" | tr -d '[:space:]')
  [[ "$magic" = "7f454c46" ]] || die "not an ELF file: $1"
}

# Ported from dclutch-local-validator when that launcher was banished with the
# DCLTCAT1 stratum. This launcher used to shell out to it for exactly this one
# function; the pinned Pyth fixture set it verifies is live and this is now its
# only reader.
verify_fixtures() {
  require_command shasum
  [[ -d "$FIXTURE_DIR" ]] || die "missing fixture directory: $FIXTURE_DIR"
  [[ -f "$FIXTURE_SUMS" ]] || die "missing pin file: $FIXTURE_SUMS"
  local expected relative actual listed=0
  while IFS='  ' read -r expected relative; do
    [[ -z "$expected" || "$expected" = \#* ]] && continue
    is_sha256 "$expected" || die "invalid fixture pin in $FIXTURE_SUMS"
    [[ -n "$relative" && "$relative" != */* && "$relative" != .*/* ]] || die "unsafe fixture path in pin file"
    [[ -f "$FIXTURE_DIR/$relative" ]] || die "missing pinned fixture: $relative"
    actual=$(sha256 "$FIXTURE_DIR/$relative")
    [[ "$actual" = "$expected" ]] || die "fixture hash mismatch: $relative"
    listed=$((listed + 1))
  done < "$FIXTURE_SUMS"
  # The count is derived from the pin file, never hardcoded. A literal here
  # turns "someone added a fixture artifact and regenerated the pins" into a
  # launcher failure that reads like a tamper alarm, which is exactly what
  # happened when the guardian-set observation landed. The real integrity
  # property is the two-way cover below: every pin resolves to a file whose
  # digest matches, and the directory holds no file that is not pinned.
  [[ "$listed" -gt 0 ]] || die "fixture pin file lists no artifacts"
  local fixture_file_count
  fixture_file_count=$(find "$FIXTURE_DIR" -type f -print | wc -l | tr -d '[:space:]')
  [[ "$fixture_file_count" -eq "$listed" ]] || die "fixture directory contains unpinned or missing artifacts (pinned $listed, present $fixture_file_count)"
  assert_elf "$FIXTURE_DIR/receiver.so"
  assert_elf "$FIXTURE_DIR/router.so"
  printf 'verified %s committed Pyth fixture artifacts\n' "$listed"
}

canonical_file() {
  [[ "$1" = /* && -f "$1" && ! -L "$1" ]] || die "not an absolute regular file: $1"
  local parent base
  parent=$(cd -- "$(dirname -- "$1")" && pwd -P)
  base=$(basename -- "$1")
  printf '%s/%s\n' "$parent" "$base"
}

canonical_directory() {
  [[ "$1" = /* && -d "$1" && ! -L "$1" ]] || die "not an absolute directory: $1"
  cd -- "$1" && pwd -P
}

canonical_new_ledger() {
  [[ "$1" = /* ]] || die "--ledger must be absolute"
  [[ ! -e "$1" && ! -L "$1" ]] || die "ledger must be fresh and nonexistent: $1"
  local parent base
  parent=$(cd -- "$(dirname -- "$1")" && pwd -P) || die "ledger parent does not exist"
  base=$(basename -- "$1")
  [[ -n "$base" && "$base" != "." && "$base" != ".." && "$parent" != "/" ]] || die "unsafe ledger path"
  printf '%s/%s\n' "$parent" "$base"
}

canonical_owned_ledger() {
  [[ "$1" = /* && -d "$1" && ! -L "$1" ]] || die "not a successor ledger directory: $1"
  local ledger
  ledger=$(cd -- "$1" && pwd -P)
  [[ -f "$ledger/$SENTINEL_NAME" ]] || die "refusing directory without successor sentinel"
  [[ "$(<"$ledger/$SENTINEL_NAME")" = "dclutch-successor-validator-ledger-v1" ]] || die "invalid successor sentinel"
  printf '%s\n' "$ledger"
}

