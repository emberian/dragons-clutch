    printf '    {"name":"resolution","program_id":"%s","elf_path":' "$resolution_id"; json_string "$resolution_elf"; printf ',"elf_sha256":"%s","attestation":' "$resolution_hash"; json_string "$resolution_attestation"; printf '},\n'
    printf '    {"name":"custody","program_id":"%s","elf_path":' "$custody_id"; json_string "$custody_elf"; printf ',"elf_sha256":"%s","attestation":' "$custody_hash"; json_string "$custody_attestation"; printf '},\n'
    printf '    {"name":"rent-credit","program_id":"%s","elf_path":' "$rent_credit_id"; json_string "$rent_credit_elf"; printf ',"elf_sha256":"%s","attestation":' "$rent_credit_hash"; json_string "$rent_credit_attestation"; printf '},\n'
    printf '    {"name":"pyth-receiver","program_id":"%s","elf_sha256":"c5079559864fc34dbd5fe87b4aa9fba3a1ed22690363ec490449e8660e73af64"},\n' "$RECEIVER_ID"
    printf '    {"name":"pyth-router","program_id":"%s","elf_sha256":"f9061f03a81b89db29f4603677e3b3d89b3bbf08d67827b2832f18a4e2b61acb"}\n' "$ROUTER_ID"
    printf '  ],\n'
    printf '  "loader_time_boundary":"Registry, Claims, Trading, Resolution, Custody, and Rent use exact slot-0 immutable Loader headers. Core alone starts with the plan-pinned ephemeral authority, must initialize the profile, and must revoke to the pinned tag-None fixed-offset poststate (including Loader-retained inactive authority bytes) before immutable release recognition. Current wall clock differs from the captured provider fixture."\n'
    printf '}\n'
  } > "$ledger/$PROFILE_NAME"
}

start() {
  local ledger_arg='' account_dir_arg='' plan_arg='' registry_id='' registry_elf_arg='' registry_hash='' registry_attestation_arg='' core_id='' core_elf_arg='' core_hash='' core_attestation_arg='' claims_id='' claims_elf_arg='' claims_hash='' claims_attestation_arg='' trading_id='' trading_elf_arg='' trading_hash='' trading_attestation_arg='' resolution_id='' resolution_elf_arg='' resolution_hash='' resolution_attestation_arg='' custody_id='' custody_elf_arg='' custody_hash='' custody_attestation_arg='' rent_credit_id='' rent_credit_elf_arg='' rent_credit_hash='' rent_credit_attestation_arg='' foreground=0 rpc_port_arg='' supervisor_pid_arg=''
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --rpc-port) rpc_port_arg=${2-}; shift 2 ;;
      --supervisor-pid) supervisor_pid_arg=${2-}; shift 2 ;;
      --ledger) ledger_arg=${2-}; shift 2 ;;
      --account-dir) account_dir_arg=${2-}; shift 2 ;;
      --plan) plan_arg=${2-}; shift 2 ;;
      --registry-program-id) registry_id=${2-}; shift 2 ;;
      --registry-elf) registry_elf_arg=${2-}; shift 2 ;;
      --registry-sha256) registry_hash=${2-}; shift 2 ;;
      --registry-attestation) registry_attestation_arg=${2-}; shift 2 ;;
      --core-program-id) core_id=${2-}; shift 2 ;;
      --core-elf) core_elf_arg=${2-}; shift 2 ;;
      --core-sha256) core_hash=${2-}; shift 2 ;;
      --core-attestation) core_attestation_arg=${2-}; shift 2 ;;
      --claims-program-id) claims_id=${2-}; shift 2 ;;
      --claims-elf) claims_elf_arg=${2-}; shift 2 ;;
      --claims-sha256) claims_hash=${2-}; shift 2 ;;
      --claims-attestation) claims_attestation_arg=${2-}; shift 2 ;;
      --trading-program-id) trading_id=${2-}; shift 2 ;;
      --trading-elf) trading_elf_arg=${2-}; shift 2 ;;
      --trading-sha256) trading_hash=${2-}; shift 2 ;;
      --trading-attestation) trading_attestation_arg=${2-}; shift 2 ;;
      --resolution-program-id) resolution_id=${2-}; shift 2 ;;
      --resolution-elf) resolution_elf_arg=${2-}; shift 2 ;;
      --resolution-sha256) resolution_hash=${2-}; shift 2 ;;
      --resolution-attestation) resolution_attestation_arg=${2-}; shift 2 ;;
      --custody-program-id) custody_id=${2-}; shift 2 ;;
      --custody-elf) custody_elf_arg=${2-}; shift 2 ;;
      --custody-sha256) custody_hash=${2-}; shift 2 ;;
      --custody-attestation) custody_attestation_arg=${2-}; shift 2 ;;
      --rent-credit-program-id) rent_credit_id=${2-}; shift 2 ;;
      --rent-credit-elf) rent_credit_elf_arg=${2-}; shift 2 ;;
      --rent-credit-sha256) rent_credit_hash=${2-}; shift 2 ;;
      --rent-credit-attestation) rent_credit_attestation_arg=${2-}; shift 2 ;;
      --foreground) foreground=1; shift ;;
      *) die "unknown start option: $1" ;;
    esac
  done
  [[ -n "$ledger_arg" && -n "$account_dir_arg" && -n "$plan_arg" && -n "$registry_id" && -n "$registry_elf_arg" && -n "$registry_hash" && -n "$registry_attestation_arg" && -n "$core_id" && -n "$core_elf_arg" && -n "$core_hash" && -n "$core_attestation_arg" && -n "$claims_id" && -n "$claims_elf_arg" && -n "$claims_hash" && -n "$claims_attestation_arg" && -n "$trading_id" && -n "$trading_elf_arg" && -n "$trading_hash" && -n "$trading_attestation_arg" && -n "$resolution_id" && -n "$resolution_elf_arg" && -n "$resolution_hash" && -n "$resolution_attestation_arg" && -n "$custody_id" && -n "$custody_elf_arg" && -n "$custody_hash" && -n "$custody_attestation_arg" && -n "$rent_credit_id" && -n "$rent_credit_elf_arg" && -n "$rent_credit_hash" && -n "$rent_credit_attestation_arg" ]] || die "start requires every plan and artifact pin"
  [[ "$foreground" -eq 1 ]] || die "start requires --foreground under a same-process in-memory Core-authority supervisor"
  resolve_start_port "$rpc_port_arg"
  if [[ -n "$supervisor_pid_arg" ]]; then
    [[ "$supervisor_pid_arg" =~ ^[1-9][0-9]*$ ]] || die "--supervisor-pid must be a positive decimal pid: $supervisor_pid_arg"
    kill -0 "$supervisor_pid_arg" 2>/dev/null || die "--supervisor-pid $supervisor_pid_arg is not a live process"
  fi
  is_pubkey "$registry_id" || die "invalid Registry program ID"
  is_pubkey "$core_id" || die "invalid Core program ID"
  is_pubkey "$claims_id" || die "invalid Claims program ID"
  is_pubkey "$trading_id" || die "invalid Trading program ID"
  is_pubkey "$resolution_id" || die "invalid Resolution program ID"
  is_pubkey "$custody_id" || die "invalid Custody program ID"
  is_pubkey "$rent_credit_id" || die "invalid RentCredit program ID"
  local ids=("$registry_id" "$core_id" "$claims_id" "$trading_id" "$resolution_id" "$custody_id" "$rent_credit_id") left right
  for ((left=0; left<${#ids[@]}; left++)); do
    for ((right=left+1; right<${#ids[@]}; right++)); do
      [[ "${ids[$left]}" != "${ids[$right]}" ]] || die "Registry, all five role Program IDs, and RentCredit must be pairwise distinct"
    done
  done
  is_sha256 "$registry_hash" || die "invalid Registry SHA-256"
  is_sha256 "$core_hash" || die "invalid Core SHA-256"
  is_sha256 "$claims_hash" || die "invalid Claims SHA-256"
  is_sha256 "$trading_hash" || die "invalid Trading SHA-256"
  is_sha256 "$resolution_hash" || die "invalid Resolution SHA-256"
  is_sha256 "$custody_hash" || die "invalid Custody SHA-256"
  is_sha256 "$rent_credit_hash" || die "invalid RentCredit SHA-256"
  require_command shasum
  require_command jq
  require_command curl
  require_command solana-test-validator
  verify_fixtures >/dev/null

  local ledger account_dir plan registry_elf registry_attestation core_elf core_attestation claims_elf claims_attestation trading_elf trading_attestation resolution_elf resolution_attestation custody_elf custody_attestation rent_credit_elf rent_credit_attestation validator version
  ledger=$(canonical_new_ledger "$ledger_arg")
  account_dir=$(canonical_directory "$account_dir_arg")
  plan=$(canonical_file "$plan_arg")
  registry_elf=$(canonical_file "$registry_elf_arg")
  registry_attestation=$(canonical_file "$registry_attestation_arg")
  core_elf=$(canonical_file "$core_elf_arg")
  core_attestation=$(canonical_file "$core_attestation_arg")
  claims_elf=$(canonical_file "$claims_elf_arg")
  claims_attestation=$(canonical_file "$claims_attestation_arg")
  trading_elf=$(canonical_file "$trading_elf_arg")
  trading_attestation=$(canonical_file "$trading_attestation_arg")
  resolution_elf=$(canonical_file "$resolution_elf_arg")
  resolution_attestation=$(canonical_file "$resolution_attestation_arg")
  custody_elf=$(canonical_file "$custody_elf_arg")
  custody_attestation=$(canonical_file "$custody_attestation_arg")
  rent_credit_elf=$(canonical_file "$rent_credit_elf_arg")
  rent_credit_attestation=$(canonical_file "$rent_credit_attestation_arg")
  [[ "$(sha256 "$registry_elf")" = "$registry_hash" ]] || die "Registry ELF hash mismatch"
  [[ "$(sha256 "$core_elf")" = "$core_hash" ]] || die "Core ELF hash mismatch"
  [[ "$(sha256 "$claims_elf")" = "$claims_hash" ]] || die "Claims ELF hash mismatch"
  [[ "$(sha256 "$trading_elf")" = "$trading_hash" ]] || die "Trading ELF hash mismatch"
  [[ "$(sha256 "$resolution_elf")" = "$resolution_hash" ]] || die "Resolution ELF hash mismatch"
  [[ "$(sha256 "$custody_elf")" = "$custody_hash" ]] || die "Custody ELF hash mismatch"
  [[ "$(sha256 "$rent_credit_elf")" = "$rent_credit_hash" ]] || die "RentCredit ELF hash mismatch"
  [[ "$(od -An -tx1 -N4 "$registry_elf" | tr -d '[:space:]')" = "7f454c46" ]] || die "Registry input is not ELF"
  [[ "$(od -An -tx1 -N4 "$core_elf" | tr -d '[:space:]')" = "7f454c46" ]] || die "Core input is not ELF"
  [[ "$(od -An -tx1 -N4 "$claims_elf" | tr -d '[:space:]')" = "7f454c46" ]] || die "Claims input is not ELF"
  [[ "$(od -An -tx1 -N4 "$trading_elf" | tr -d '[:space:]')" = "7f454c46" ]] || die "Trading input is not ELF"
  [[ "$(od -An -tx1 -N4 "$resolution_elf" | tr -d '[:space:]')" = "7f454c46" ]] || die "Resolution input is not ELF"
  [[ "$(od -An -tx1 -N4 "$custody_elf" | tr -d '[:space:]')" = "7f454c46" ]] || die "Custody input is not ELF"
  [[ "$(od -An -tx1 -N4 "$rent_credit_elf" | tr -d '[:space:]')" = "7f454c46" ]] || die "RentCredit input is not ELF"
  validate_attestation "$registry_attestation" "$registry_elf" "$registry_hash" "$registry_id"
  validate_attestation "$core_attestation" "$core_elf" "$core_hash" "$core_id"
  validate_attestation "$claims_attestation" "$claims_elf" "$claims_hash" "$claims_id"
  validate_attestation "$trading_attestation" "$trading_elf" "$trading_hash" "$trading_id"
  validate_attestation "$resolution_attestation" "$resolution_elf" "$resolution_hash" "$resolution_id"
  validate_attestation "$custody_attestation" "$custody_elf" "$custody_hash" "$custody_id"
  validate_attestation "$rent_credit_attestation" "$rent_credit_elf" "$rent_credit_hash" "$rent_credit_id"
  validate_plan "$plan" "$account_dir" "$registry_id" "$registry_elf" "$registry_hash" "$core_id" "$core_elf" "$core_hash" "$claims_id" "$claims_elf" "$claims_hash" "$trading_id" "$trading_elf" "$trading_hash" "$resolution_id" "$resolution_elf" "$resolution_hash" "$custody_id" "$custody_elf" "$custody_hash" "$rent_credit_id" "$rent_credit_elf" "$rent_credit_hash"
  validate_account_dir "$plan" "$account_dir"
  validator=$(canonical_file "$(command -v solana-test-validator)")
  version=$("$validator" --version 2>&1 | head -n 1)
  [[ "$version" == solana-test-validator\ 4.0.2\ * ]] || die "requires solana-test-validator 4.0.2; found $version"

  mkdir -- "$ledger"
  printf 'dclutch-successor-validator-ledger-v1\n' > "$ledger/$SENTINEL_NAME"
  write_profile "$ledger" "$account_dir" "$plan" "$registry_id" "$registry_elf" "$registry_hash" "$registry_attestation" "$core_id" "$core_elf" "$core_hash" "$core_attestation" "$claims_id" "$claims_elf" "$claims_hash" "$claims_attestation" "$trading_id" "$trading_elf" "$trading_hash" "$trading_attestation" "$resolution_id" "$resolution_elf" "$resolution_hash" "$resolution_attestation" "$custody_id" "$custody_elf" "$custody_hash" "$custody_attestation" "$rent_credit_id" "$rent_credit_elf" "$rent_credit_hash" "$rent_credit_attestation" "$validator" "$version"
  local validator_args=(
    --config /dev/null \
    --ledger "$ledger" \
    --account-dir "$account_dir" \
    --mint "$MINT_PUBKEY" \
    --ticks-per-slot "$TICKS_PER_SLOT" \
    --bind-address 127.0.0.1 \
    --rpc-port "$RPC_PORT" \
    --faucet-port "$FAUCET_PORT" \
    --gossip-port "$GOSSIP_PORT" \
    --dynamic-port-range "$DYNAMIC_PORT_RANGE" \
    --upgradeable-program "$RECEIVER_ID" "$FIXTURE_DIR/receiver.so" none \
    --upgradeable-program "$ROUTER_ID" "$FIXTURE_DIR/router.so" none
  )
  if [[ "$foreground" -eq 1 ]]; then
    printf '%s\n' "$$" > "$ledger/$PID_NAME"
    [[ -n "$supervisor_pid_arg" ]] && spawn_supervisor_watchdog "$supervisor_pid_arg"
    printf 'starting foreground validator at http://127.0.0.1:%s\nprofile: %s\n' "$RPC_PORT" "$ledger/$PROFILE_NAME"
    exec "$validator" "${validator_args[@]}"
  fi
  nohup "$validator" "${validator_args[@]}" \
    > "$ledger/launcher.log" 2>&1 < /dev/null &
  local pid=$!
  printf '%s\n' "$pid" > "$ledger/$PID_NAME"
  local _
  for _ in $(seq 1 60); do
    if rpc_ready; then
      printf 'ready: http://127.0.0.1:%s\npid: %s\nprofile: %s\n' "$RPC_PORT" "$pid" "$ledger/$PROFILE_NAME"
      return 0
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      die "validator exited before readiness; inspect $ledger/launcher.log"
    fi
    sleep 1
  done
  kill "$pid" 2>/dev/null || true
  die "validator did not become ready; inspect $ledger/launcher.log"
}

status() {
  [[ $# -eq 2 && "$1" = "--ledger" ]] || die "usage: status --ledger ABSOLUTE_DIR"
  local ledger pid=''
  ledger=$(canonical_owned_ledger "$2")
  require_command jq
  set_port_block "$(port_from_profile "$ledger" || printf '%s' "$DEFAULT_RPC_PORT")"
  [[ -f "$ledger/$PID_NAME" ]] && pid=$(<"$ledger/$PID_NAME")
  if pid_is_ours "$ledger" "$pid" && rpc_ready; then
    printf '{"status":"ready","pid":%s,"rpc_url":"http://127.0.0.1:%s","profile":' "$pid" "$RPC_PORT"; json_string "$ledger/$PROFILE_NAME"; printf '}\n'
  else
    printf '{"status":"not-ready","pid":null}\n'
    return 1
  fi
}

stop() {
  [[ $# -eq 2 && "$1" = "--ledger" ]] || die "usage: stop --ledger ABSOLUTE_DIR"
  local ledger pid
  ledger=$(canonical_owned_ledger "$2")
  require_command jq
  set_port_block "$(port_from_profile "$ledger" || printf '%s' "$DEFAULT_RPC_PORT")"
  [[ -f "$ledger/$PID_NAME" ]] || die "missing managed validator pid"
  pid=$(<"$ledger/$PID_NAME")
  pid_is_ours "$ledger" "$pid" || die "refusing stale or unrecognized pid"
  kill "$pid"
  printf 'sent TERM to managed successor validator pid %s\n' "$pid"
}

main() {
  [[ $# -ge 1 ]] || { usage >&2; exit 1; }
  case "$1" in
    start) shift; start "$@" ;;
    status) shift; status "$@" ;;
    stop) shift; stop "$@" ;;
    help|-h|--help) usage ;;
    *) die "unknown command: $1" ;;
  esac
}

main "$@"
