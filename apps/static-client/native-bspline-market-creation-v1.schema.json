{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dragon-clutch.native-bspline-market-creation.v1",
  "title": "Dragon's Clutch native B-spline market-creation preview V1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "mode", "semanticMode", "termsDigest", "basisSpec",
    "basisSpecBytes", "basisSpecDigest", "shapeCertificateDigest",
    "observedCurrentSlot", "expiresSlot", "termsArtifactIntentBytes",
    "createMarketIntentBytes", "authorization", "warning"
  ],
  "properties": {
    "schema": { "const": "dragon-clutch.native-bspline-market-creation.v1" },
    "mode": { "const": "offline-inspection-only" },
    "semanticMode": { "const": "native-bspline" },
    "termsDigest": { "$ref": "#/$defs/hash32" },
    "basisSpec": { "$ref": "#/$defs/basisSpec" },
    "basisSpecBytes": { "type": "string", "pattern": "^[0-9a-f]{608}$" },
    "basisSpecDigest": { "$ref": "#/$defs/hash32" },
    "shapeCertificateDigest": { "$ref": "#/$defs/hash32" },
    "observedCurrentSlot": { "$ref": "#/$defs/u64Decimal" },
    "expiresSlot": { "$ref": "#/$defs/u64Decimal" },
    "termsArtifactIntentBytes": {
      "description": "Exactly 11 unsigned Terms-upload intent-data strings: one BeginArtifact, nine cursor-ordered WriteArtifact chunks, and one SealArtifact.",
      "type": "array", "minItems": 11, "maxItems": 11,
      "items": { "type": "string", "pattern": "^[0-9a-f]+$" }
    },
    "createMarketIntentBytes": {
      "description": "The separate unsigned CreateMarket intent-data string, executed only after the 11-intent Terms upload route.",
      "type": "string", "pattern": "^[0-9a-f]{278}$"
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["wallet", "signer", "signature", "submission"],
      "properties": {
        "wallet": { "const": "not-connected" },
        "signer": { "const": "none" },
        "signature": { "type": "null" },
        "submission": { "const": "disabled" }
      }
    },
    "warning": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "hash32": { "type": "string", "pattern": "^(?!0{64})[0-9a-f]{64}$" },
    "u64Decimal": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,19})$" },
    "u128Decimal": { "type": "string", "pattern": "^(?:0|[1-9][0-9]{0,38})$" },
    "basisSpec": {
      "type": "object", "additionalProperties": false,
      "required": ["semanticMode", "outcomeCount", "degree", "uniformLog2Spacing", "denominator", "domainMax", "edgePolicy", "knots"],
      "properties": {
        "semanticMode": { "const": "native-bspline" },
        "outcomeCount": { "type": "integer", "minimum": 2, "maximum": 16 },
        "degree": { "type": "integer", "minimum": 0, "maximum": 3 },
        "uniformLog2Spacing": {
          "oneOf": [
            { "type": "null" },
            { "type": "integer", "minimum": 0, "maximum": 127 }
          ]
        },
        "denominator": { "$ref": "#/$defs/u64Decimal" },
        "domainMax": { "$ref": "#/$defs/u128Decimal" },
        "edgePolicy": { "enum": ["clamp", "refuse"] },
        "knots": {
          "type": "array", "minItems": 1, "maxItems": 16,
          "items": { "$ref": "#/$defs/u128Decimal" }
        }
      }
    }
  }
}
