# Canon III — The Book and the Clearing
#
# Concepts 14-31: the frozen input, the predicate that checks a proposed
# clearing, the streaming execution of that predicate, and the price object
# the whole apparatus publishes.
#
# Definitions are transcribed from the inventory, not re-derived here.
# Relation entries follow the vocabulary declared in ~"./index.spw".

#>spw_dragons_clutch_canon_clearing
#:canon #!concept
#:layer #!semantics
#:status #!active

^"roots"{
  @index: ~"./index.spw"
  @inventory: ~"../../docs/site-plan/CONCEPT_INVENTORY_2026-08-20.md"
  @truth: ~"../../CURRENT_TRUTH.md"
  @goal: ~"../../GOAL.md"
  @agents: ~"../../AGENTS.md"
  @tier2: ~"../../docs/design/TIER2_PORTFOLIO_CLEARING_PLAN_2026-08-20.md"
  @dual: ~"../../docs/research/DUAL_IS_THE_MEASURE.md"
  @risk: ~"../../docs/research/RISK_SUMMED_POSITIONS.md"
  @fee_geometry: ~"../../docs/FEE_GEOMETRY.md"
  @relation_v1: ~"../../crates/clutch-batch/src/relation_v1.rs"
  @relation_stream: ~"../../crates/clutch-batch/src/relation_v1_stream.rs"
  @layout: ~"../../docs/implementation/SOLANA_LAYOUT.md"
  @layout_program: ~"../../programs/solana-layout"
}

^"intent"{
  ~#layer: "III. The book and the clearing"
  ~#span: "concepts 14-31"
  ~#goal: "Hold the clearing vocabulary exactly, from the frozen book through the verdict to the two rival fee bases."
}

^"concepts"{

  book: .{
    n = 14
    label = "book"
    define = "The frozen order set of an epoch: multi-page order accounts holding single and portfolio slots, sealed under a digest commitment at freeze so the clearing's input is immutable and re-derivable."
    cite = "TIER2_PORTFOLIO_CLEARING_PLAN_2026-08-20.md T2-2/T2-6a; programs/solana-layout (SOLANA_LAYOUT.md)"
    source = ~"../../docs/design/TIER2_PORTFOLIO_CLEARING_PLAN_2026-08-20.md"
    corroborant = ~"../../programs/solana-layout"
    teaches = "P3"
    uses = #[ reservation, tombstone ][reg=set]
    binds = #[ "projected by live_rank into -> relation" ][reg=set]
  }[reg=concept]

  tombstone: .{
    n = 15
    label = "tombstone"
    define = "The retirement marker a cancelled order leaves in its page slot — digest-covered, skipped by the projection, consuming no live rank — so cancellation is a recorded fact, not an erasure."
    cite = "TIER2_PORTFOLIO_CLEARING_PLAN_2026-08-20.md T2-2/T2-4"
    source = ~"../../docs/design/TIER2_PORTFOLIO_CLEARING_PLAN_2026-08-20.md"
    teaches = "P3"
    used_by = #[ book ][reg=set]
    binds = #[
      "a tombstone-bearing set must verdict-match its tombstone-free equivalent (T2-2 gate) -> verdict"
    ][reg=set]
  }[reg=concept]

  live_rank: .{
    n = 16
    label = "live rank"
    define = "The canonical zero-based renumbering of surviving orders after tombstones are skipped — the identity by which fills, slices, and candidates refer to orders."
    cite = "TIER2_PORTFOLIO_CLEARING_PLAN_2026-08-20.md T2-2 (index vocabularies pinned)"
    source = ~"../../docs/design/TIER2_PORTFOLIO_CLEARING_PLAN_2026-08-20.md"
    teaches = "P3"
    uses = #[ tombstone ][reg=set]
    binds = #[ "binds candidate fill indices to -> book" ][reg=set]
  }[reg=concept]

  owner_tag: .{
    n = 17
    label = "owner tag"
    define = "The first-appearance interned index (bounded at 64) standing for an owner throughout one clearing, refused unless the interned count equals the epoch's owner count at pass-1 end."
    cite = "TIER2_PORTFOLIO_CLEARING_PLAN_2026-08-20.md T2-6b (OwnerInterner)"
    source = ~"../../docs/design/TIER2_PORTFOLIO_CLEARING_PLAN_2026-08-20.md"
    teaches = "P3"
    used_by = #[ the_walk ][reg=set]
    binds = #[
      "supports self-cross refusal -> refusal"
      "supports the owner-congestion duals (DUAL_IS_THE_MEASURE §5.6)"
    ][reg=set]
  }[reg=concept]

  reservation: .{
    n = 18
    label = "reservation"
    define = "The canonical pre-fund-safe per-order encumbrance of exact cash or internal Eggs, created at placement, re-verified order-by-order during pass 1, and released only per the verified summary."
    cite = "CURRENT_TRUTH.md §4 (funded order admission); TIER2 plan T2-6b join 1"
    source = ~"../../CURRENT_TRUTH.md"
    corroborant = ~"../../docs/design/TIER2_PORTFOLIO_CLEARING_PLAN_2026-08-20.md"
    teaches = "P3"
    recurs = "P4"
    uses = #[ custody_boundary ][reg=set]
    binds = #[
      "is swept by -> the_walk"
      "is consumed by -> entitlement"
    ][reg=set]
  }[reg=concept]

  candidate: .{
    n = 19
    label = "candidate"
    define = "A solver's complete proposed clearing — price vector, imbalance, fills, slices — submitted permissionlessly and trusted for nothing: every derived quantity is recomputed and checked for exact equality."
    cite = "DUAL_IS_THE_MEASURE.md §1; CURRENT_TRUTH.md §4 clearing row"
    source = ~"../../docs/research/DUAL_IS_THE_MEASURE.md"
    corroborant = ~"../../CURRENT_TRUTH.md"
    teaches = "P3"
    recurs = "P6"
    binds = #[
      "is verified via the_walk by -> relation"
      "competes under -> selection"
      "its price vector is the dual -> zero_gap_certificate"
      "its price vector is the measure -> implied_measure"
    ][reg=set]
  }[reg=concept]

  relation: .{
    n = 20
    label = "relation"
    define = "The frozen batch-clearing predicate (stages V0–V9): simplex gate, eligibility trichotomy, fill box, per-outcome conservation, pairing, surplus, cash closure, score — a disassembled optimality-certificate checker derived as refusal discipline."
    cite = "crates/clutch-batch/src/relation_v1.rs; DUAL_IS_THE_MEASURE.md §4.4"
    source = ~"../../crates/clutch-batch/src/relation_v1.rs"
    corroborant = ~"../../docs/research/DUAL_IS_THE_MEASURE.md"
    teaches = "P3"
    binds = #[
      "consumes -> book"
      "consumes -> candidate"
      "emits -> verdict"
      "is streamed by -> the_walk"
    ][reg=set]
  }[reg=concept]

  the_walk: .{
    n = 21
    label = "the walk"
    define = "Streaming verification: the relation executed across many transactions over digest-verified pages — push order by order, slice by slice, checkpointed between steps — so verification cost is bounded per transaction, not per book."
    cite = "crates/clutch-batch/src/relation_v1_stream.rs; TIER2 plan T2-6; GOAL.md done-log T2-6"
    source = ~"../../crates/clutch-batch/src/relation_v1_stream.rs"
    corroborant = ~"../../GOAL.md"
    teaches = "P3"
    uses = #[ checkpoint, live_rank, owner_tag ][reg=set]
    plane = "its on-chain verdict is byte-equal to the host relation's in bank evidence"
  }[reg=concept]

  verdict: .{
    n = 22
    label = "verdict"
    define = "The relation's total answer for one candidate — VERIFIED with its summary and recomputed score components, or a typed refusal — never a partial opinion, never trusted from the claimant."
    cite = "relation_v1_stream.rs (verdict/`FullScoreV1`); CURRENT_TRUTH.md §4"
    source = ~"../../crates/clutch-batch/src/relation_v1_stream.rs"
    corroborant = ~"../../CURRENT_TRUTH.md"
    teaches = "P3"
    binds = #[
      "is produced by -> relation"
      "gates -> selection"
      "its summary's implied allocation is what settlement must byte-match -> conservation"
    ][reg=set]
  }[reg=concept]

  entitlement: .{
    n = 23
    label = "entitlement"
    define = "The immutable per-slice receipt frozen from the selected candidate before any value moves — the consumption latch that makes settlement resumable and exactly-once."
    cite = "TIER2 plan T2-8; GOAL.md done-log T2-8"
    source = ~"../../docs/design/TIER2_PORTFOLIO_CLEARING_PLAN_2026-08-20.md"
    corroborant = ~"../../GOAL.md"
    teaches = "P4"
    uses = #[ selection ][reg=set]
    binds = #[
      "is consumed by settlement under -> conservation"
      "each receipt consumed exactly once"
    ][reg=set]
  }[reg=concept]

  selection: .{
    n = 24
    label = "selection"
    define = "Choosing the best valid *submitted* candidate: only VERIFIED candidates compete, compared by a frozen total order over re-derived full-width score components and tie digests — a deterministic policy choice on the optimal face, and honestly described as such."
    cite = "GOAL.md done-log T2-7; DUAL_IS_THE_MEASURE.md §5.3, §9.3"
    source = ~"../../GOAL.md"
    corroborant = ~"../../docs/research/DUAL_IS_THE_MEASURE.md"
    teaches = "P3"
    uses = #[ verdict ][reg=set]
    binds = #[
      "freezes -> entitlement"
      "an unverified claim can never displace a verified candidate"
    ][reg=set]
    adjacent = #[ "score", "tie digest", "candidate window" ][reg=set]
  }[reg=concept]

  simplex_prices: .{
    n = 25
    label = "simplex prices"
    define = "The published price vector: nonnegative scaled integers summing exactly to `PRICE_SCALE`, a normalization *forced* by the mere availability of split/merge (dual feasibility of the all-ones columns), not asserted by fiat."
    cite = "DUAL_IS_THE_MEASURE.md Thm 3.1"
    source = ~"../../docs/research/DUAL_IS_THE_MEASURE.md"
    teaches = "P3"
    recurs = "P6"
    uses = #[ partition_of_unity ][reg=set]
    binds = #[
      "is the dual on the accept set -> zero_gap_certificate"
      "is the measure at degree ≤ 1 -> implied_measure"
    ][reg=set]
  }[reg=concept]

  implied_measure: .{
    n = 26
    label = "implied measure"
    define = "At degree ≤ 1, every publishable price vector is exactly a probability measure's basis-moment vector — a positive normalized quadrature rule, with Breeden–Litzenberger pre-inverted because hat claims *are* butterflies; refuted in general at degree ≥ 2."
    cite = "DUAL_IS_THE_MEASURE.md §7 (Thm 7.1, §7.3, §7.4)"
    source = ~"../../docs/research/DUAL_IS_THE_MEASURE.md"
    teaches = "P3"
    recurs = "P6"
    refines = #[ simplex_prices ][reg=set]
    measures = #[ ][reg=set]
    measures_external = #[ "the market's belief at grid resolution" ][reg=set]
    binds = #[ "read natively by machines (P6)" ][reg=set]
  }[reg=concept]

  zero_gap_certificate: .{
    n = 27
    label = "zero-gap certificate"
    define = "Under the certificate-demanding policy tuple, an accepted candidate carries inside its own witness a zero-duality-gap proof of surplus optimality for the LP relaxation, with the price vector as optimal dual — the `StrictUnderfill` refusal is a positive-gap detector."
    cite = "DUAL_IS_THE_MEASURE.md Thm 5.1, §5.4"
    source = ~"../../docs/research/DUAL_IS_THE_MEASURE.md"
    teaches = "P3"
    recurs = "P7"
    refines = #[ "toward optimal-and-certified -> verify_not_find" ][reg=set]
    plane = "promotion gated on named falsifiers and the Lean instantiation"
    binds = #[ "gap itemized per order when policy relaxes" ][reg=set]
  }[reg=concept]

  checkpoint: .{
    n = 28
    label = "checkpoint"
    define = "The persistent ClearWork account carrying the walk's exact resumable state — staged into existence across grow instructions, encoded/decoded at every boundary, and defended by a three-layer tamper stack (fold latch, header validation, order-set binding)."
    cite = "TIER2 plan T2-1/T2-3; relation_v1_stream.rs"
    source = ~"../../docs/design/TIER2_PORTFOLIO_CLEARING_PLAN_2026-08-20.md"
    corroborant = ~"../../crates/clutch-batch/src/relation_v1_stream.rs"
    teaches = "P3"
    used_by = #[ the_walk ][reg=set]
    refuses = #[ ][reg=set]
    refuses_external = #[ "resumed tampering (ResumeFoldMismatch, anchor comparison)" ][reg=set]
  }[reg=concept]

  verify_not_find: .{
    n = 29
    label = "verify-not-find"
    define = "The venue's stance: the chain never searches for a clearing, it verifies submitted ones exactly — \"best valid submitted candidate,\" never \"optimal clearing,\" unless a checked certificate exists."
    cite = "AGENTS.md (correctness vocabulary); DUAL_IS_THE_MEASURE.md §1"
    source = ~"../../AGENTS.md"
    corroborant = ~"../../docs/research/DUAL_IS_THE_MEASURE.md"
    teaches = "P3"
    recurs = "P6"
    binds = #[
      "frames -> candidate"
      "frames -> relation"
      "frames -> selection"
      "is upgraded, scoped and gated, by -> zero_gap_certificate"
    ][reg=set]
  }[reg=concept]

  dispersion: .{
    n = 30
    label = "dispersion"
    define = "The candidate fee base `G(a,p) = Σ_{i<j} p_i p_j |a_i − a_j| / S²` — the unique 1-homogeneous, layer-additive extension of the binary `q·p·(1−p)`; complete-set invariant, relabeling symmetric, subadditive, ≤ 120 exact integer pair terms — and provably *not* the model-free risk norm."
    cite = "docs/FEE_GEOMETRY.md §2–3; RISK_SUMMED_POSITIONS.md Props 9–12"
    source = ~"../../docs/FEE_GEOMETRY.md"
    corroborant = ~"../../docs/research/RISK_SUMMED_POSITIONS.md"
    teaches = "P5"
    measures = #[ ][reg=set]
    measures_external = #[ "risk transfer under the market's own measure" ][reg=set]
    binds = #[ "vanishes on -> clutch" ][reg=set]
    plane = "its zero-price kernel hole is a named falsifier"
    status = "forced to zero everywhere in the current tree"
    adjacent = #[ "kappa", "fee carry", "terminal-ceil close" ][reg=set]
  }[reg=concept]

  quotient_norm: .{
    n = 31
    label = "quotient norm"
    define = "The price-free control candidate `κ'·R(a)` — the range seminorm, the same functional the solvency machinery locks — dispersion's exact envelope (`G ≤ R/4`) and the other arm of the undecided fee fork."
    cite = "RISK_SUMMED_POSITIONS.md §1.3, §3.4"
    source = ~"../../docs/research/RISK_SUMMED_POSITIONS.md"
    teaches = "P5"
    refines = #[ "into a fee base -> risk_quotient" ][reg=set]
    status = "the fork against dispersion (30) is economics the mathematics cannot close"
    binds = #[ "is the other arm of the fork against -> dispersion" ][reg=set]
  }[reg=concept]
}

^"holes"{
  # Relation targets the inventory names that are not themselves canon concepts.
  implied_measure_measures: "the market's belief at grid resolution — no canon entry"
  dispersion_measures: "risk transfer under the market's own measure — no canon entry"
  checkpoint_refuses: "resumed tampering — a failure mode, not a canon entry"
}

~<./index.spw>
~<./custody.spw>
~<./refusal.spw>
