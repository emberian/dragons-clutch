# Canon II — Custody and Conservation
#
# Concepts 8-13: which moves preserve value, where collateral actually
# crosses an edge, and the identity that must hold to the atom.
#
# Definitions are transcribed from the inventory, not re-derived here.
# Relation entries follow the vocabulary declared in ~"./index.spw".

#>spw_dragons_clutch_canon_custody
#:canon #!concept
#:layer #!semantics
#:status #!active

^"roots"{
  @index: ~"./index.spw"
  @inventory: ~"../../docs/site-plan/CONCEPT_INVENTORY_2026-08-20.md"
  @project: ~"../../PROJECT.md"
  @truth: ~"../../CURRENT_TRUTH.md"
  @goal: ~"../../GOAL.md"
  @risk: ~"../../docs/research/RISK_SUMMED_POSITIONS.md"
  @solvency: ~"../../lean/DragonsClutch/Solvency.lean"
  @transitions: ~"../../lean/DragonsClutch/Transitions.lean"
}

^"intent"{
  ~#layer: "II. Custody and conservation"
  ~#span: "concepts 8-13"
  ~#goal: "Hold the custody vocabulary exactly: diagonal motion, materialize, the custody boundary, conservation, sup-norm collateral, the risk quotient."
}

^"concepts"{

  diagonal_motion: .{
    n = 8
    label = "diagonal motion (split / merge)"
    define = "The counterparty-free value-preserving moves: split debits cash and credits every Egg equally, merge is its exact inverse — provably the *only* such moves besides representation changes."
    cite = "CURRENT_TRUTH.md §5 table; RISK_SUMMED_POSITIONS.md Prop 4"
    source = ~"../../CURRENT_TRUTH.md"
    corroborant = ~"../../docs/research/RISK_SUMMED_POSITIONS.md"
    teaches = "P1"
    recurs = "P4"
    uses = #[ clutch ][reg=set]
    binds = #[
      "is identity on -> risk_quotient"
      "free under every admissible fee base"
    ][reg=set]
  }[reg=concept]

  materialize: .{
    n = 9
    label = "materialize / dematerialize"
    define = "The hybrid-representation boundary: debit an internal Egg balance to mint its canonical Token-2022 asset, or burn the asset to restore the balance — paying the composability cost only when a user asks for it."
    cite = "PROJECT.md §5"
    source = ~"../../PROJECT.md"
    teaches = "P1"
    binds = #[
      "is identity on positions and on -> conservation"
      "connects to external venues -> egg"
    ][reg=set]
    adjacent = #[ "bearer", "positionless redemption" ][reg=set]
  }[reg=concept]

  custody_boundary: .{
    n = 10
    label = "custody boundary (Endow / WithdrawCash)"
    define = "The only two transitions where collateral tokens actually cross the Hoard's edge: Endow is the sole inbound boundary, exact unreserved WithdrawCash the outbound one; everything between is pooled-accounting reclassification."
    cite = "CURRENT_TRUTH.md §4 (pooled custody row), §5"
    source = ~"../../CURRENT_TRUTH.md"
    teaches = "P4"
    uses = #[ realm_hoard ][reg=set]
    status = "Endow currently refuses `0x79` on the default artifact"
    binds = #[ "see -> two_elf_discipline" ][reg=set]
  }[reg=concept]

  conservation: .{
    n = 11
    label = "conservation"
    define = "The custody identity `H = L + P + S` — actual Hoard atoms equal retained claim backing plus all Position cash plus unsolicited surplus — plus its per-transition exact-delta table, asserted to the atom at settlement."
    cite = "CURRENT_TRUTH.md §5; GOAL.md done-log T2-8 (whole-plane assertion)"
    source = ~"../../CURRENT_TRUTH.md"
    corroborant = ~"../../GOAL.md"
    teaches = "P4"
    hub = true
    measures = #[ ][reg=set]
    measures_external = #[ "every transition" ][reg=set]
    anchored_by = #[ clutch ][reg=set]
    binds = #[ "is the settled end-state of the walk-to-zero (P4)" ][reg=set]
  }[reg=concept]

  sup_norm_collateral: .{
    n = 12
    label = "sup-norm collateral (solvency)"
    define = "The required-collateral rule: reserve the maximum component of the position vector — exactly the supremum of realizable payoff at degrees ≤ 1 — so every claim is prepaid at worst case and \"margin call\" has no referent."
    cite = "RISK_SUMMED_POSITIONS.md Props 1–2, §2.4; lean P_SOLV_01 family (lean/DragonsClutch/Solvency.lean, Transitions.lean)"
    source = ~"../../docs/research/RISK_SUMMED_POSITIONS.md"
    corroborant = ~"../../lean/DragonsClutch/Solvency.lean"
    teaches = "P5"
    measures = #[ coefficient_vector ][reg=set]
    refuses = #[ ][reg=set]
    refuses_external = #[ "leverage", "liquidation" ][reg=set]
    binds = #[ "monotone under partial resolution (Prop 8)" ][reg=set]
  }[reg=concept]

  risk_quotient: .{
    n = 13
    label = "risk quotient"
    define = "Where risk lives: the position space modulo the diagonal of complete sets, with quotient norm half the range `R(T)/2` — total risk across holders is identically zero at every Active state, moved only pairwise at trades."
    cite = "RISK_SUMMED_POSITIONS.md §1.3–1.4"
    source = ~"../../docs/research/RISK_SUMMED_POSITIONS.md"
    teaches = "P5"
    refines = #[ ][reg=set]
    refines_external = #[ "position" ][reg=set]
    binds = #[
      "is the domain any principled fee base must factor through -> dispersion"
      "is the domain any principled fee base must factor through -> quotient_norm"
      "collapsed to a point by -> hatch"
    ][reg=set]
  }[reg=concept]
}

^"holes"{
  # Relation targets the inventory names that are not themselves canon concepts.
  conservation_measures: "every transition — the transition set has no canon entry"
  sup_norm_refuses: "leverage, liquidation — named at entry 12, no canon entries"
  risk_quotient_refines: "position — named at entry 13, no canon entry"
}

~<./index.spw>
~<./algebra.spw>
~<./clearing.spw>
