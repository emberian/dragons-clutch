# Dragon's Clutch E0 toolchain snapshot. Host rows observed 2026-08-17 and
# proof-tool rows observed 2026-08-18, both on aarch64-apple-darwin. Do not
# treat an installed binary as a release pin until this file and the command
# output in TOOLCHAIN_SPIKE.md / PINNED_PROOF_TOOLS.md are refreshed together.
LAB_SCHEMA=1
HOST_RUST_TOOLCHAIN=1.89.0-aarch64-apple-darwin
HOST_RUST_VERSION='rustc 1.89.0 (29483883e 2025-08-04)'
SBF_CLI_VERSION='solana-cli 4.0.2'
SBF_BUILD_VERSION='cargo-build-sbf 4.0.0'
SBF_PLATFORM_TOOLS_VERSION='platform-tools v1.53'
SBF_RUST_VERSION='rustc 1.89.0'
Z3_VERSION='Z3 version 4.16.0'

# --- Verus (reviewed pin, retrieved 2026-08-18) ---
# Binary release; not built from source in this checkout.
VERUS_VERSION=0.2026.08.15.7d4628a
VERUS_RELEASE_TAG='release/0.2026.08.15.7d4628a'
VERUS_COMMIT=7d4628a8543d3e51e6e314c52032c9bab43f0f53
VERUS_ARTIFACT='verus-0.2026.08.15.7d4628a-arm64-macos.zip'
VERUS_ARTIFACT_SHA256=a9d03889dfbf841c92565be605cd857b4171943dac564b1f4c00ddcda9830ada
