ROCQ_COQC_BIN=/opt/homebrew/bin/coqc
ROCQ_OCAML_VERSION=5.5.0
# ClutchKernel.v typechecks. It contains zero theorems: its obligations are
# `Definition ... : Prop`, i.e. unproved statements. PASS here means
# "definitions elaborate", not "properties hold".
ROCQ_CHECK_STATUS=PASS
ROCQ_CHECK_PROOF_CONTENT=NONE
