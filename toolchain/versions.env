VERUS_BIN="$HOME/toolchains/verus-0.2026.08.15.7d4628a/verus-arm64-macos/verus"
VERUS_BIN_SHA256=07b3859fc335fd9bf803323baf82584dcefb62d74329561875353f5fde93fe8b
VERUS_RUST_TOOLCHAIN=1.97.1-aarch64-apple-darwin
# The Verus frontend toolchain (1.97.1) is NOT the host build toolchain
# (1.89.0). They are independent pins and must not be conflated.
VERUS_Z3_BUNDLED='Z3 version 4.16.0 - 64 bit'
VERUS_Z3_BIN="$HOME/toolchains/verus-0.2026.08.15.7d4628a/verus-arm64-macos/z3"
VERUS_Z3_SHA256=edae32f9e37ea4b5bb35310d72f0e352d0dc07626cac4e9e30bc1ea9a5bc8efb
# vstd ships prebuilt inside the release and carries no independent revision;
# it is pinned transitively by VERUS_COMMIT only.
VERUS_VSTD_RLIB_SHA256=91f842643674660a1da8799eda3eceaa37e5816682d026b3d860bc59a81be61c
VERUS_VSTD_VIR_SHA256=3061321483841360c760fa3fb38b22be57533052cf2100eb51956aa31205fa7d
VERUS_PROBE_STATUS=FAIL
VERUS_PROBE_REASON='pinned Verus rejects the pinned probe source: verus_builtin crate not imported'
# A separate, later production-bound gate. This does not turn the historical
# no_std probe above green and does not verify a whole kernel transition.
VERUS_TRANSFER_REFINEMENT_STATUS=PASS
VERUS_TRANSFER_SOURCE_SHA256=01a04ce8b6cf94680d0451e883a142bc580e358dd06088314f945e5ebaa72df3
VERUS_TRANSFER_CALL_SITE_SHA256=2fe06410feeb72ce7322a57ae9efd92632c2cd167ba69dce388ace235951791e
VERUS_TRANSFER_GENERATED_PROOF_SHA256=61ec35d9731fab2626f7be97e5589431a3569396a97d22d1e57b1d68c50a408c
VERUS_TRANSFER_MUTATIONS='delta-direction:EXPECTED_RED conservation-guard:EXPECTED_RED'

# --- Rocq (reviewed pin, retrieved 2026-08-18) ---
ROCQ_VERSION='The Rocq Prover, version 9.2'
ROCQ_RELEASE=9.2.0
ROCQ_INSTALL_METHOD='homebrew/core formula rocq 9.2.0 (bottle arm64_tahoe, rebuild 0)'
ROCQ_SOURCE_URL='https://github.com/rocq-prover/rocq/releases/download/V9.2.0/rocq-9.2.0.tar.gz'
