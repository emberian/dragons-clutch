import DClutchSemantics.SeriesCoreFoundAckV2Abi

/-! Emit the Lean-owned Series Core Found acknowledgment V2 fixed ABI. -/

open DClutch
open DClutch.AbiSchema
open DClutch.SeriesCoreFoundAckV2Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (name : String) (value : List UInt8) : IO Unit := do
  IO.println s!"pub const {name}: [u8; {value.length}] = ["
  IO.println s!"    {String.intercalate ", " (value.map rustByte)},"
  IO.println "];"

def emitSlice (name : String) (value : List UInt8) : IO Unit := do
  IO.println s!"pub const {name}: &[u8] = &["
  IO.println s!"    {String.intercalate ", " (value.map rustByte)},"
  IO.println "];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitSeriesCoreFoundAckV2Rust.lean; do not edit."
  IO.println s!"pub const SERIES_CORE_FOUND_ACK_BYTES_V2: usize = {bytes};"
  IO.println s!"pub const SERIES_CORE_FOUND_ACK_VERSION_V2: u16 = {schemaVersion};"
  emitBytes "SERIES_CORE_FOUND_ACK_MAGIC_V2" magic
  emitSlice "SERIES_CORE_FOUND_ACK_SCHEMA_RELEASE_PREIMAGE_V2" schemaReleasePreimage
  emitBytes "SERIES_CORE_FOUND_ACK_SCHEMA_RELEASE_ID_V2" schemaReleaseId
  for field in layout do
    IO.println s!"pub const {Field.rustName field.spec.name}: usize = {field.offset};"
