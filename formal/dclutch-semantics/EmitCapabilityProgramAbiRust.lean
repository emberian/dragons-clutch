import DClutchSemantics.CapabilityProgramAbi
import DClutchSemantics.Codec

/-! Emit the Lean-owned capability-program and immutable child-root layouts. -/

open DClutch
open DClutch.AbiSchema
open DClutch.CapabilityProgramAbi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (name : String) (value : List UInt8) : IO Unit := do
  IO.println s!"pub const {name}: [u8; {value.length}] = ["
  IO.println s!"    {String.intercalate ", " (value.map rustByte)},"
  IO.println "];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitCapabilityProgramAbiRust.lean; do not edit."
  IO.println s!"pub const CAPABILITY_PROGRAM_HEADER_BYTES_V1: usize = {descriptorHeaderBytes};"
  IO.println s!"pub const CAPABILITY_PROGRAM_MAX_BYTES_V1: usize = {descriptorMaxBytes};"
  IO.println s!"pub const CAPABILITY_ROOT_STATE_MAX_BYTES_V1: usize = {rootStateMaxBytes};"
  IO.println s!"pub const CAPABILITY_ROOT_ACCOUNT_MAX_BYTES_V1: usize = {rootAccountMaxBytes};"
  IO.println s!"pub const CAPABILITY_PROGRAM_SCHEMA_VERSION_V1: u16 = {schemaVersion};"
  IO.println s!"pub const CAPABILITY_PROGRAM_PROFILE_V1: u16 = {artifactProfile};"
  emitBytes "CAPABILITY_PROGRAM_MAGIC_V1" descriptorMagic
  for field in descriptorLayout do
    IO.println s!"pub const {DescriptorField.rustName field.spec.name}: usize = {field.offset};"
  IO.println s!"pub const CAPABILITY_ROOT_HEADER_BYTES_V1: usize = {rootHeaderBytes};"
  IO.println s!"pub const CAPABILITY_ROOT_SCHEMA_VERSION_V1: u16 = {schemaVersion};"
  IO.println s!"pub const CAPABILITY_ROOT_PROFILE_V1: u16 = {artifactProfile};"
  emitBytes "CAPABILITY_ROOT_MAGIC_V1" rootMagic
  for field in rootHeaderLayout do
    IO.println s!"pub const {RootField.rustName field.spec.name}: usize = {field.offset};"
