import DClutchSemantics.DealerTradingProfile

open DClutch DClutch.Dealer.TradingProfile

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (name : String) (bytes : List UInt8) : IO Unit := do
  IO.println s!"pub(crate) const {name}: [u8; {bytes.length}] = ["
  for line in List.range ((bytes.length + 15) / 16) do
    let chunk := (bytes.drop (line * 16)).take 16
    IO.println s!"    {String.intercalate ", " (chunk.map rustByte)},"
  IO.println "];"

def emitOffset (rustName : String) (field : TailField) : IO Unit :=
  IO.println s!"pub(crate) const {rustName}_OFFSET: usize = {fieldOffset field};"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitDealerTradingProfileRust.lean; do not edit."
  IO.println s!"pub(crate) const ROOT_TAIL_ABI_VERSION: u16 = {abiVersion};"
  IO.println s!"pub(crate) const ROOT_TAIL_BYTES: usize = {tailBytes};"
  IO.println s!"pub(crate) const TRADING_REQUEST_BYTES: usize = {requestBytes};"
  emitBytes "ROOT_TAIL_MAGIC" tailMagic
  emitBytes "TRADING_REQUEST_MAGIC" requestMagic
  for (name, field) in [
      ("ROOT_TAIL_VERSION", TailField.version),
      ("ROOT_TAIL_PHASE", .phase), ("ROOT_TAIL_HAS_PENDING", .hasPending),
      ("ROOT_TAIL_RESERVED", .reserved),
      ("ROOT_TAIL_ACTIVE_CANDIDATE_ID", .activeCandidateId),
      ("ROOT_TAIL_PENDING_CANDIDATE_ID", .pendingCandidateId),
      ("ROOT_TAIL_ACTIVE_REVISION", .activeRevision),
      ("ROOT_TAIL_PENDING_REVISION", .pendingRevision),
      ("ROOT_TAIL_STATE_REVISION", .stateRevision),
      ("ROOT_TAIL_BUY_USED", .buyUsed), ("ROOT_TAIL_SELL_USED", .sellUsed),
      ("ROOT_TAIL_FEE_BASE", .feeBase),
      ("ROOT_TAIL_ACTIVE_WORK_REMAINING", .activeWorkRemaining),
      ("ROOT_TAIL_PENDING_WORK_FUNDING", .pendingWorkFunding)] do
    emitOffset name field
  for (name, field) in [
      ("TRADING_REQUEST_VERSION", RequestField.version),
      ("TRADING_REQUEST_ACTION", .action), ("TRADING_REQUEST_SIDE", .side),
      ("TRADING_REQUEST_OUTCOME", .outcome),
      ("TRADING_REQUEST_RESERVED", .reserved),
      ("TRADING_REQUEST_EXPECTED_STATE_REVISION", .expectedStateRevision),
      ("TRADING_REQUEST_EXPECTED_POSITION_REVISION", .expectedPositionRevision),
      ("TRADING_REQUEST_NOW", .now), ("TRADING_REQUEST_QUANTITY", .quantity),
      ("TRADING_REQUEST_EXPECTED_CANDIDATE_ID", .expectedCandidateId),
      ("TRADING_REQUEST_ACTOR_ID", .actorId),
      ("TRADING_REQUEST_REPLACEMENT_CANDIDATE_ID", .replacementCandidateId),
      ("TRADING_REQUEST_EXPECTED_CANDIDATE_REVISION", .expectedCandidateRevision)] do
    IO.println s!"pub(crate) const {name}_OFFSET: usize = {requestFieldOffset field};"
