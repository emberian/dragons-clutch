import DClutchSemantics.GeneralControllerRequestV3
import DClutchSemantics.Codec

open DClutch DClutch.General.ControllerRequestV3

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (name : String) (bytes : List UInt8) : IO Unit := do
  IO.println s!"pub(crate) const {name}: [u8; {bytes.length}] = ["
  IO.println s!"    {String.intercalate ", " (bytes.map rustByte)},"
  IO.println "];"

def emitOffset (name : String) (field : RequestField) : IO Unit :=
  IO.println s!"pub(crate) const {name}: usize = {fieldOffset requestLayout field};"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitGeneralControllerRequestV3Rust.lean; do not edit."
  IO.println s!"pub(crate) const REQUEST_V3_ABI_VERSION: u16 = {abiVersion};"
  IO.println s!"pub(crate) const REQUEST_V3_BYTES: usize = {requestBytes};"
  emitBytes "REQUEST_V3_MAGIC" requestMagic
  emitOffset "REQUEST_V3_ACTION_OFFSET" .action
  emitOffset "REQUEST_V3_MANIFEST_ORDER_OFFSET" .manifestOrderIndex
  emitOffset "REQUEST_V3_EXPECTED_REVISION_OFFSET" .expectedRevision
  emitOffset "REQUEST_V3_SUBJECT_ID_OFFSET" .subjectId
  emitOffset "REQUEST_V3_PAGE_INDEX_OFFSET" .pageIndex
  emitOffset "REQUEST_V3_EXECUTION_INDEX_OFFSET" .executionIndex
  emitOffset "REQUEST_V3_PRIMARY_BUMP_OFFSET" .primaryStateBump
  emitOffset "REQUEST_V3_SECONDARY_BUMP_OFFSET" .secondaryStateBump
  emitOffset "REQUEST_V3_RESULT_BUMP_OFFSET" .resultStateBump
