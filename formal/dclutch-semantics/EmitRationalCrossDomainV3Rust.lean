import DClutchSemantics.RationalCrossDomainV3

/-! Emit only Lean-owned Rational K/N differential corpus bytes. -/

open DClutch
open DClutch.RationalCrossDomainV3

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (name : String) (value : List UInt8) : IO Unit :=
  IO.println s!"pub const {name}: [u8; {value.length}] = [{String.intercalate ", " (value.map rustByte)}];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitRationalCrossDomainV3Rust.lean; do not edit."
  emitBytes "RATIONAL_CROSS_DOMAIN_MAGIC_V3" corpusMagic
  IO.println s!"pub const RATIONAL_CROSS_DOMAIN_VERSION_V3: u16 = {corpusVersion};"
  IO.println s!"pub const RATIONAL_CROSS_DOMAIN_BYTES_V3: usize = {corpusBytes};"
  for field in corpusLayout do
    IO.println s!"pub const {CorpusField.rustName field.spec.name}: usize = {field.offset};"
  emitBytes "RATIONAL_CROSS_DOMAIN_K3_N9_WITNESS" (encodeCorpus witnessK3N9)
  emitBytes "RATIONAL_CROSS_DOMAIN_K3_N258_WITNESS" (encodeCorpus witnessK3N258)
  emitBytes "RATIONAL_CROSS_DOMAIN_CLAIM_AT_K_REFUSAL" hostileClaimAtK
  emitBytes "RATIONAL_CROSS_DOMAIN_TERMINAL_AT_N9_REFUSAL" hostileTerminalAtN9
  emitBytes "RATIONAL_CROSS_DOMAIN_TERMINAL_AS_CLAIM_REFUSAL" hostileTerminalAsClaimN258
  emitBytes "RATIONAL_CROSS_DOMAIN_TERMINAL_AT_N258_REFUSAL" hostileTerminalAtN258
  emitBytes "RATIONAL_CROSS_DOMAIN_ZERO_BASIS_REFUSAL" hostileZeroBasisWidth
  emitBytes "RATIONAL_CROSS_DOMAIN_ZERO_TERMINAL_REFUSAL" hostileZeroTerminalWidth
  emitBytes "RATIONAL_CROSS_DOMAIN_RESERVED_REFUSAL" hostileNonzeroReserved
