import DClutchSemantics.CapabilityFundingHeaderV2Abi
import DClutchSemantics.Codec

/-! Emit the Lean-owned Capability Funding Header V2 fixed ABI. -/

open DClutch
open DClutch.AbiSchema
open DClutch.CapabilityFundingHeaderV2Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (name : String) (value : List UInt8) : IO Unit := do
  IO.println s!"pub(crate) const {name}: [u8; {value.length}] ="
  IO.println s!"    [{String.intercalate ", " (value.map rustByte)}];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitCapabilityFundingHeaderV2Rust.lean; do not edit."
  IO.println "/// Exact byte width of the canonical capability-funding routing header."
  IO.println s!"pub const CAPABILITY_FUNDING_HEADER_BYTES_V2: usize = {bytes};"
  IO.println s!"pub(crate) const CAPABILITY_FUNDING_HEADER_VERSION_V2: u16 = {schemaVersion};"
  IO.println s!"pub(crate) const CAPABILITY_FUNDING_MAX_PHYSICAL_COUNT_V2: u8 = {maxPhysicalCount};"
  IO.println s!"pub(crate) const CAPABILITY_FUNDING_MAX_LOGICAL_COUNT_V2: u8 = {maxLogicalCount};"
  emitBytes "CAPABILITY_FUNDING_HEADER_MAGIC_V2" magic
  for field in layout do
    IO.println s!"pub(crate) const {Field.rustName field.spec.name}: usize = {field.offset};"
