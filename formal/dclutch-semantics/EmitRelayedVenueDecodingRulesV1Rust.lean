  IO.println s!"pub const DBC_VENUE_INLINE_BYTES_V1: usize = {venueInlineBytes};"

  IO.println s!"pub const MIGRATION_PROGRESS_PRE_BONDING_CURVE_V1: u8 = {MigrationProgress.byte .preBondingCurve};"
  IO.println s!"pub const MIGRATION_PROGRESS_POST_BONDING_CURVE_V1: u8 = {MigrationProgress.byte .postBondingCurve};"
