import DClutchSemantics.RelayedVenueDecodingRulesV1

open DClutch DClutch.RelayedVenueDecodingRulesV1

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (visibility name : String) (value : List UInt8) : IO Unit := do
  IO.println "#[rustfmt::skip]"
  IO.println s!"{visibility} const {name}: [u8; {value.length}] = ["
  IO.println s!"    {String.intercalate ", " (value.map rustByte)},"
  IO.println "];"

def emitLengths (name : String) (value : List Nat) : IO Unit := do
  IO.println s!"pub const {name}: &[u32] = &["
  IO.println s!"    {String.intercalate ", " (value.map toString)},"
  IO.println "];"

def rustInt (value : Int) : String :=
  if value < 0 then s!"-{-value}" else toString value

def emitAcceptanceTable (name : String) (rows : List (Nat × Nat × Nat × Bool × Int)) : IO Unit := do
  IO.println "#[cfg(test)]"
  IO.println s!"pub(crate) const {name}_COUNT: usize = {rows.length};"
  IO.println "#[cfg(test)]"
  IO.println "#[rustfmt::skip]"
  IO.println s!"pub(crate) const {name}: [(u8, u8, u64, bool, i128); {rows.length}] = ["
  for row in rows do
    let (progress, isMigrated, finish, accepted, atoms) := row
    let acceptedText := if accepted then "true" else "false"
    IO.println s!"    ({progress}, {isMigrated}, {finish}, {acceptedText}, {rustInt atoms}),"
  IO.println "];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitRelayedVenueDecodingRulesV1Rust.lean; do not edit."
  IO.println "// The venue decoding-rules table of `RelayedMainnetStateV1`: which observable a"
  IO.println "// Source selects, where the observed bytes live, and what a graduation is."

  IO.println s!"pub const RELAYED_OBSERVABLE_DBC_MIGRATION_PROGRESS_V1: u32 = {Observable.selector .dbcMigrationProgress};"
  IO.println s!"pub const RELAYED_OBSERVABLE_DBC_RAW_EXPONENT_V1: i32 = {rustInt (Observable.rawExponent .dbcMigrationProgress)};"

  IO.println s!"pub const DBC_VENUE_SET_CARDINALITY_V1: u16 = {venueSetCardinality};"
  IO.println s!"pub const DBC_PROGRAM_POSITION_V1: u16 = {programPosition};"
  IO.println s!"pub const DBC_PROGRAMDATA_POSITION_V1: u16 = {programDataPosition};"
  IO.println s!"pub const DBC_VENUE_POSITION_V1: u16 = {venuePosition};"
  IO.println s!"pub const DBC_CLOCK_POSITION_V1: u16 = {clockPosition};"

  emitBytes "pub" "OBSERVED_CLOCK_SYSVAR_KEY_V1" clockSysvarKey
  emitBytes "pub" "OBSERVED_SYSVAR_OWNER_V1" sysvarOwner
  IO.println s!"pub const OBSERVED_CLOCK_SLOT_OFFSET_V1: usize = {clockSlotOffset};"
  IO.println s!"pub const OBSERVED_CLOCK_UNIX_TIMESTAMP_OFFSET_V1: usize = {clockUnixTimestampOffset};"
  IO.println s!"pub const OBSERVED_CLOCK_FIELD_BYTES_V1: usize = {clockFieldBytes};"

  emitBytes "pub" "DBC_VIRTUAL_POOL_DISCRIMINATOR_V1" virtualPoolDiscriminator
  emitBytes "pub" "DBC_TRANSFER_HOOK_POOL_DISCRIMINATOR_V1" transferHookPoolDiscriminator
  emitLengths "DBC_ADMITTED_DATA_LENGTHS_V1" admittedDataLengths
  IO.println s!"pub const DBC_DISCRIMINATOR_OFFSET_V1: usize = {discriminatorOffset};"
  IO.println s!"pub const DBC_DISCRIMINATOR_BYTES_V1: usize = {discriminatorBytes};"
  IO.println s!"pub const DBC_IS_MIGRATED_OFFSET_V1: usize = {isMigratedOffset};"
  IO.println s!"pub const DBC_MIGRATION_PROGRESS_OFFSET_V1: usize = {migrationProgressOffset};"
  IO.println s!"pub const DBC_FINISH_CURVE_TIMESTAMP_OFFSET_V1: usize = {finishCurveTimestampOffset};"
