import DClutchSemantics.DealerLiquidityAbi

open DClutch DClutch.Dealer.Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (name : String) (bytes : List UInt8) : IO Unit := do
  IO.println s!"pub(crate) const {name}: [u8; {bytes.length}] = ["
  for line in List.range ((bytes.length + 15) / 16) do
    let chunk := (bytes.drop (line * 16)).take 16
    IO.println s!"    {String.intercalate ", " (chunk.map rustByte)},"
  IO.println "];"

def emitOffset {Name : Type} [DecidableEq Name]
    (rustPrefix name : String) (layout : List (AbiSchema.PlacedField Name))
    (field : Name) : IO Unit :=
  IO.println s!"pub(crate) const {rustPrefix}_{name}_OFFSET: usize = {fieldOffset layout field};"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitDealerLiquidityAbiRust.lean; do not edit."
  IO.println s!"pub(crate) const ABI_VERSION: u16 = {abiVersion};"
  IO.println s!"pub(crate) const MAX_OUTCOMES: usize = {maxOutcomes};"
  IO.println s!"pub(crate) const MAX_BANDS_PER_SIDE: usize = {maxBandsPerSide};"
  IO.println s!"pub(crate) const BAND_BYTES: usize = {bandBytes};"
  IO.println s!"pub(crate) const OUTCOME_CURVE_BYTES: usize = {outcomeCurveBytes};"
  IO.println s!"pub(crate) const MAX_CUSTODY_TRANSFERS: usize = {maxCustodyTransfers};"
  IO.println s!"pub(crate) const POLICY_BYTES: usize = {policyBytes};"
  IO.println s!"pub(crate) const CANDIDATE_BYTES: usize = {candidateBytes};"
  IO.println s!"pub(crate) const STATE_BYTES: usize = {stateBytes};"
  IO.println s!"pub(crate) const RECEIPT_BYTES: usize = {receiptBytes};"
  IO.println s!"pub(crate) const REQUEST_BYTES: usize = {requestBytes};"
  emitBytes "POLICY_MAGIC" policyMagic
  emitBytes "CANDIDATE_MAGIC" candidateMagic
  emitBytes "STATE_MAGIC" stateMagic
  emitBytes "RECEIPT_MAGIC" receiptMagic
  emitBytes "REQUEST_MAGIC" requestMagic
  for (name, field) in [
      ("VERSION", PolicyField.version), ("OUTCOME_COUNT", .outcomeCount),
      ("RESERVED", .reserved), ("MARKET_ID", .marketId),
      ("RELEASE_SET_ID", .releaseSetId), ("DEALER_ID", .dealerId),
      ("FEE_RECIPIENT_ID", .feeRecipientId),
      ("UNWIND_RECIPIENT_ID", .unwindRecipientId),
      ("QUOTE_SCALE", .quoteScale), ("FEE_NUMERATOR", .feeNumerator),
      ("FEE_DENOMINATOR", .feeDenominator),
      ("MINIMUM_WORK_FUNDING", .minimumWorkFunding),
      ("REPLACEMENT_DELAY", .replacementDelay)] do
    emitOffset "POLICY" name policyLayout field
  for (name, field) in [
      ("VERSION", CandidateField.version), ("OUTCOME_COUNT", .outcomeCount),
      ("RESERVED", .reserved), ("CANDIDATE_ID", .candidateId),
      ("REVISION", .revision), ("VALID_FROM", .validFrom),
      ("EXPIRES_AT", .expiresAt), ("QUOTE_RESERVE_FLOOR", .quoteReserveFloor),
      ("WORK_FUNDING", .workFunding), ("WORK_REWARD", .workReward),
      ("MINIMUM_INVENTORY", .minimumInventory),
      ("MAXIMUM_INVENTORY", .maximumInventory), ("CURVES", .curves)] do
    emitOffset "CANDIDATE" name candidateLayout field
  for (name, field) in [
      ("VERSION", StateField.version), ("PHASE", .phase),
      ("OUTCOME_COUNT", .outcomeCount), ("HAS_PENDING", .hasPending),
      ("WINNER", .winner), ("RESERVED_A", .reservedA),
      ("ACTIVE_CANDIDATE_ID", .activeCandidateId),
      ("PENDING_CANDIDATE_ID", .pendingCandidateId),
      ("RELEASE_SET_ID", .releaseSetId), ("ACTIVE_REVISION", .activeRevision),
      ("PENDING_REVISION", .pendingRevision), ("STATE_REVISION", .stateRevision),
      ("RESERVED_B", .reservedB), ("INVENTORY", .inventory),
      ("BUY_USED", .buyUsed), ("SELL_USED", .sellUsed),
      ("BUY_QUOTE_PAID", .buyQuotePaid), ("SELL_QUOTE_PAID", .sellQuotePaid),
      ("FEE_BASE", .feeBase), ("FEE_PAID", .feePaid),
      ("QUOTE_CUSTODY", .quoteCustody), ("FEE_CUSTODY", .feeCustody),
      ("LIVENESS_CUSTODY", .livenessCustody),
      ("ACTIVE_WORK_REMAINING", .activeWorkRemaining),
      ("PENDING_WORK_FUNDING", .pendingWorkFunding)] do
    emitOffset "STATE" name stateLayout field
  for (name, field) in [
      ("VERSION", ReceiptField.version), ("ROLE", .role), ("FLAGS", .flags),
      ("RESERVED", .reserved), ("REGISTRY_PROGRAM", .registryProgram),
      ("RELEASE_SET_ID", .releaseSetId), ("PROGRAM", .program),
      ("ARTIFACT_RELEASE", .artifactRelease), ("SEMANTIC_RELEASE", .semanticRelease)] do
    emitOffset "RECEIPT" name receiptLayout field
  for (name, field) in [
      ("VERSION", RequestField.version), ("ACTION", .action), ("SIDE", .side),
      ("OUTCOME", .outcome), ("RESERVED", .reserved),
      ("EXPECTED_STATE_REVISION", .expectedStateRevision), ("NOW", .now),
      ("QUANTITY", .quantity), ("EXPECTED_CANDIDATE_ID", .expectedCandidateId),
      ("ACTOR_ID", .actorId), ("REPLACEMENT_CANDIDATE_ID", .replacementCandidateId),
      ("EXPECTED_CANDIDATE_REVISION", .expectedCandidateRevision)] do
    emitOffset "REQUEST" name requestLayout field
  IO.println "pub(crate) const CURVE_BID_COUNT_OFFSET: usize = 0;"
  IO.println "pub(crate) const CURVE_ASK_COUNT_OFFSET: usize = 1;"
  IO.println "pub(crate) const CURVE_RESERVED_OFFSET: usize = 2;"
  IO.println "pub(crate) const CURVE_BIDS_OFFSET: usize = 8;"
  IO.println s!"pub(crate) const CURVE_ASKS_OFFSET: usize = {8 + maxBandsPerSide * bandBytes};"
  IO.println "pub(crate) const BAND_CAPACITY_OFFSET: usize = 0;"
  IO.println "pub(crate) const BAND_PRICE_OFFSET: usize = 8;"
  IO.println "pub(crate) const ACTION_SCHEDULE_REPLACEMENT: u8 = 0;"
  IO.println "pub(crate) const ACTION_ACTIVATE_REPLACEMENT: u8 = 1;"
  IO.println "pub(crate) const ACTION_FILL: u8 = 2;"
  IO.println "pub(crate) const ACTION_ENTER_TERMINAL: u8 = 3;"
  IO.println "pub(crate) const ACTION_UNWIND: u8 = 4;"
  IO.println "pub(crate) const ACTION_RETIRE: u8 = 5;"
  IO.println "pub(crate) const ACTION_ADD_LIQUIDITY: u8 = 6;"
  IO.println "pub(crate) const ACTION_REMOVE_LIQUIDITY: u8 = 7;"
  IO.println s!"pub(crate) const PHASE_OPEN: u8 = {phaseOpen.toNat};"
  IO.println s!"pub(crate) const PHASE_TERMINAL: u8 = {phaseTerminal.toNat};"
  IO.println s!"pub(crate) const PHASE_RETIRED: u8 = {phaseRetired.toNat};"
  IO.println s!"pub(crate) const SIDE_BUY: u8 = {sideBuy.toNat};"
  IO.println s!"pub(crate) const SIDE_SELL: u8 = {sideSell.toNat};"
  IO.println s!"pub(crate) const TRADING_ROLE: u8 = {tradingRole.toNat};"
  IO.println s!"pub(crate) const RECEIPT_REQUIRED_FLAGS: u8 = {receiptRequiredFlags.toNat};"
  IO.println "#[cfg(test)]"
  emitBytes "REQUEST_EXAMPLE" exampleRequest
