import DClutchSemantics.SourceMaterialV2Abi

open DClutch DClutch.SourceMaterialV2Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (visibility name : String) (value : List UInt8) : IO Unit := do
  IO.println "#[rustfmt::skip]"
  IO.println s!"{visibility} const {name}: [u8; {value.length}] = ["
  for line in List.range ((value.length + 15) / 16) do
    let chunk := (value.drop (line * 16)).take 16
    IO.println s!"    {String.intercalate ", " (chunk.map rustByte)},"
  IO.println "];"

def emitSlice (name : String) (value : List UInt8) : IO Unit := do
  IO.println "#[rustfmt::skip]"
  IO.println s!"pub const {name}: &[u8] = &["
  IO.println s!"    {String.intercalate ", " (value.map rustByte)},"
  IO.println "];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitSourceMaterialV2AbiRust.lean; do not edit."
  IO.println s!"pub const SOURCE_MATERIAL_V2_BYTES: usize = {bytes};"
  IO.println s!"pub const SOURCE_MATERIAL_V2_SCHEMA_VERSION: u16 = {schemaVersion};"
  emitBytes "pub" "SOURCE_MATERIAL_V2_MAGIC" magic
  emitSlice "SOURCE_MATERIAL_SCHEMA_RELEASE_PREIMAGE_V2" schemaReleasePreimage
  emitBytes "pub" "SOURCE_MATERIAL_SCHEMA_RELEASE_ID_V2" schemaReleaseId
  emitSlice "SOURCE_MATERIAL_DERIVATION_RELEASE_PREIMAGE_V2" derivationReleasePreimage
  emitBytes "pub" "SOURCE_MATERIAL_DERIVATION_RELEASE_ID_V2" derivationReleaseId
  emitSlice "SOURCE_FAILURE_POLICY_RELEASE_PREIMAGE_V2" failurePolicyReleasePreimage
  emitBytes "pub" "SOURCE_FAILURE_POLICY_RELEASE_ID_V2" failurePolicyReleaseId
  for field in layout do
    IO.println s!"pub const {Field.rustName field.spec.name}: usize = {field.offset};"
  IO.println "#[cfg(test)]"
  emitBytes "pub(crate)" "SOURCE_MATERIAL_V2_EXAMPLE" (encode exampleMaterial)
  IO.println "#[cfg(test)]"
  emitBytes "pub(crate)" "SOURCE_MATERIAL_V2_ZERO_RECOVERY_EXAMPLE" (encode zeroRecoveryExample)
  IO.println "#[cfg(test)]"
  IO.println s!"pub(crate) const SOURCE_MATERIAL_V2_REFUSAL_COUNT: usize = {refusalCorpus.length};"
  IO.println "#[cfg(test)]"
  IO.println "#[rustfmt::skip]"
  IO.println s!"pub(crate) const SOURCE_MATERIAL_V2_REFUSAL_CORPUS: [[u8; {bytes}]; {refusalCorpus.length}] = ["
  for value in refusalCorpus do
    IO.println "    ["
    for line in List.range ((value.length + 15) / 16) do
      let chunk := (value.drop (line * 16)).take 16
      IO.println s!"        {String.intercalate ", " (chunk.map rustByte)},"
    IO.println "    ],"
  IO.println "];"
