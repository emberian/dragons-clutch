import DClutchSemantics.GeneralConfigV3Abi

open DClutch.General.ConfigV3Abi

def emitOffset (name : String) (field : ConfigField) : IO Unit :=
  IO.println s!"pub(crate) const CONFIG_{name}_OFFSET_V3: usize = {fieldOffset configLayout field};"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitGeneralConfigV3AbiRust.lean; do not edit."
  IO.println s!"pub(crate) const ABI_VERSION_V3: u16 = {abiVersion};"
  IO.println s!"pub(crate) const ARTIFACT_PROFILE_V3: u16 = {artifactProfile};"
  IO.println s!"pub(crate) const GENERAL_CONFIG_BYTES_V3: usize = {configBytes};"
  for (name, field) in [
      ("VERSION", ConfigField.version), ("ARTIFACT_PROFILE", .artifactProfile),
      ("RESERVED", .reserved), ("CAPACITY_PROFILE_ID", .capacityProfileId),
      ("CLAIM_BASIS_ID", .claimBasisId), ("PROGRAM_SET_ID", .programSetId),
      ("GENERATION", .generation), ("PRICE_SCALE", .priceScale),
      ("COLLECTION_SLOTS", .collectionSlots), ("SELECTION_SLOTS", .selectionSlots),
      ("SETTLEMENT_SLOTS", .settlementSlots),
      ("MAX_ORDERS_PER_CANDIDATE", .maxOrdersPerCandidate),
      ("MAX_PAGES_PER_CANDIDATE", .maxPagesPerCandidate),
      ("CONTINUATION_REWARD_LAMPORTS", .continuationRewardLamports),
      ("SELECTION_POLICY_ID", .selectionPolicyId),
      ("QUOTE_SURPLUS_BENEFICIARY", .quoteSurplusBeneficiary)] do
    emitOffset name field
