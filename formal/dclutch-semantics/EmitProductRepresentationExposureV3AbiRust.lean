import DClutchSemantics.ProductRepresentationExposureV3Abi

open DClutch
open DClutch.ProductRepresentationExposureV3Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"
def emitBytes (name : String) (value : List UInt8) : IO Unit :=
  IO.println s!"pub const {name}: [u8; {value.length}] = [{String.intercalate ", " (value.map rustByte)}];"
def emitSlice (name : String) (value : List UInt8) : IO Unit :=
  IO.println s!"pub const {name}: &[u8] = &[{String.intercalate ", " (value.map rustByte)}];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitProductRepresentationExposureV3AbiRust.lean; do not edit."
  IO.println s!"pub const COMPOSITION_EXPOSURE_VERSION_LEAN_V3: u16 = {version};"
  IO.println s!"pub const COMPOSITION_EXPOSURE_MIN_PRODUCT_WIDTH_LEAN_V3: u32 = {minProductWidth};"
  IO.println s!"pub const COMPOSITION_EXPOSURE_MAX_PRODUCT_WIDTH_LEAN_V3: u32 = {maxProductWidth};"
  IO.println s!"pub const COMPOSITION_EXPOSURE_MAX_REPRESENTATION_WIDTH_LEAN_V3: u32 = {maxRepresentationWidth};"
  IO.println s!"pub const COMPOSITION_EXPOSURE_MAX_TERMS_LEAN_V3: u32 = {maxTerms};"
  IO.println s!"pub const COMPOSITION_EXPOSURE_HEADER_BYTES_LEAN_V3: usize = {headerBytes};"
  IO.println s!"pub const COMPOSITION_EXPOSURE_ROW_BYTES_LEAN_V3: usize = {rowBytes};"
  IO.println s!"pub const COMPOSITION_EXPOSURE_TERM_BYTES_LEAN_V3: usize = {termBytes};"
  emitBytes "COMPOSITION_EXPOSURE_MAGIC_LEAN_V3" magic
  emitSlice "COMPOSITION_EXPOSURE_SCHEMA_PREIMAGE_LEAN_V3" schemaPreimage
  emitBytes "COMPOSITION_EXPOSURE_SCHEMA_ID_LEAN_V3" schemaId
  emitSlice "COMPOSITION_EXPOSURE_CAPACITY_PREIMAGE_LEAN_V3" capacityPreimage
  emitBytes "COMPOSITION_EXPOSURE_CAPACITY_ID_LEAN_V3" capacityId
  for field in headerLayout do
    IO.println s!"pub const {HeaderField.rustName field.spec.name}: usize = {field.offset};"
  for field in rowLayout do
    IO.println s!"pub const {RowField.rustName field.spec.name}: usize = {field.offset};"
  for field in termLayout do
    IO.println s!"pub const {TermField.rustName field.spec.name}: usize = {field.offset};"
  emitBytes "COMPOSITION_EXPOSURE_K3_N1_WITNESS_V3" k3n1Witness
  emitBytes "COMPOSITION_EXPOSURE_K3_N258_WITNESS_V3" k3n258Witness
  emitBytes "COMPOSITION_EXPOSURE_RANK_CYCLE_REFUSAL_V3" rankCycleRefusal
  emitBytes "COMPOSITION_EXPOSURE_WIDTH_REFUSAL_V3" widthRefusal
  emitBytes "COMPOSITION_EXPOSURE_RELEASE_TRANSPLANT_REFUSAL_V3" releaseTransplantRefusal
