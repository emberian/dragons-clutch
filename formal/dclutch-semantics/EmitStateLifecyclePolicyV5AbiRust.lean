import DClutchSemantics.StateLifecyclePolicyV5Abi

/-! Emit only the Lean-owned Lifecycle V5 fixed ABI constants and corpus. -/

open DClutch
open DClutch.StateLifecyclePolicyV5Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (name : String) (value : List UInt8) : IO Unit := do
  IO.println s!"pub const {name}: [u8; {value.length}] = ["
  IO.println s!"    {String.intercalate ", " (value.map rustByte)},"
  IO.println "];"

def emitSlice (name : String) (value : List UInt8) : IO Unit := do
  IO.println s!"pub const {name}: &[u8] = &["
  IO.println s!"    {String.intercalate ", " (value.map rustByte)},"
  IO.println "];"

def emitCorpus (name : String) (corpus : List (List UInt8)) : IO Unit := do
  IO.println s!"pub const {name}: [&[u8]; {corpus.length}] = ["
  for value in corpus do
    IO.println s!"    &[{String.intercalate ", " (value.map rustByte)}],"
  IO.println "];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitStateLifecyclePolicyV5AbiRust.lean; do not edit."
  IO.println s!"pub const STATE_LIFECYCLE_V5_HEADER_BYTES: usize = {headerBytes};"
  IO.println s!"pub const STATE_LIFECYCLE_V5_CURRENT_RENT_QUOTE_BYTES: usize = {currentRentQuoteBytes};"
  IO.println s!"pub const STATE_LIFECYCLE_V5_MAX_CURRENT_RENT_QUOTES: u16 = {maxCurrentRentQuotes};"
  IO.println s!"pub const STATE_LIFECYCLE_V5_SCHEMA_VERSION: u16 = {schemaVersion};"
  IO.println s!"pub const STATE_LIFECYCLE_V5_ARTIFACT_PROFILE: u16 = {artifactProfile};"
  emitSlice "STATE_LIFECYCLE_V5_SCHEMA_RELEASE_PREIMAGE" schemaReleasePreimage
  emitBytes "STATE_LIFECYCLE_V5_SCHEMA_RELEASE_ID" schemaReleaseId
  emitBytes "STATE_LIFECYCLE_V5_MAGIC" magic
  for field in headerLayout do
    IO.println s!"pub const {HeaderField.rustName field.spec.name}: usize = {field.offset};"
  for field in currentRentQuoteLayout do
    IO.println s!"pub const {CurrentRentQuoteField.rustName field.spec.name}: usize = {field.offset};"
  IO.println "#[cfg(test)]"
  emitBytes "STATE_LIFECYCLE_V5_CANONICAL_EMPTY_HEADER" canonicalEmptyHeader
  IO.println "#[cfg(test)]"
  emitBytes "STATE_LIFECYCLE_V5_CURRENT_RENT_QUOTE_AGREEMENT" currentRentQuoteAgreement
  IO.println "#[cfg(test)]"
  emitCorpus "STATE_LIFECYCLE_V5_CURRENT_RENT_QUOTE_REFUSAL_CORPUS" currentRentQuoteRefusalCorpus
