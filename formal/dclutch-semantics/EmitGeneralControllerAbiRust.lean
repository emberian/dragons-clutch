import DClutchSemantics.GeneralControllerAbi

open DClutch DClutch.General.ControllerAbi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitRustBytes (visibility name : String) (bytes : List UInt8) : IO Unit := do
  IO.println s!"{visibility} const {name}: [u8; {bytes.length}] = ["
  for line in List.range ((bytes.length + 15) / 16) do
    let chunk := (bytes.drop (line * 16)).take 16
    IO.println s!"    {String.intercalate ", " (chunk.map rustByte)},"
  IO.println "];"

def emitOffset {Name : Type} [DecidableEq Name]
    (rustPrefix name : String) (layout : List (AbiSchema.PlacedField Name))
    (field : Name) : IO Unit :=
  IO.println s!"pub(crate) const {rustPrefix}_{name}_OFFSET: usize = {fieldOffset layout field};"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitGeneralControllerAbiRust.lean; do not edit."
  IO.println s!"pub(crate) const ABI_VERSION: u16 = {abiVersion};"
  IO.println s!"pub(crate) const MAX_OUTCOMES: usize = {maxOutcomes};"
  IO.println s!"pub(crate) const MAX_EXECUTIONS_PER_PAGE: usize = {maxExecutionsPerPage};"
  IO.println s!"pub(crate) const MAX_PAGES_PER_CANDIDATE: u32 = {maxPagesPerCandidate};"
  IO.println s!"pub(crate) const MAX_SELECTION_CRITERIA: usize = {maxSelectionCriteria};"
  IO.println s!"pub(crate) const CANDIDATE_BYTES: usize = {candidateBytes};"
  IO.println s!"pub(crate) const EXECUTION_BYTES: usize = {executionBytes};"
  IO.println s!"pub(crate) const PAGE_BYTES: usize = {pageBytes};"
  IO.println s!"pub(crate) const POLICY_BYTES: usize = {policyBytes};"
  IO.println s!"pub(crate) const SELECTION_BYTES: usize = {selectionBytes};"
  IO.println s!"pub(crate) const SETTLEMENT_BYTES: usize = {settlementBytes};"
  IO.println s!"pub(crate) const REQUEST_BYTES: usize = {requestBytes};"
  emitRustBytes "pub(crate)" "CANDIDATE_MAGIC" candidateMagic
  emitRustBytes "pub(crate)" "PAGE_MAGIC" pageMagic
  emitRustBytes "pub(crate)" "POLICY_MAGIC" policyMagic
  emitRustBytes "pub(crate)" "SELECTION_MAGIC" selectionMagic
  emitRustBytes "pub(crate)" "SETTLEMENT_MAGIC" settlementMagic
  emitRustBytes "pub(crate)" "REQUEST_MAGIC" requestMagic
  for (name, field) in [
      ("VERSION", CandidateField.version), ("OUTCOME_COUNT", .outcomeCount),
      ("RESERVED_A", .reservedA), ("CANDIDATE_ID", .candidateId),
      ("PRODUCT_ID", .productId), ("BATCH_ID", .batchId),
      ("PAGE_COUNT", .pageCount), ("RESERVED_B", .reservedB),
      ("PRICE_SCALE", .priceScale), ("PRICES", .prices)] do
    emitOffset "CANDIDATE" name candidateLayout field
  for (name, field) in [
      ("ORDER_ID", ExecutionField.orderId), ("OWNER_ID", .ownerId),
      ("NONCE", .nonce), ("MAX_LOTS", .maxLots),
      ("MAX_QUOTE_DEBIT_PER_LOT", .maxQuoteDebitPerLot), ("LOTS", .lots),
      ("QUOTE_DEBIT", .quoteDebit), ("QUOTE_CREDIT", .quoteCredit),
      ("RECEIVE_PER_LOT", .receivePerLot), ("DELIVER_PER_LOT", .deliverPerLot)] do
    emitOffset "EXECUTION" name executionLayout field
  for (name, field) in [
      ("VERSION", PageField.version), ("OUTCOME_COUNT", .outcomeCount),
      ("EXECUTION_COUNT", .executionCount), ("RESERVED_A", .reservedA),
      ("CANDIDATE_ID", .candidateId), ("PAGE_INDEX", .pageIndex),
      ("PAGE_COUNT", .pageCount), ("RESERVED_B", .reservedB),
      ("EXECUTIONS", .executions)] do
    emitOffset "PAGE" name pageLayout field
  for (name, field) in [
      ("VERSION", PolicyField.version), ("CRITERION_COUNT", .criterionCount),
      ("RESERVED", .reserved), ("POLICY_ID", .policyId), ("CRITERIA", .criteria)] do
    emitOffset "POLICY" name policyLayout field
  for (name, field) in [
      ("VERSION", SelectionField.version), ("CLOSED", .closed),
      ("HAS_BEST", .hasBest), ("RESERVED_A", .reservedA),
      ("BATCH_ID", .batchId), ("POLICY_ID", .policyId),
      ("BEST_CANDIDATE_ID", .bestCandidateId),
      ("REVISION", .revision), ("RESERVED_B", .reservedB)] do
    emitOffset "SELECTION" name selectionLayout field
  for (name, field) in [
      ("VERSION", SettlementField.version), ("PHASE", .phase),
      ("OUTCOME_COUNT", .outcomeCount), ("NEXT_EXECUTION", .nextExecution),
      ("RESERVED", .reserved),
      ("CANDIDATE_ID", .candidateId), ("PAGE_COUNT", .pageCount),
      ("NEXT_PAGE", .nextPage), ("REVISION", .revision),
      ("CLAIM_INVENTORY", .claimInventory), ("QUOTE_INVENTORY", .quoteInventory),
      ("QUOTE_SURPLUS_PAID", .quoteSurplusPaid)] do
    emitOffset "SETTLEMENT" name settlementLayout field
  for (name, field) in [
      ("VERSION", RequestField.version), ("ACTION", .action),
      ("RESERVED_A", .reservedA), ("EXPECTED_REVISION", .expectedRevision),
      ("CANDIDATE_ID", .candidateId), ("PAGE_INDEX", .pageIndex),
      ("EXECUTION_INDEX", .executionIndex), ("RESERVED_B", .reservedB)] do
    emitOffset "REQUEST" name requestLayout field
  IO.println "pub(crate) const ACTION_CONSIDER: u8 = 0;"
  IO.println "pub(crate) const ACTION_FREEZE: u8 = 1;"
  IO.println "pub(crate) const ACTION_INITIALIZE_SETTLEMENT: u8 = 2;"
  IO.println "pub(crate) const ACTION_COLLECT: u8 = 3;"
  IO.println "pub(crate) const ACTION_MATERIALIZE: u8 = 4;"
  IO.println "pub(crate) const ACTION_DISTRIBUTE: u8 = 5;"
  IO.println "pub(crate) const ACTION_CLOSE: u8 = 6;"
  IO.println "pub(crate) const PHASE_COLLECTING: u8 = 0;"
  IO.println "pub(crate) const PHASE_MATERIALIZING: u8 = 1;"
  IO.println "pub(crate) const PHASE_DISTRIBUTING: u8 = 2;"
  IO.println "pub(crate) const PHASE_READY_TO_CLOSE: u8 = 3;"
  IO.println "pub(crate) const PHASE_TERMINAL: u8 = 4;"
  IO.println "pub(crate) const CRITERION_MAXIMIZE_FILLED_LOTS: u8 = 0;"
  IO.println "pub(crate) const CRITERION_MINIMIZE_QUOTE_SURPLUS: u8 = 1;"
  IO.println "pub(crate) const CRITERION_MINIMIZE_CANDIDATE_ID: u8 = 2;"
  IO.println ""
  IO.println "#[cfg(test)]"
  emitRustBytes "pub(crate)" "CANDIDATE_EXAMPLE" (encodeCandidate exampleCandidate)
  IO.println "#[cfg(test)]"
  emitRustBytes "pub(crate)" "EXECUTION_EXAMPLE" (encodeExecution exampleExecution)
  IO.println "#[cfg(test)]"
  emitRustBytes "pub(crate)" "PAGE_EXAMPLE" (encodePage examplePage)
  IO.println "#[cfg(test)]"
  emitRustBytes "pub(crate)" "POLICY_EXAMPLE" (encodePolicy examplePolicy)
  IO.println "#[cfg(test)]"
  emitRustBytes "pub(crate)" "SELECTION_EXAMPLE" (encodeSelection exampleSelection)
  IO.println "#[cfg(test)]"
  emitRustBytes "pub(crate)" "SETTLEMENT_EXAMPLE" (encodeSettlement exampleSettlement)
  IO.println "#[cfg(test)]"
  emitRustBytes "pub(crate)" "REQUEST_EXAMPLE" (encodeRequest exampleRequest)
