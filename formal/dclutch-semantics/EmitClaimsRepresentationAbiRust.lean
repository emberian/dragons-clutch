import DClutchSemantics.ClaimsRepresentationAbi

open DClutch
open DClutch.ClaimsRepresentationAbi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (name : String) (bytes : List UInt8) : IO Unit := do
  IO.println s!"pub const {name}: [u8; {bytes.length}] = ["
  for line in List.range ((bytes.length + 15) / 16) do
    let chunk := (bytes.drop (line * 16)).take 16
    IO.println s!"    {String.intercalate ", " (chunk.map rustByte)},"
  IO.println "];"

def lotEffectRust : LotEffect → String
  | .add => "LotEffect::Add"
  | .subtract => "LotEffect::Subtract"
  | .retire => "LotEffect::Retire"

def economicStyleRust : EconomicStyle → String
  | .materialize => "EconomicStyle::Materialize"
  | .dematerialize => "EconomicStyle::Dematerialize"
  | .terminal => "EconomicStyle::Terminal"
  | .none => "EconomicStyle::None"

def adapterStyleRust : AdapterStyle → String
  | .mint => "AdapterStyle::Mint"
  | .burn => "AdapterStyle::Burn"
  | .retire => "AdapterStyle::Retire"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitClaimsRepresentationAbiRust.lean; do not edit."
  IO.println s!"pub const ABI_VERSION: u16 = {version};"
  IO.println s!"pub const DESCRIPTOR_HEADER_BYTES: usize = {descriptorHeaderBytes};"
  IO.println s!"pub const CLAIM_ATOM_BYTES: usize = {claimAtomBytes};"
  IO.println s!"pub const ACTION_BYTES: usize = {actionBytes};"
  IO.println s!"pub const STATE_BYTES: usize = {stateBytes};"
  emitBytes "DESCRIPTOR_MAGIC" descriptorMagic
  emitBytes "ACTION_MAGIC" actionMagic
  emitBytes "STATE_MAGIC" stateMagic
  for field in DescriptorField.all do
    IO.println s!"pub const {DescriptorField.rustName field}: usize = {DescriptorField.offset field};"
  for field in ActionField.all do
    IO.println s!"pub const {ActionField.rustName field}: usize = {ActionField.offset field};"
  for field in StateField.all do
    IO.println s!"pub const {StateField.rustName field}: usize = {StateField.offset field};"
  IO.println s!"pub const PHASE_OPEN: u8 = {phaseOpen};"
  IO.println s!"pub const PHASE_TERMINAL: u8 = {phaseTerminal};"
  IO.println s!"pub const PHASE_RETIRING: u8 = {phaseRetiring};"
  IO.println s!"pub const PHASE_RETIRED: u8 = {phaseRetired};"
  IO.println s!"pub const ACTION_RULES: [ActionRule; {rules.length}] = ["
  for rule in rules do
    IO.println "    ActionRule {"
    IO.println s!"        tag: {rule.action.tag},"
    IO.println s!"        allowed_phases: {rule.allowedPhases},"
    IO.println s!"        lot_effect: {lotEffectRust rule.lotEffect},"
    IO.println s!"        requires_positive_lots: {if rule.requiresPositiveLots then "true" else "false"},"
    IO.println s!"        economic_style: {economicStyleRust rule.economicStyle},"
    IO.println s!"        adapter_style: {adapterStyleRust rule.adapterStyle},"
    IO.println "    },"
  IO.println "];"
  IO.println "#[cfg(test)]"
  emitBytes "EXAMPLE_DESCRIPTOR" (encodeDescriptorV1 Examples.fractionalDescriptor)
  IO.println "#[cfg(test)]"
  emitBytes "EXAMPLE_ISSUE_ACTION" (encodeActionV1 Examples.issue)
  IO.println "#[cfg(test)]"
  emitBytes "EXAMPLE_EMPTY_STATE" (encodeStateV1 Examples.emptyState)
