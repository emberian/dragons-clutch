import DClutchSemantics.EffectProgramV4Abi

/-! Emit only Lean-owned DCE5 constants and witness/refusal bytes. -/

open DClutch
open DClutch.EffectProgramV4Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (name : String) (value : List UInt8) : IO Unit :=
  IO.println s!"pub const {name}: [u8; {value.length}] = [{String.intercalate ", " (value.map rustByte)}];"

def emitSlice (name : String) (value : List UInt8) : IO Unit :=
  IO.println s!"pub const {name}: &[u8] = &[{String.intercalate ", " (value.map rustByte)}];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitEffectProgramV4AbiRust.lean; do not edit."
  emitBytes "EFFECT_V4_MAGIC_LEAN" magic
  IO.println s!"pub const EFFECT_V4_VERSION_LEAN: u8 = {version};"
  IO.println s!"pub const EFFECT_V4_DISJOINT_EXACT_COVERAGE_POLICY_LEAN: u8 = {disjointExactCoveragePolicy};"
  IO.println s!"pub const EFFECT_V4_IDENTICAL_REUSE_EXACT_COVERAGE_POLICY_LEAN: u8 = {identicalReuseExactCoveragePolicy};"
  IO.println s!"pub const EFFECT_V4_SEMANTIC_RANGE_ROUTE_LEAN: u16 = {semanticRangeRoute};"
  IO.println s!"pub const EFFECT_V4_FIXED_COORDINATE_KIND_LEAN: u8 = {fixedCoordinateKind};"
  IO.println s!"pub const EFFECT_V4_COMMON_SCALAR_COORDINATE_KIND_LEAN: u8 = {commonScalarCoordinateKind};"
  IO.println s!"pub const EFFECT_V4_PRODUCT_TAIL_AFFINE_COORDINATE_KIND_LEAN: u8 = {productTailAffineCoordinateKind};"
  IO.println s!"pub const EFFECT_V4_MAX_EXTENSION_LEAN: u16 = {maxExtension};"
  IO.println s!"pub const EFFECT_V4_HEADER_BYTES_LEAN: usize = {headerBytes};"
  IO.println s!"pub const EFFECT_V4_DYNAMIC_SPAN_BYTES_LEAN: usize = {dynamicSpanBytes};"
  IO.println s!"pub const EFFECT_V4_BORROWED_RANGE_BYTES_LEAN: usize = {borrowedRangeBytes};"
  emitSlice "EFFECT_V4_SCHEMA_RELEASE_PREIMAGE_LEAN" schemaReleasePreimage
  emitBytes "EFFECT_V4_SCHEMA_RELEASE_ID_LEAN" schemaReleaseId
  for field in headerLayout do
    IO.println s!"pub const {HeaderField.rustName field.spec.name}: usize = {field.offset};"
  for field in dynamicSpanLayout do
    IO.println s!"pub const {DynamicSpanField.rustName field.spec.name}: usize = {field.offset};"
  for field in borrowedRangeLayout do
    IO.println s!"pub const {BorrowedRangeField.rustName field.spec.name}: usize = {field.offset};"
  emitBytes "EFFECT_V4_ZERO_TABLE_HEADER_WITNESS" zeroTableHeaderWitness
  emitBytes "EFFECT_V4_DEALER_HEADER_WITNESS" dealerHeaderWitness
  emitBytes "EFFECT_V4_DEALER_RANGE_TABLE_WITNESS" dealerRangeTableWitness
  emitBytes "EFFECT_V4_ZERO_SPAN_COUNT_REFUSAL" hostileZeroSpanCount
  emitBytes "EFFECT_V4_HEADER_RESERVED_REFUSAL" hostileHeaderReserved
  emitBytes "EFFECT_V4_AFFINE_ZERO_STRIDE_REFUSAL" hostileAffineZeroStride
  emitBytes "EFFECT_V4_REVERSED_RANGES_REFUSAL" hostileReversedRanges
  emitBytes "EFFECT_V4_CHILD_OVERLAP_REFUSAL" hostileChildOverlap
  emitBytes "EFFECT_V4_CHILD_GAP_REFUSAL" hostileChildGap
