  emitOffset "SERIES_TEMPLATE_OCCURRENCE_DERIVATION_OFFSET_V2" TemplateOffset.occurrenceDerivation
  emitOffset "SERIES_TEMPLATE_CAPABILITY_DERIVATION_OFFSET_V2" TemplateOffset.capabilityDerivation
  emitOffset "SERIES_TEMPLATE_FUNDING_DERIVATION_OFFSET_V2" TemplateOffset.fundingDerivation
  emitOffset "SERIES_TEMPLATE_PROJECTION_ROOT_OFFSET_V2" TemplateOffset.projectionRoot
  emitOffset "SERIES_TEMPLATE_REFUND_OWNER_OFFSET_V2" TemplateOffset.refundOwner
  emitOffset "SERIES_OCCURRENCE_INDEX_OFFSET_V2" OccurrenceOffset.occurrence
  emitOffset "SERIES_OCCURRENCE_SCHEDULED_SLOT_OFFSET_V2" OccurrenceOffset.scheduledSlot
