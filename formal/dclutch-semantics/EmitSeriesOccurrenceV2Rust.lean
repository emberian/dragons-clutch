  IO.println s!"pub const SERIES_EXAMPLE_TEMPLATE_V2: [u8; SERIES_TEMPLATE_BYTES_V2] = {rustBytes (encodeTemplate exampleTemplate)};"
  IO.println s!"pub const SERIES_EXAMPLE_OCCURRENCE_V2: [u8; SERIES_OCCURRENCE_BYTES_V2] = {rustBytes (encodeOccurrence exampleOccurrence)};"
