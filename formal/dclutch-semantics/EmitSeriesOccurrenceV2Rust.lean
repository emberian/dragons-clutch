import DClutchSemantics.SeriesOccurrenceV2Abi

/-!
Emit only the fixed Series V2 record constants and one exact semantic agreement
corpus.  The Rust adapter owns hostile byte decoding and SHA-256/Merkle
physicalization; it does not own a second schedule or occurrence ontology.
-/

open DClutch
open DClutch.SeriesOccurrenceV2
open DClutch.SeriesOccurrenceV2.Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def rustBytes (bytes : List UInt8) : String :=
  s!"[{String.intercalate ", " (bytes.map rustByte)}]"

def emitOffset (name : String) (value : Nat) : IO Unit :=
  IO.println s!"pub const {name}: usize = {value};"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitSeriesOccurrenceV2Rust.lean; do not edit."
  IO.println s!"pub const SERIES_TEMPLATE_SCHEMA_V2: u16 = {schemaVersion};"
  IO.println s!"pub const SERIES_TEMPLATE_PROFILE_V2: u16 = {profile};"
  IO.println s!"pub const SERIES_TEMPLATE_BYTES_V2: usize = {templateBytes};"
  IO.println s!"pub const SERIES_OCCURRENCE_BYTES_V2: usize = {occurrenceBytes};"
  IO.println s!"pub const SERIES_TICKET_BYTES_V2: usize = {ticketBytes};"
  IO.println s!"pub const SERIES_MAXIMUM_MERKLE_HEIGHT_V2: usize = {maximumMerkleHeight};"
  IO.println s!"pub const SERIES_TEMPLATE_MAGIC_V2: [u8; 8] = {rustBytes templateMagic};"
  IO.println s!"pub const SERIES_OCCURRENCE_MAGIC_V2: [u8; 8] = {rustBytes occurrenceMagic};"
  IO.println s!"pub const SERIES_TICKET_MAGIC_V2: [u8; 8] = {rustBytes ticketMagic};"
  IO.println s!"pub const SERIES_TEMPLATE_CONTENT_DOMAIN_V2: [u8; {templateContentDomain.length}] = {rustBytes templateContentDomain};"
  IO.println s!"pub const SERIES_OCCURRENCE_CONTENT_DOMAIN_V2: [u8; {occurrenceContentDomain.length}] = {rustBytes occurrenceContentDomain};"
  IO.println s!"pub const SERIES_PROJECTION_NODE_DOMAIN_V2: [u8; {projectionNodeDomain.length}] = {rustBytes projectionNodeDomain};"
  IO.println s!"pub const SERIES_FUNDING_LIST_DOMAIN_V2: [u8; {fundingListDomain.length}] = {rustBytes fundingListDomain};"
  emitOffset "SERIES_TEMPLATE_OCCURRENCE_COUNT_OFFSET_V2" TemplateOffset.occurrenceCount
  emitOffset "SERIES_TEMPLATE_FIRST_SLOT_OFFSET_V2" TemplateOffset.firstSlot
  emitOffset "SERIES_TEMPLATE_PERIOD_SLOTS_OFFSET_V2" TemplateOffset.periodSlots
  emitOffset "SERIES_TEMPLATE_RETRY_WINDOW_OFFSET_V2" TemplateOffset.retryWindow
  emitOffset "SERIES_TEMPLATE_CLOSE_RENT_OFFSET_V2" TemplateOffset.closeRent
  emitOffset "SERIES_TEMPLATE_REALM_OFFSET_V2" TemplateOffset.realm
  emitOffset "SERIES_TEMPLATE_RELEASE_SET_OFFSET_V2" TemplateOffset.releaseSet
  emitOffset "SERIES_TEMPLATE_PRODUCT_GENERATOR_OFFSET_V2" TemplateOffset.productGenerator
  emitOffset "SERIES_TEMPLATE_OCCURRENCE_GENERATOR_OFFSET_V2" TemplateOffset.occurrenceGenerator
