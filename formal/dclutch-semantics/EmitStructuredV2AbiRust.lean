import DClutchSemantics.StructuredV2Abi

/-! Emit only the Lean-owned Structured V2 physical layout constants. -/

open DClutch
open DClutch.AbiSchema
open DClutch.StructuredV2Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (name : String) (value : List UInt8) : IO Unit :=
  IO.println s!"pub const {name}: [u8; {value.length}] = [{String.intercalate ", " (value.map rustByte)}];"

def emitSlice (name : String) (value : List UInt8) : IO Unit :=
  IO.println s!"pub const {name}: &[u8] = &[{String.intercalate ", " (value.map rustByte)}];"

def emitOffset (name : String) (offset : Nat) : IO Unit :=
  IO.println s!"pub const {name}: usize = {offset};"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitStructuredV2AbiRust.lean; do not edit."
  IO.println s!"pub const STRUCTURED_SCHEMA_VERSION_V2: u16 = {schemaVersion};"
  IO.println s!"pub const STRUCTURED_RECEIPT_DECIMALS_V2: u8 = {receiptDecimals};"
  IO.println s!"pub const STRUCTURED_MIN_COORDINATES_V2: u32 = {minCoordinates};"
  IO.println s!"pub const STRUCTURED_MAX_COORDINATES_V2: u32 = {maxCoordinates};"
  IO.println s!"pub const STRUCTURED_MIN_DENOMINATOR_V2: u64 = {minDenominator};"
  IO.println s!"pub const STRUCTURED_NO_COORDINATE_V2: u32 = {noCoordinate};"
  emitBytes "STRUCTURED_TERMS_MAGIC_V2" termsMagic
  emitBytes "STRUCTURED_ROOT_MAGIC_V2" rootMagic
  emitBytes "STRUCTURED_PROJECTION_MAGIC_V2" projectionMagic
  emitBytes "STRUCTURED_REQUEST_MAGIC_V2" requestMagic
  emitSlice "STRUCTURED_TERMS_SCHEMA_PREIMAGE_V2" termsSchemaPreimage
  emitBytes "STRUCTURED_TERMS_SCHEMA_ID_V2" termsSchemaId
  emitSlice "STRUCTURED_ROOT_SCHEMA_PREIMAGE_V2" rootSchemaPreimage
  emitBytes "STRUCTURED_ROOT_SCHEMA_ID_V2" rootSchemaId
  emitSlice "STRUCTURED_REQUEST_SCHEMA_PREIMAGE_V2" requestSchemaPreimage
  emitBytes "STRUCTURED_REQUEST_SCHEMA_ID_V2" requestSchemaId
  emitSlice "STRUCTURED_CAPABILITY_KIND_PREIMAGE_V2" capabilityKindPreimage
  emitBytes "STRUCTURED_CAPABILITY_KIND_ID_V2" capabilityKindId
  emitSlice "STRUCTURED_CAPACITY_PROFILE_PREIMAGE_V2" capacityProfilePreimage
  emitBytes "STRUCTURED_CAPACITY_PROFILE_ID_V2" capacityProfileId
  emitOffset "STRUCTURED_TERMS_HEADER_BYTES_V2" termsHeaderBytes
  emitOffset "STRUCTURED_TERMS_COEFFICIENT_BYTES_V2" termsCoefficientBytes
  emitOffset "STRUCTURED_ROOT_BYTES_V2" rootBytes
  emitOffset "STRUCTURED_PROJECTION_HEADER_BYTES_V2" projectionHeaderBytes
  emitOffset "STRUCTURED_PROJECTION_ROW_BYTES_V2" projectionRowBytes
  emitOffset "STRUCTURED_REQUEST_BYTES_V2" requestBytes
  for field in termsLayout do
    emitOffset (TermsField.rustName field.spec.name) field.offset
  for field in rootLayout do
    emitOffset (RootField.rustName field.spec.name) field.offset
  for field in projectionLayout do
    emitOffset (ProjectionField.rustName field.spec.name) field.offset
  for field in projectionRowLayout do
    emitOffset (ProjectionRowField.rustName field.spec.name) field.offset
  for field in requestLayout do
    emitOffset (RequestField.rustName field.spec.name) field.offset
  for action in actions do
    IO.println s!"pub const {Action.rustName action}: u8 = {Action.tag action};"
  IO.println s!"pub const STRUCTURED_PHASE_OPEN_V2: u8 = {phaseTag .open};"
  IO.println s!"pub const STRUCTURED_PHASE_TERMINAL_V2: u8 = {phaseTag (.terminal [])};"
  IO.println s!"pub const STRUCTURED_PHASE_RETIRED_V2: u8 = {phaseTag .retired};"
