import DClutchSemantics.SbfProfile

open DClutch.SbfProfile

def rustConstant (name ty : String) (value : Nat) : String :=
  s!"pub(crate) const {name}: {ty} = {value};"

def main : IO Unit :=
  IO.println <| String.intercalate "\n" [
    "// @generated by formal/dclutch-semantics/EmitSbfProfile.lean; do not edit.",
    rustConstant "ACCOUNT_COUNT_OFFSET" "usize" accountCountOffset,
    rustConstant "AUTHORITY_OFFSET" "usize" authorityOffset,
    rustConstant "PROJECTION_OFFSET" "usize" projectionOffset,
    rustConstant "PROJECTION_DATA_OFFSET" "usize" projectionDataOffset,
    rustConstant "INSTRUCTION_LENGTH_OFFSET" "usize" instructionLengthOffset,
    rustConstant "INSTRUCTION_OFFSET" "usize" instructionOffset,
    rustConstant "PROGRAM_ID_OFFSET" "usize" programIdOffset,
    rustConstant "AUTHORITY_FRAME_WORD" "u64" (accountFrameWord authorityRole),
    rustConstant "PROJECTION_FRAME_WORD" "u64" (accountFrameWord projectionRole),
    rustConstant "PROJECTION_DATA_BYTES" "u64" projectionRole.dataBytes,
    rustConstant "INSTRUCTION_BYTES" "u64" instructionBytes,
    rustConstant "STATE_MAGIC_WORD" "u64" stateMagicWord,
    rustConstant "PLAN_HEADER_WORD" "u64" (planWord 0),
    rustConstant "EFFECT_0_TAG" "u64" (effectTag 0),
    rustConstant "EFFECT_1_TAG" "u64" (effectTag 1),
    rustConstant "EFFECT_2_TAG" "u64" (effectTag 2),
    rustConstant "EFFECT_3_TAG" "u64" (effectTag 3),
    rustConstant "EFFECT_4_TAG" "u64" (effectTag 4),
    rustConstant "EFFECT_5_TAG" "u64" (effectTag 5),
    rustConstant "EFFECT_6_TAG" "u64" (effectTag 6)
  ]
