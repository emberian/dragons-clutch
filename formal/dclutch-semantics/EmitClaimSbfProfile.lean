import DClutchSemantics.ClaimSbfProfile

open DClutch.ClaimSbfProfile
open DClutch.SbfProfile (accountFrameWord authorityRole)

def rustConstant (name ty : String) (value : Nat) : String :=
  s!"pub(crate) const {name}: {ty} = {value};"

def main : IO Unit :=
  IO.println <| String.intercalate "\n" [
    "// @generated by formal/dclutch-semantics/EmitClaimSbfProfile.lean; do not edit.",
    rustConstant "ACCOUNT_COUNT_OFFSET" "usize" accountCountOffset,
    rustConstant "AUTHORITY_OFFSET" "usize" authorityOffset,
    rustConstant "SELLER_REPLAY_OFFSET" "usize" sellerReplayOffset,
    rustConstant "BUYER_REPLAY_OFFSET" "usize" buyerReplayOffset,
    rustConstant "SELLER_POSITION_OFFSET" "usize" sellerPositionOffset,
    rustConstant "BUYER_POSITION_OFFSET" "usize" buyerPositionOffset,
    rustConstant "SELLER_REPLAY_DATA_OFFSET" "usize" sellerReplayDataOffset,
    rustConstant "BUYER_REPLAY_DATA_OFFSET" "usize" buyerReplayDataOffset,
    rustConstant "SELLER_POSITION_DATA_OFFSET" "usize" sellerPositionDataOffset,
    rustConstant "BUYER_POSITION_DATA_OFFSET" "usize" buyerPositionDataOffset,
    rustConstant "INSTRUCTION_LENGTH_OFFSET" "usize" instructionLengthOffset,
    rustConstant "INSTRUCTION_OFFSET" "usize" instructionOffset,
    rustConstant "PROGRAM_ID_OFFSET" "usize" programIdOffset,
    rustConstant "AUTHORITY_FRAME_WORD" "u64" (accountFrameWord authorityRole),
    rustConstant "REPLAY_FRAME_WORD" "u64" (accountFrameWord replayRole),
    rustConstant "POSITION_FRAME_WORD" "u64" (accountFrameWord positionRole),
    rustConstant "REPLAY_DATA_BYTES" "u64" replayRole.dataBytes,
    rustConstant "POSITION_DATA_BYTES" "u64" positionRole.dataBytes,
    rustConstant "INSTRUCTION_BYTES" "u64" instructionBytes,
    rustConstant "REPLAY_MAGIC_WORD" "u64" replayMagicWord,
    rustConstant "POSITION_MAGIC_WORD" "u64" positionMagicWord,
    rustConstant "PLAN_HEADER_WORD" "u64" (planWord 0),
    rustConstant "EFFECT_0_TAG" "u64" (effectTag 0),
    rustConstant "EFFECT_1_TAG" "u64" (effectTag 1),
    rustConstant "EFFECT_2_TAG" "u64" (effectTag 2),
    rustConstant "EFFECT_3_TAG" "u64" (effectTag 3)
  ]
