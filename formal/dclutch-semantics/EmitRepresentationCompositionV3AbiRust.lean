import DClutchSemantics.RepresentationCompositionV3Abi

/-! Emit only Lean-owned composition V3 constants and witness/refusal bytes. -/

open DClutch
open DClutch.RepresentationCompositionV3Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (name : String) (value : List UInt8) : IO Unit :=
  IO.println s!"pub const {name}: [u8; {value.length}] = [{String.intercalate ", " (value.map rustByte)}];"

def emitSlice (name : String) (value : List UInt8) : IO Unit :=
  IO.println s!"pub const {name}: &[u8] = &[{String.intercalate ", " (value.map rustByte)}];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitRepresentationCompositionV3AbiRust.lean; do not edit."
  IO.println s!"pub const COMPOSITION_SCHEMA_VERSION_LEAN_V3: u16 = {schemaVersion};"
  IO.println s!"pub const COMPOSITION_MIN_OUTCOMES_LEAN_V3: u32 = {minOutcomes};"
  IO.println s!"pub const COMPOSITION_MAX_OUTCOMES_LEAN_V3: u32 = {maxOutcomes};"
  IO.println s!"pub const COMPOSITION_MAX_NODES_LEAN_V3: u32 = {maxNodes};"
  IO.println s!"pub const COMPOSITION_MAX_EDGES_LEAN_V3: u32 = {maxEdges};"
  IO.println s!"pub const COMPOSITION_MAX_TERMS_LEAN_V3: u32 = {maxTerms};"
  IO.println s!"pub const COMPOSITION_DESCRIPTOR_BYTES_LEAN_V3: usize = {descriptorBytes};"
  IO.println s!"pub const COMPOSITION_GRAPH_HEADER_BYTES_LEAN_V3: usize = {graphHeaderBytes};"
  IO.println s!"pub const COMPOSITION_NODE_BYTES_LEAN_V3: usize = {nodeBytes};"
  IO.println s!"pub const COMPOSITION_EDGE_BYTES_LEAN_V3: usize = {edgeBytes};"
  IO.println s!"pub const COMPOSITION_TERM_BYTES_LEAN_V3: usize = {termBytes};"
  IO.println s!"pub const COMPOSITION_TRANSLATION_HEADER_BYTES_LEAN_V3: usize = {translationHeaderBytes};"
  emitSlice "COMPOSITION_CAPACITY_PROFILE_PREIMAGE_LEAN_V3" capacityProfilePreimage
  emitBytes "COMPOSITION_CAPACITY_PROFILE_ID_LEAN_V3" capacityProfileId
  emitSlice "COMPOSITION_DESCRIPTOR_SCHEMA_PREIMAGE_LEAN_V3" descriptorSchemaPreimage
  emitBytes "COMPOSITION_DESCRIPTOR_SCHEMA_ID_LEAN_V3" descriptorSchemaId
  emitSlice "COMPOSITION_GRAPH_SCHEMA_PREIMAGE_LEAN_V3" graphSchemaPreimage
  emitBytes "COMPOSITION_GRAPH_SCHEMA_ID_LEAN_V3" graphSchemaId
  emitSlice "COMPOSITION_TRANSLATION_SCHEMA_PREIMAGE_LEAN_V3" translationSchemaPreimage
  emitBytes "COMPOSITION_TRANSLATION_SCHEMA_ID_LEAN_V3" translationSchemaId
  emitBytes "COMPOSITION_DESCRIPTOR_MAGIC_LEAN_V3" descriptorMagic
  emitBytes "COMPOSITION_GRAPH_MAGIC_LEAN_V3" graphMagic
  emitBytes "COMPOSITION_TRANSLATION_MAGIC_LEAN_V3" translationMagic
  for field in descriptorLayout do
    IO.println s!"pub const {DescriptorField.rustName field.spec.name}: usize = {field.offset};"
  for field in graphHeaderLayout do
    IO.println s!"pub const {GraphHeaderField.rustName field.spec.name}: usize = {field.offset};"
  for field in nodeLayout do
    IO.println s!"pub const {NodeField.rustName field.spec.name}: usize = {field.offset};"
  for field in edgeLayout do
    IO.println s!"pub const {EdgeField.rustName field.spec.name}: usize = {field.offset};"
  for field in termLayout do
    IO.println s!"pub const {TermField.rustName field.spec.name}: usize = {field.offset};"
  for field in translationHeaderLayout do
    IO.println s!"pub const {TranslationHeaderField.rustName field.spec.name}: usize = {field.offset};"
  emitBytes "COMPOSITION_DESCRIPTOR_WITNESS_LEAN_V3" encodeDescriptorWitness
  emitBytes "COMPOSITION_GRAPH_WITNESS_LEAN_V3" encodeGraphWitness
  emitBytes "COMPOSITION_TRANSLATION_WITNESS_LEAN_V3" encodeTranslationWitness
  emitBytes "COMPOSITION_DESCRIPTOR_RESERVED_REFUSAL_LEAN_V3" hostileDescriptorReserved
  emitBytes "COMPOSITION_GRAPH_CYCLE_REFUSAL_LEAN_V3" hostileGraphCycle
  emitBytes "COMPOSITION_GRAPH_DUPLICATE_NODE_REFUSAL_LEAN_V3" hostileGraphDuplicateNode
  emitBytes "COMPOSITION_GRAPH_AMBIGUOUS_ROOT_REFUSAL_LEAN_V3" hostileGraphAmbiguousRoot
  emitBytes "COMPOSITION_TRANSLATION_MISMATCH_REFUSAL_LEAN_V3" hostileTranslationMismatch
  emitBytes "COMPOSITION_TRANSLATION_RESERVED_REFUSAL_LEAN_V3" hostileTranslationReserved
