import DClutchSemantics.DirectControllerCodec

open DClutch
open DClutch.DirectControllerCodec

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitByteArray (name : String) (bytes : List UInt8) : IO Unit := do
  IO.println s!"pub(crate) const {name}: [u8; {bytes.length}] = [{String.intercalate ", " (bytes.map rustByte)}];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitDirectCodecRust.lean; do not edit."
  IO.println s!"pub(crate) const ABI_VERSION: u16 = {version};"
  IO.println s!"pub(crate) const COMPACT_INTENT_BYTES_VALUE: usize = {compactIntentBytes};"
  IO.println s!"pub(crate) const CONTROLLER_INSTRUCTION_BYTES_VALUE: usize = {controllerInstructionBytes};"
  IO.println s!"pub(crate) const MAGIC_OFFSET: usize = {magicOffset};"
  IO.println s!"pub(crate) const VERSION_OFFSET: usize = {versionOffset};"
  emitByteArray "INTENT_MAGIC_BYTES" intentMagic
  emitByteArray "CONTROLLER_MAGIC_BYTES" controllerMagic
  for field in IntentField.all do
    IO.println s!"pub(crate) const {IntentField.rustName field}: usize = {IntentField.offset field};"
  IO.println s!"pub(crate) const INTENT_RESERVED_A_OFFSET: usize = {intentReservedAOffset};"
  IO.println s!"pub(crate) const INTENT_RESERVED_A_WIDTH: usize = {intentReservedAWidth};"
  IO.println s!"pub(crate) const INTENT_RESERVED_B_OFFSET: usize = {intentReservedBOffset};"
  IO.println s!"pub(crate) const INTENT_RESERVED_B_WIDTH: usize = {intentReservedBWidth};"
  for field in ControllerField.all do
    IO.println s!"pub(crate) const {ControllerField.rustName field}: usize = {ControllerField.offset field};"
  IO.println s!"pub(crate) const CONTROLLER_RESERVED_OFFSET: usize = {controllerReservedOffset};"
  IO.println s!"pub(crate) const CONTROLLER_RESERVED_WIDTH: usize = {controllerReservedWidth};"
