import DClutchSemantics.GeneralConfigAbi

open DClutch DClutch.General.ConfigAbi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitRustBytes (visibility name : String) (bytes : List UInt8) : IO Unit := do
  IO.println "#[rustfmt::skip]"
  IO.println s!"{visibility} const {name}: [u8; {bytes.length}] = ["
  for line in List.range ((bytes.length + 15) / 16) do
    let chunk := (bytes.drop (line * 16)).take 16
    IO.println s!"    {String.intercalate ", " (chunk.map rustByte)},"
  IO.println "];"

def emitOffset (name : String) (field : ConfigField) : IO Unit :=
  IO.println s!"pub(crate) const CONFIG_{name}_OFFSET: usize = {fieldOffset configLayout field};"

def emitRootOffset (name : String) (field : RootField) : IO Unit :=
  IO.println s!"pub(crate) const ROOT_{name}_OFFSET: usize = {fieldOffset rootLayout field};"

def emitActivationOffset (name : String) (field : ActivationField) : IO Unit :=
  IO.println s!"pub(crate) const ACTIVATION_{name}_OFFSET: usize = {fieldOffset activationLayout field};"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitGeneralConfigAbiRust.lean; do not edit."
  IO.println s!"pub(crate) const ABI_VERSION_V2: u16 = {abiVersion};"
  IO.println s!"pub(crate) const ARTIFACT_PROFILE_V2: u16 = {artifactProfile};"
  IO.println s!"pub(crate) const MAX_OUTCOMES_V2: usize = {maxOutcomes};"
  IO.println s!"pub(crate) const MAX_EXECUTIONS_PER_PAGE_V2: u32 = {maxExecutionsPerPage};"
  IO.println s!"pub(crate) const MAX_PAGES_PER_CANDIDATE_V2: u32 = {physicalMaxPagesPerCandidate};"
  IO.println s!"pub(crate) const GENERAL_CONFIG_BYTES_V2: usize = {configBytes};"
  emitRustBytes "pub(crate)" "GENERAL_CONFIG_MAGIC_V2" configMagic
  for (name, field) in [
      ("VERSION", ConfigField.version), ("ARTIFACT_PROFILE", .artifactProfile),
      ("OUTCOME_COUNT", .outcomeCount), ("RESERVED", .reserved),
      ("CAPACITY_PROFILE_ID", .capacityProfileId), ("CLAIM_BASIS_ID", .claimBasisId),
      ("CAPABILITY_PROGRAM_ID", .capabilityProgramId), ("GENERATION", .generation),
      ("PRICE_SCALE", .priceScale), ("COLLECTION_SLOTS", .collectionSlots),
      ("SELECTION_SLOTS", .selectionSlots), ("SETTLEMENT_SLOTS", .settlementSlots),
      ("MAX_ORDERS_PER_CANDIDATE", .maxOrdersPerCandidate),
      ("MAX_PAGES_PER_CANDIDATE", .maxPagesPerCandidate),
      ("CONTINUATION_REWARD_LAMPORTS", .continuationRewardLamports),
      ("SELECTION_POLICY_ID", .selectionPolicyId),
      ("QUOTE_SURPLUS_BENEFICIARY", .quoteSurplusBeneficiary)] do
    emitOffset name field
  IO.println ""
  IO.println "#[cfg(test)]"
  emitRustBytes "pub(crate)" "GENERAL_CONFIG_EXAMPLE_V2" (encodeConfig exampleConfig)
  IO.println s!"pub(crate) const GENERAL_ROOT_BYTES_V2: usize = {rootBytes};"
  emitRustBytes "pub(crate)" "GENERAL_ROOT_MAGIC_V2" rootMagic
  for (name, field) in [
      ("VERSION", RootField.version), ("LIFECYCLE", .lifecycle),
      ("RESERVED_HEADER", .reservedHeader), ("MARKET", .market),
      ("CONFIG_ID", .configId), ("GENERATION", .generation),
      ("REVISION", .revision), ("NEXT_BATCH_SEQUENCE", .nextBatchSequence),
      ("OPEN_BATCHES", .openBatches), ("RESERVED_TAIL", .reservedTail)] do
    emitRootOffset name field
  IO.println ""
  IO.println "#[cfg(test)]"
  emitRustBytes "pub(crate)" "GENERAL_ROOT_EXAMPLE_V2" (encodeRoot exampleRoot)
  IO.println s!"pub(crate) const GENERAL_ACTIVATION_REQUEST_BYTES_V2: usize = {activationBytes};"
  IO.println s!"pub(crate) const GENERAL_ACTIVATION_ACTION_V2: u8 = {activationAction};"
  emitRustBytes "pub(crate)" "GENERAL_ACTIVATION_MAGIC_V2" activationMagic
  for (name, field) in [
      ("VERSION", ActivationField.version), ("ACTION", .action),
      ("RESERVED_HEADER", .reservedHeader), ("CAPABILITY_ROOT", .capabilityRoot),
      ("CONFIG_ID", .configId), ("MANIFEST_ID", .manifestId),
      ("FUNDING_STATE", .fundingState), ("RENT_CREDIT", .rentCredit),
      ("ENTRY_INDEX", .entryIndex), ("RESERVED_ENTRY", .reservedEntry),
      ("CURRENT_SLOT", .currentSlot),
      ("EXACT_ROOT_RENT_LAMPORTS", .exactRootRentLamports),
      ("EXACT_FUNDING_RENT_LAMPORTS", .exactFundingRentLamports),
      ("ROOT_STATE_BYTES", .rootStateBytes), ("CONFIG_BYTES", .configBytes),
      ("FUNDING_BYTES", .fundingBytes), ("SELECTED_ENTRY_BYTES", .selectedEntryBytes),
      ("RESERVED_TAIL", .reservedTail)] do
    emitActivationOffset name field
  IO.println ""
  IO.println "#[cfg(test)]"
  emitRustBytes "pub(crate)" "GENERAL_ACTIVATION_EXAMPLE_V2"
    (encodeActivationRequest exampleActivationRequest)
