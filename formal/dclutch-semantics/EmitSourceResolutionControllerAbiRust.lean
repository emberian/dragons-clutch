    IO.println s!"pub(crate) const {FundedRequestField.rustName field}: usize = {FundedRequestField.offset field};"
  IO.println s!"pub(crate) const FUNDED_REQUEST_FAIL_NEXT_ACTION: u8 = {FundedAction.failNext.tag.toNat};"
