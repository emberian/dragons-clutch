import DClutchSemantics.SourceResolutionControllerAbi

open DClutch
open DClutch.SourceResolution
open DClutch.SourceResolution.Abi
open DClutch.SourceResolution.ControllerAbi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitRustBytes (visibility name : String) (bytes : List UInt8) : IO Unit := do
  IO.println s!"{visibility} const {name}: [u8; {bytes.length}] = ["
  for line in List.range ((bytes.length + 15) / 16) do
    let chunk := (bytes.drop (line * 16)).take 16
    IO.println s!"    {String.intercalate ", " (chunk.map rustByte)},"
  IO.println "];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitSourceResolutionControllerAbiRust.lean; do not edit."
  IO.println s!"pub(crate) const REQUEST_BYTES_VALUE: usize = {requestBytes};"
  IO.println s!"pub(crate) const REQUEST_ABI_VERSION: u16 = {requestVersion};"
  emitRustBytes "pub(crate)" "REQUEST_MAGIC_BYTES" requestMagic
  for field in RequestField.all do
    IO.println s!"pub(crate) const {RequestField.rustName field}: usize = {RequestField.offset field};"
  IO.println s!"pub(crate) const REQUEST_ACCEPT_PYTH_ACTION: u8 = {acceptPythAction.toNat};"
  IO.println s!"pub(crate) const PRIMARY_CERTIFICATE_SEQUENCE_VALUE: u64 = {primaryCertificateSequence exampleState};"
  IO.println ""
  IO.println s!"pub(crate) const FUNDED_REQUEST_BYTES_VALUE: usize = {fundedRequestBytes};"
