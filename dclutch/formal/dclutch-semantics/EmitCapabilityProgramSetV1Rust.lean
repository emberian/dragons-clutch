import DClutchSemantics.CapabilityProgramSetV1

/-! Emit the Lean-owned Capability Program Set V1 ABI and hostile corpus. -/

open DClutch
open DClutch.AbiSchema
open DClutch.CapabilityProgramSetV1

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (name : String) (bytes : List UInt8) : IO Unit := do
  IO.println s!"pub const {name}: [u8; {bytes.length}] = ["
  IO.println s!"    {String.intercalate ", " (bytes.map rustByte)},"
  IO.println "];"

def emitSlice (name : String) (bytes : List UInt8) : IO Unit := do
  IO.println s!"pub const {name}: &[u8] = &["
  IO.println s!"    {String.intercalate ", " (bytes.map rustByte)},"
  IO.println "];"

def emitHostileCorpus : IO Unit := do
  IO.println "#[cfg(test)]"
  IO.println s!"pub const CAPABILITY_PROGRAM_SET_HOSTILE_CORPUS_V1: [[u8; {canonicalExample.length}]; {hostileCorpus.length}] = ["
  for bytes in hostileCorpus do
    IO.println "    ["
    IO.println s!"        {String.intercalate ", " (bytes.map rustByte)},"
    IO.println "    ],"
  IO.println "];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitCapabilityProgramSetV1Rust.lean; do not edit."
  IO.println s!"pub const CAPABILITY_PROGRAM_SET_HEADER_BYTES_V1: usize = {headerBytes};"
  IO.println s!"pub const CAPABILITY_PROGRAM_SET_ENTRY_BYTES_V1: usize = {entryBytes};"
  IO.println s!"pub const CAPABILITY_PROGRAM_SET_MAX_BYTES_V1: usize = {maxBytes};"
  IO.println s!"pub const CAPABILITY_PROGRAM_SET_MAX_ENTRIES_V1: usize = {maxEntries};"
  IO.println s!"pub const CAPABILITY_PROGRAM_SET_SCHEMA_VERSION_V1: u16 = {schemaVersion};"
  IO.println s!"pub const CAPABILITY_PROGRAM_SET_ARTIFACT_PROFILE_V1: u16 = {artifactProfile};"
  IO.println s!"pub const CAPABILITY_PROGRAM_SET_CANONICAL_ENDIAN_V1: u8 = {canonicalEndian};"
  emitBytes "CAPABILITY_PROGRAM_SET_MAGIC_V1" magic
  emitSlice "CAPABILITY_PROGRAM_SET_SCHEMA_RELEASE_PREIMAGE_V1" schemaReleasePreimage
  emitBytes "CAPABILITY_PROGRAM_SET_SCHEMA_RELEASE_ID_V1" schemaReleaseId
  for field in headerLayout do
    IO.println s!"pub const {HeaderField.rustName field.spec.name}: usize = {field.offset};"
  for field in entryLayout do
    IO.println s!"pub const {EntryField.rustName field.spec.name}: usize = {field.offset};"
  IO.println "#[cfg(test)]"
  emitBytes "CAPABILITY_PROGRAM_SET_EXAMPLE_V1" canonicalExample
  emitHostileCorpus
