import DClutchSemantics.RationalRepresentationV2PhysicalAbi
import DClutchSemantics.Codec

open DClutch
open DClutch.RationalRepresentationV2PhysicalAbi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (name : String) (bytes : List UInt8) : IO Unit := do
  IO.println s!"pub const {name}: [u8; {bytes.length}] = [{String.intercalate ", " (bytes.map rustByte)}];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitRationalRepresentationV2PhysicalAbiRust.lean; do not edit."
  IO.println s!"pub const PHYSICAL_ABI_VERSION_V2: u16 = {version};"
  IO.println s!"pub const REQUEST_HEADER_BYTES_V2: usize = {requestHeaderBytes};"
  IO.println s!"pub const ASSET_BYTES_V2: usize = {assetBytes};"
  IO.println s!"pub const RECEIPT_BYTES_V2: usize = {receiptBytes};"
  emitBytes "REQUEST_MAGIC_V2" requestMagic
  emitBytes "RECEIPT_MAGIC_V2" receiptMagic
  for field in RequestField.all do
    IO.println s!"pub const {RequestField.rustName field}: usize = {RequestField.offset field};"
  for field in AssetField.all do
    IO.println s!"pub const {AssetField.rustName field}: usize = {AssetField.offset field};"
  for field in ReceiptField.all do
    IO.println s!"pub const {ReceiptField.rustName field}: usize = {ReceiptField.offset field};"
  IO.println s!"pub const ACTION_DENOMINATE: u8 = {Action.tag .denominate};"
  IO.println s!"pub const ACTION_RECONSTITUTE: u8 = {Action.tag .reconstitute};"
  IO.println s!"pub const ACTION_ISSUE_STRUCTURED: u8 = {Action.tag .issueStructured};"
  IO.println s!"pub const ACTION_UNWRAP_STRUCTURED: u8 = {Action.tag .unwrapStructured};"
  IO.println s!"pub const ACTION_REDEEM_TERMINAL: u8 = {Action.tag .redeemTerminal};"
  IO.println s!"pub const CALLER_ROLE_CORE: u8 = {CallerRole.tag .core};"
  IO.println s!"pub const CALLER_ROLE_TRADING: u8 = {CallerRole.tag .trading};"
