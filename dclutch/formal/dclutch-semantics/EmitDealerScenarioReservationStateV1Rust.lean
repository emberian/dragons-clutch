import DClutchSemantics.DealerScenarioReservationStateV1Abi
import DClutchSemantics.Codec

/-! Emit the Dealer scenario reservation state's layout and tag ABI as Rust.

The three `DealerScenarioReservationStateStatusV1` discriminants, the byte they
are persisted at, the record's magic and width, its two canonical-zero spans
and every coordinate in it.

The names carry `RESERVATION_STATE` on purpose.  Four records share one file
and one header shape there, through file-private `VERSION_OFFSET`,
`TAG_OFFSET`, `ORDINAL_OFFSET` and `COUNT_OFFSET` that two to four decoders
each read.  Only this record has a Lean owner, so what is emitted is this
record's coordinates under names that say whose they are; the shared constants
stay for the other three and are pinned to these by `const _: () = assert!`. -/

open DClutch
open DClutch.DealerScenarioReservationStateV1Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitConst (name kind value doc : String) : IO Unit := do
  IO.println s!"/// {doc}"
  IO.println s!"pub const {name}: {kind} = {value};"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitDealerScenarioReservationStateV1Rust.lean; do not edit."
  IO.println "/// Canonical reservation state magic: `DCLTDST1`."
  -- One line, with formatting suppressed, because the SDK's state-machine
  -- generator reads a record magic with a single-line regex.
  IO.println "#[rustfmt::skip]"
  IO.println s!"pub const DEALER_SCENARIO_RESERVATION_STATE_MAGIC_V1: [u8; {magic.length}] = [{String.intercalate ", " (magic.map rustByte)}];"
  emitConst "DEALER_SCENARIO_RESERVATION_STATE_BYTES_V1" "usize"
    (toString reservationStateBytes)
    "Exact reservation state account-data width."
  emitConst "DEALER_SCENARIO_CUSTODY_STATE_VERSION_V1" "u16" (toString schemaVersion)
    "Implemented Dealer scenario custody-state schema version, shared by this family."
  for status in Status.all do
    emitConst (Status.rustName status) "u8" (toString (Status.tag status))
      (Status.doc status)
  emitConst "DEALER_SCENARIO_RESERVATION_STATUS_LIMIT_V1" "u8" (toString statusLimit)
    "One past the greatest status tag; the machine numbers from one, so bit zero is never occupied."
  emitConst "DEALER_SCENARIO_RESERVATION_STATE_IDENTITIES_OFFSET_V1" "usize"
    (toString identitiesOffset)
    "Where the identity run begins: the width of the shared header in front of it."
  emitConst "DEALER_SCENARIO_RESERVATION_STATE_BALANCES_OFFSET_V1" "usize"
    (toString balancesOffset)
    "Where the four exact balance measurements begin."
  emitConst "DEALER_SCENARIO_RESERVATION_STATE_HEAD_RESERVED_BYTES_V1" "usize"
    (toString (Field.width .headReserved))
    "Width of the canonical-zero span between the three tags and the batch identity."
  emitConst "DEALER_SCENARIO_RESERVATION_STATE_RESERVED_BYTES_V1" "usize"
    (toString (Field.width .tailReserved))
    "Width of the canonical-zero tail span."
  for field in Field.all do
    emitConst (Field.rustName field) "usize" (toString (Field.offset field))
      (Field.doc field)
