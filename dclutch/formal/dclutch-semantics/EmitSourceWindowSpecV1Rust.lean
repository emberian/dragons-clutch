import DClutchSemantics.SourceWindowSpecV1Abi
import DClutchSemantics.Codec
import DClutchSemantics.RustEmit

open DClutch.RustEmit (rustByte emitConst)

/-! Emit the WindowSpecV1 preimage layout as Rust.

The record had two authors: `crates/dclutch-source-contract/src/lib.rs` wrote
the magic, the width and the two time coordinates as literals and left six more
as bare arguments inside `decode` and `to_bytes`, while
`SourceScheduledMedianV1` owned the last eight bytes from a cursor it asserted.
Everything below is a placement now.

The TAIL two coordinates are deliberately not printed here.
`EmitSourceScheduledMedianV1Rust.lean` still prints them, and it now derives
them from this schema, so there is one author and one definition of each
constant rather than one author and two. -/

open DClutch
open DClutch.SourceWindowSpecV1Abi

/-- Every field except the two the scheduled median's emitter owns. -/
def headFields : List Field :=
  Field.all.filter fun field =>
    field != .cadenceToleranceSeconds && field != .tailReserved

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitSourceWindowSpecV1Rust.lean; do not edit."
  IO.println "/// Canonical window-specification magic: `DCLTWIN1`."
  IO.println s!"pub const WINDOW_SPEC_MAGIC: [u8; {magic.length}] ="
  IO.println s!"    [{String.intercalate ", " (magic.map rustByte)}];"
  emitConst "WINDOW_SPEC_BYTES" "usize" (toString windowSpecBytes)
    "Exact width of a window-specification preimage."
  emitConst "WINDOW_SPEC_MAGIC_BYTES_V1" "usize"
    (toString (Field.width .magic))
    "Exact magic width, so a prefix check stops borrowing the version's coordinate."
  emitConst "WINDOW_SPEC_HEADER_RESERVED_BYTES_V1" "usize"
    (toString (Field.width .headerReserved))
    "Canonical-zero span between the kind tag and the source identity."
  for field in headFields do
    emitConst (Field.rustName field) "usize" (toString (Field.offset field))
      (Field.doc field)
