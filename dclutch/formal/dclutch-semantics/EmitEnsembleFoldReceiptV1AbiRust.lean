import DClutchSemantics.EnsembleFoldReceiptV1Abi
import DClutchSemantics.RustEmit

open DClutch.RustEmit (rustByte emitBytesRows emitSliceSkip)

open DClutch DClutch.EnsembleFoldReceiptV1Abi

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitEnsembleFoldReceiptV1AbiRust.lean; do not edit."
  IO.println s!"pub const ENSEMBLE_FOLD_RECEIPT_V1_BYTES: usize = {bytes};"
  IO.println s!"pub const ENSEMBLE_FOLD_RECEIPT_V1_SCHEMA_VERSION: u16 = {schemaVersion};"
  IO.println s!"pub const ENSEMBLE_MAX_MEMBERS_V1: u8 = {maxMembers};"
  emitBytesRows "pub" "ENSEMBLE_FOLD_RECEIPT_V1_MAGIC" magic
  emitSliceSkip "ENSEMBLE_FOLD_RECEIPT_PDA_DOMAIN_V1" receiptPdaDomain
  emitSliceSkip "ENSEMBLE_FRAGMENT_PDA_DOMAIN_V1" fragmentPdaDomain
  emitSliceSkip "ENSEMBLE_EVIDENCE_DOMAIN_V1" evidenceDomain
  for field in layout do
    IO.println s!"pub const {Field.rustName field.spec.name}: usize = {field.offset};"
  IO.println "#[cfg(test)]"
  emitBytesRows "pub(crate)" "ENSEMBLE_FOLD_RECEIPT_V1_EXAMPLE" (encode exampleReceipt)
  IO.println "#[cfg(test)]"
  emitBytesRows "pub(crate)" "ENSEMBLE_FOLD_RECEIPT_V1_PARTIAL_EXAMPLE" (encode partialReceipt)
  IO.println "#[cfg(test)]"
  IO.println s!"pub(crate) const ENSEMBLE_FOLD_RECEIPT_V1_REFUSAL_COUNT: usize = {refusalCorpus.length};"
  IO.println "#[cfg(test)]"
  IO.println "#[rustfmt::skip]"
  IO.println s!"pub(crate) const ENSEMBLE_FOLD_RECEIPT_V1_REFUSAL_CORPUS: [[u8; {bytes}]; {refusalCorpus.length}] = ["
  for value in refusalCorpus do
    IO.println "    ["
    for line in List.range ((value.length + 15) / 16) do
      let chunk := (value.drop (line * 16)).take 16
      IO.println s!"        {String.intercalate ", " (chunk.map rustByte)},"
    IO.println "    ],"
  IO.println "];"
