import DClutchSemantics.DirectOrdinaryV3

open DClutch
open DClutch.DirectOrdinaryV3

private def hexByte (byte : UInt8) : String :=
  let digits := "0123456789abcdef".toList
  let value := byte.toNat
  String.ofList [digits[value / 16]!, digits[value % 16]!]

private def rustByte (byte : UInt8) : String := s!"0x{hexByte byte}"

private def emitConst (doc name «type» value : String) : IO Unit := do
  IO.println s!"/// {doc}"
  IO.println s!"pub const {name}: {«type»} = {value};"

def main : IO Unit := do
  let bytes := TransitionVMV3.Codec.encodeProgram program
  IO.println
    "// @generated by formal/dclutch-semantics/EmitDirectOrdinaryV3Rust.lean; do not edit."
  for register in ScalarSlot.all do
    emitConst (ScalarSlot.doc register) (ScalarSlot.rustName register) "usize"
      (toString (ScalarSlot.index register))
  for (name, doc, register) in ScalarSlot.aliases do
    emitConst doc name "usize" (ScalarSlot.rustName register)
  for register in ItemScalarSlot.all do
    emitConst (ItemScalarSlot.doc register) (ItemScalarSlot.rustName register) "u16"
      (toString (ItemScalarSlot.index register))
  for register in IdentitySlot.all do
    emitConst (IdentitySlot.doc register) (IdentitySlot.rustName register) "usize"
      (toString (IdentitySlot.index register))
  emitConst "Exact common scalar-bank width for inline ordinary V3."
    "DIRECT_ORDINARY_COMMON_SCALARS_V3" "usize" (toString program.commonScalars)
  emitConst "Exact common identity-bank width for inline ordinary V3."
    "DIRECT_ORDINARY_COMMON_IDENTITIES_V3" "usize" (toString program.commonIdentities)
  emitConst "Per-Product-item scalar stride: canonical item index plus Claims quantity."
    "DIRECT_ORDINARY_ITEM_SCALAR_STRIDE_V3" "u16" (toString program.itemScalarStride)
  emitConst "Ordinary has no Product-item identity tail."
    "DIRECT_ORDINARY_ITEM_IDENTITY_STRIDE_V3" "u16" (toString program.itemIdentityStride)
  emitConst "Exact prelude instruction count of the ordinary semantic program."
    "DIRECT_ORDINARY_PRELUDE_INSTRUCTIONS_V3" "usize" (toString program.prelude.length)
  emitConst "Exact per-Product-item instruction count of the ordinary semantic program."
    "DIRECT_ORDINARY_ITEM_INSTRUCTIONS_V3" "usize" (toString program.itemBody.length)
  emitConst "Exact epilogue instruction count of the ordinary semantic program."
    "DIRECT_ORDINARY_EPILOGUE_INSTRUCTIONS_V3" "usize" (toString program.epilogue.length)
  emitConst "Exact instruction count of the ordinary semantic program."
    "DIRECT_ORDINARY_TRANSITION_INSTRUCTIONS_V3" "usize" (toString program.operations.length)
  emitConst "Exact encoded ordinary TransitionVM V3 width."
    "DIRECT_ORDINARY_TRANSITION_BYTES_V3" "usize" (toString bytes.length)
  IO.println "/// The exact ordinary TransitionVM V3 program."
  IO.println
    "pub const DIRECT_ORDINARY_TRANSITION_V3: [u8; DIRECT_ORDINARY_TRANSITION_BYTES_V3] = ["
  for line in List.range ((bytes.length + 11) / 12) do
    let chunk := (bytes.drop (line * 12)).take 12
    IO.println s!"    {String.intercalate ", " (chunk.map rustByte)},"
  IO.println "];"
