import DClutchSemantics.TransitionVMV2

/-! Emit the canonical V2 wire constants and a wide agreement program. -/

open DClutch.TransitionVMV2

def byteHex (byte : UInt8) : String := DClutch.Codec.byteHex byte

def rustBytes (bytes : List UInt8) : String :=
  s!"[{String.intercalate ", " (bytes.map fun byte => s!"0x{byteHex byte}")}]"

def emitOpcode (name : String) (operation : Op) : IO Unit :=
  IO.println s!"pub const {name}: u8 = {(Codec.opcode operation).toNat};"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitTransitionVMV2Rust.lean; do not edit."
  IO.println s!"pub const MAGIC: [u8; 4] = {rustBytes Codec.magic};"
  IO.println s!"pub const VERSION: u8 = {Codec.version.toNat};"
  IO.println s!"pub const HEADER_BYTES: usize = {Codec.headerBytes};"
  IO.println s!"pub const INSTRUCTION_BYTES: usize = {Codec.instructionBytes};"
  IO.println s!"pub const VERSION_OFFSET: usize = {Codec.versionOffset};"
  IO.println s!"pub const FLAGS_OFFSET: usize = {Codec.flagsOffset};"
  IO.println s!"pub const INSTRUCTION_COUNT_OFFSET: usize = {Codec.instructionCountOffset};"
  IO.println s!"pub const SCALAR_COUNT_OFFSET: usize = {Codec.scalarCountOffset};"
  IO.println s!"pub const IDENTITY_COUNT_OFFSET: usize = {Codec.identityCountOffset};"
  IO.println s!"pub const HEADER_RESERVED_OFFSET: usize = {Codec.headerReservedOffset};"
  IO.println s!"pub const OPCODE_OFFSET: usize = {Codec.opcodeOffset};"
  IO.println s!"pub const INSTRUCTION_RESERVED_BYTE_OFFSET: usize = {Codec.instructionReservedByteOffset};"
  IO.println s!"pub const A_OFFSET: usize = {Codec.argumentAOffset};"
  IO.println s!"pub const B_OFFSET: usize = {Codec.argumentBOffset};"
  IO.println s!"pub const C_OFFSET: usize = {Codec.argumentCOffset};"
  IO.println s!"pub const D_OFFSET: usize = {Codec.argumentDOffset};"
  IO.println s!"pub const INSTRUCTION_RESERVED_OFFSET: usize = {Codec.instructionReservedOffset};"
  IO.println s!"pub const IMMEDIATE_OFFSET: usize = {Codec.immediateOffset};"
  emitOpcode "OP_LOAD_CONST" (.loadConst 0 0)
  emitOpcode "OP_SCALAR_EQ" (.scalarEq 0 0)
  emitOpcode "OP_IDENTITY_EQ" (.identityEq 0 0)
  emitOpcode "OP_IDENTITY_NE" (.identityNe 0 0)
  emitOpcode "OP_SCALAR_LT" (.scalarLt 0 0)
  emitOpcode "OP_SCALAR_LE" (.scalarLe 0 0)
  emitOpcode "OP_NONZERO" (.nonzero 0)
  emitOpcode "OP_LIFECYCLE_ACCEPTS" (.lifecycleAccepts 0 0 0)
  emitOpcode "OP_INCREMENT_INTO" (.incrementInto 0 0)
  emitOpcode "OP_MUL_DIV_EXACT" (.mulDivExact 0 0 0 0)
  emitOpcode "OP_MUL_DIV_FLOOR" (.mulDivFloor 0 0 0 0)
  emitOpcode "OP_ADD_LE" (.addLe 0 0 0)
  emitOpcode "OP_ADD_FITS_U64" (.addFitsU64 0 0)
  emitOpcode "OP_SUB_INTO" (.subInto 0 0 0)
  emitOpcode "OP_SELECT_EQ" (.selectEq 0 0 0 0)
  emitOpcode "OP_SELECT_ZERO" (.selectZero 0 0 0)
  emitOpcode "OP_CHECKED_ADD_INTO" (.checkedAddInto 0 0 0)
  emitOpcode "OP_CHECKED_MUL_INTO" (.checkedMulInto 0 0 0)
  emitOpcode "OP_MIN_INTO" (.minInto 0 0 0)
  emitOpcode "OP_MAX_INTO" (.maxInto 0 0 0)
  emitOpcode "OP_COPY_SCALAR" (.copyScalar 0 0)
  emitOpcode "OP_COPY_IDENTITY" (.copyIdentity 0 0)
  let wide := Codec.encodeProgram wideExample
  if wide.length != 88 then
    throw <| IO.userError s!"wide V2 program had unexpected width {wide.length}"
  IO.println s!"pub const WIDE_AGREEMENT_PROGRAM_V2: [u8; {wide.length}] = {rustBytes wide};"
