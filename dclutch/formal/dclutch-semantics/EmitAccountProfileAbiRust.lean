import DClutchSemantics.AccountProfileAbi

/-! Emit the account-profile ABI constants and generated agreement/refusal corpus. -/

open DClutch
open DClutch.AccountProfileAbi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (name : String) (value : List UInt8) : IO Unit := do
  IO.println s!"pub const {name}: [u8; {value.length}] = ["
  IO.println s!"    {String.intercalate ", " (value.map rustByte)},"
  IO.println "];"

def emitSlice (name : String) (value : List UInt8) : IO Unit := do
  IO.println s!"pub const {name}: &[u8] = &["
  IO.println s!"    {String.intercalate ", " (value.map rustByte)},"
  IO.println "];"

def emitCorpus (name : String) (corpus : List (List UInt8)) : IO Unit := do
  let width := (corpus.head?).map (·.length) |>.getD 0
  IO.println s!"pub const {name}: [[u8; {width}]; {corpus.length}] = ["
  for value in corpus do
    if value.length != width then
      throw <| IO.userError "account-profile refusal corpus has inconsistent widths"
    IO.println "    ["
    IO.println s!"        {String.intercalate ", " (value.map rustByte)},"
    IO.println "    ],"
  IO.println "];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitAccountProfileAbiRust.lean; do not edit."
  IO.println s!"pub const ACCOUNT_PROFILE_HEADER_BYTES_V1: usize = {headerBytes};"
  IO.println s!"pub const ACCOUNT_PROFILE_RULE_BYTES_V1: usize = {ruleBytes};"
  IO.println s!"pub const ACCOUNT_PROFILE_OPERATION_BYTES_V1: usize = {operationBytes};"
  IO.println s!"pub const ACCOUNT_PROFILE_MAX_BYTES_V1: usize = {finalizedRecordMaxBytes};"
  IO.println s!"pub const ACCOUNT_PROFILE_SCHEMA_VERSION_V1: u16 = {schemaVersion};"
  IO.println s!"pub const ACCOUNT_PROFILE_ARTIFACT_PROFILE_V1: u16 = {artifactProfile};"
  emitSlice "ACCOUNT_PROFILE_SCHEMA_RELEASE_PREIMAGE_V1" schemaReleasePreimage
  emitBytes "ACCOUNT_PROFILE_SCHEMA_RELEASE_ID_V1" schemaReleaseId
  IO.println s!"pub const EFFECT_PERMISSION_DEBIT_LAMPORTS: u8 = {effectPermissionDebitLamports};"
  IO.println s!"pub const EFFECT_PERMISSION_CREDIT_LAMPORTS: u8 = {effectPermissionCreditLamports};"
  IO.println s!"pub const EFFECT_PERMISSION_WRITE_DATA: u8 = {effectPermissionWriteData};"
  emitBytes "ACCOUNT_PROFILE_MAGIC_V1" magic
  for field in headerLayout do
    IO.println s!"pub const {HeaderField.rustName field.spec.name}: usize = {field.offset};"
  for field in ruleLayout do
    IO.println s!"pub const {RuleField.rustName field.spec.name}: usize = {field.offset};"
  for field in operationLayout do
    IO.println s!"pub const {OperationField.rustName field.spec.name}: usize = {field.offset};"
  IO.println s!"pub const OP_REQUIRE_KEY_EQ_IDENTITY: u8 = {OperationKind.requireKeyEqIdentity.tag.toNat};"
  IO.println s!"pub const OP_REQUIRE_OWNER_EQ_IDENTITY: u8 = {OperationKind.requireOwnerEqIdentity.tag.toNat};"
  IO.println s!"pub const OP_PROJECT_KEY: u8 = {OperationKind.projectKey.tag.toNat};"
  IO.println s!"pub const OP_PROJECT_OWNER: u8 = {OperationKind.projectOwner.tag.toNat};"
  IO.println s!"pub const OP_PROJECT_LAMPORTS: u8 = {OperationKind.projectLamports.tag.toNat};"
  IO.println s!"pub const OP_PROJECT_DATA_U64: u8 = {OperationKind.projectDataU64.tag.toNat};"
  IO.println s!"pub const OP_PROJECT_DATA_IDENTITY: u8 = {OperationKind.projectDataIdentity.tag.toNat};"
  IO.println "#[cfg(test)]"
  emitBytes "AGREEMENT_PROFILE_V1" (encodeProfile activationResourceProfile)
  emitBytes "GENERAL_ACTIVATION_ACCOUNT_PROFILE_ID_V1" activationResourceProfileContentId
  IO.println "#[cfg(test)]"
  emitBytes "ALIAS_AGREEMENT_PROFILE_V1" (encodeProfile aliasAgreementProfile)
  IO.println "#[cfg(test)]"
  emitCorpus "REFUSAL_CORPUS_V1" refusalCorpus
