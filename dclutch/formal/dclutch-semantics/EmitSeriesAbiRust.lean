  emitNat "TICKET_BYTES" ticketBytes
  emitNat "RECEIPT_BYTES" receiptBytes
  emitNat "REQUEST_BYTES" requestBytes
  emitNat "HEADER_VERSION_OFFSET" headerVersionOffset
