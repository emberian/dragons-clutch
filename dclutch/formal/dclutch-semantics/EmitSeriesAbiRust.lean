  IO.println "    Some((due, due.checked_add(retry)?))"
  IO.println "}"
  IO.println ""
  IO.println "pub(crate) const fn next_series_phase(next: u32, count: u32) -> Option<u8> {"
  IO.println "    if next == count { Some(PHASE_TERMINAL) } else if next < count { Some(PHASE_ACTIVE) } else { None }"
  IO.println "}"
