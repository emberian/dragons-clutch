import DClutchSemantics.ClaimsConservationV1Abi
import DClutchSemantics.Codec
import DClutchSemantics.RustEmit

open DClutch.RustEmit (emitBytes)

/-! Emit the Claims conservation request ABI (`DCLCNS01`) as Rust.

The crate wrote twenty-nine offsets and the width as decimal literals; every
one is a placement now, and the guard in `crates/dclutch-claims/check-generated.sh`
byte-compares this emission against `src/generated_conservation_v1.rs`. -/

open DClutch
open DClutch.ClaimsConservationV1Abi

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitClaimsConservationV1Rust.lean; do not edit."
  IO.println "/// Implemented schema version."
  IO.println s!"pub const CLAIMS_CONSERVATION_SCHEMA_VERSION_V1: u16 = {version};"
  IO.println "/// Exact canonical request width."
  IO.println s!"pub const CLAIMS_CONSERVATION_REQUEST_BYTES_V1: usize = {requestBytes};"
  IO.println "/// Canonical outer-route request magic: `DCLCNS01`."
  emitBytes "CLAIMS_CONSERVATION_REQUEST_MAGIC_V1" requestMagic
  IO.println "/// The split direction's one-byte selector."
  IO.println s!"pub const CLAIMS_CONSERVATION_SPLIT_TAG_V1: u8 = {splitTag};"
  IO.println "/// The merge direction's one-byte selector."
  IO.println s!"pub const CLAIMS_CONSERVATION_MERGE_TAG_V1: u8 = {mergeTag};"
  for field in RequestField.all do
    IO.println s!"pub(crate) const {RequestField.rustName field}: usize = {RequestField.offset field};"
  IO.println s!"pub(crate) const HEADER_RESERVED_BYTES: usize = {RequestField.width .reservedHeader};"
  IO.println s!"pub(crate) const TAIL_RESERVED_BYTES: usize = {RequestField.width .reservedTail};"
