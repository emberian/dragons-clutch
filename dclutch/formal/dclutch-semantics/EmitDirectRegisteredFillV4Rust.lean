import DClutchSemantics.DirectRegisteredFillV4
import DClutchSemantics.RustEmit

open DClutch.RustEmit (rustByte byteHex)

open DClutch
open DClutch.DirectRegisteredFillV4

private def emitConst (doc name «type» value : String) : IO Unit := do
  IO.println s!"/// {doc}"
  IO.println s!"pub const {name}: {«type»} = {value};"

/-- `--transcription` prints the ninety-nine-instruction transcription as flat
hex and nothing else. That is the byte-identity gate: the bytes the hand-written
Rust `InstructionV3` array produced at the commit this module replaced. -/
def main (args : List String) : IO Unit := do
  if args.contains "--transcription" then
    let bytes := TransitionVMV3.Codec.encodeProgram transcribedProgram
    IO.println (String.join (bytes.map byteHex))
    return
  let bytes := TransitionVMV3.Codec.encodeProgram program
  IO.println
    "// @generated by formal/dclutch-semantics/EmitDirectRegisteredFillV4Rust.lean; do not edit."
  for register in ScalarSlot.all do
    emitConst (ScalarSlot.doc register) (ScalarSlot.rustName register) "usize"
      (toString (ScalarSlot.index register))
  for register in IdentitySlot.all do
    emitConst (IdentitySlot.doc register) (IdentitySlot.rustName register) "usize"
      (toString (IdentitySlot.index register))
  emitConst "Common scalar-bank width for registered ordinary fills."
    "DIRECT_REGISTERED_FILL_COMMON_SCALARS_V4" "usize" (toString program.commonScalars)
  emitConst
    ("Common identity-bank width for registered ordinary fills. Eight registers " ++
      "past the named schema are carried and never addressed.")
    "DIRECT_REGISTERED_FILL_COMMON_IDENTITIES_V4" "usize" (toString program.commonIdentities)
  emitConst "Registered ordinary fills have no per-Product-item register body."
    "DIRECT_REGISTERED_FILL_ITEM_SCALAR_STRIDE_V4" "u16" (toString program.itemScalarStride)
  emitConst "Registered ordinary fills have no per-Product-item identity body."
    "DIRECT_REGISTERED_FILL_ITEM_IDENTITY_STRIDE_V4" "u16" (toString program.itemIdentityStride)
  emitConst "Exact prelude instruction count of the registered-fill semantic program."
    "DIRECT_REGISTERED_FILL_PRELUDE_INSTRUCTIONS_V4" "usize" (toString program.prelude.length)
  emitConst "Exact per-Product-item instruction count; the registered fill has no item body."
    "DIRECT_REGISTERED_FILL_ITEM_INSTRUCTIONS_V4" "usize" (toString program.itemBody.length)
  emitConst "Exact epilogue instruction count; the registered fill has no epilogue."
    "DIRECT_REGISTERED_FILL_EPILOGUE_INSTRUCTIONS_V4" "usize" (toString program.epilogue.length)
  emitConst "Exact instruction count of the registered-fill semantic program."
    "DIRECT_REGISTERED_FILL_TRANSITION_INSTRUCTIONS_V4" "usize"
    (toString program.operations.length)
  emitConst "Exact encoded registered-fill TransitionVM V3 width."
    "DIRECT_REGISTERED_FILL_TRANSITION_BYTES_V4" "usize" (toString bytes.length)
  IO.println "/// The exact registered ordinary fill TransitionVM V3 program."
  IO.println
    ("pub const DIRECT_REGISTERED_FILL_TRANSITION_V4: " ++
      "[u8; DIRECT_REGISTERED_FILL_TRANSITION_BYTES_V4] = [")
  for line in List.range ((bytes.length + 11) / 12) do
    let chunk := (bytes.drop (line * 12)).take 12
    IO.println s!"    {String.intercalate ", " (chunk.map rustByte)},"
  IO.println "];"
