import DClutchSemantics.RationalTerminalHotV3Abi
import DClutchSemantics.Codec

open DClutch
open DClutch.RationalTerminalHotV3Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (name : String) (value : List UInt8) : IO Unit := do
  IO.println "#[rustfmt::skip]"
  IO.println s!"pub const {name}: [u8; {value.length}] = ["
  for line in List.range ((value.length + 15) / 16) do
    let chunk := (value.drop (line * 16)).take 16
    IO.println s!"    {String.intercalate ", " (chunk.map rustByte)},"
  IO.println "];"

def emitSlice (name : String) (value : List UInt8) : IO Unit := do
  IO.println "#[rustfmt::skip]"
  IO.println s!"pub const {name}: &[u8] = &["
  IO.println s!"    {String.intercalate ", " (value.map rustByte)},"
  IO.println "];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitRationalTerminalHotV3Rust.lean; do not edit."
  IO.println s!"pub const RATIONAL_TERMINAL_HOT_VERSION_V3: u16 = {version};"
  IO.println s!"pub const RATIONAL_TERMINAL_HOT_REQUEST_BYTES_V3: usize = {requestBytes};"
  IO.println s!"pub const RATIONAL_TERMINAL_HOT_FIXED_ASSET_COUNT_V3: u32 = {fixedAssetCount};"
  emitSlice "RATIONAL_TERMINAL_HOT_REQUEST_SCHEMA_PREIMAGE_V3" requestSchemaPreimage
  emitBytes "RATIONAL_TERMINAL_HOT_REQUEST_SCHEMA_ID_V3" requestSchemaId
  IO.println s!"pub const RATIONAL_TERMINAL_HOT_MAGIC_V3: [u8; {familyMagic.length}] ="
  IO.println s!"    [{String.intercalate ", " (familyMagic.map rustByte)}];"
  for field in emittedFields do
    IO.println s!"pub const {familyName field}: usize = {requestOffset field};"
  IO.println s!"pub const RATIONAL_TERMINAL_HOT_ASSET_OFFSET_V3: usize = {assetStartOffset};"
  for field in DClutch.RationalRepresentationV2PhysicalAbi.AssetField.all do
    IO.println s!"pub const {familyAssetName field}: usize = {absoluteAssetOffset field};"
