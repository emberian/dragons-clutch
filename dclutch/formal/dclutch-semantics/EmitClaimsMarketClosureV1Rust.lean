import DClutchSemantics.MarketRetirementV1Abi
import DClutchSemantics.Codec

open DClutch
open DClutch.MarketRetirementV1Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (name : String) (bytes : List UInt8) : IO Unit := do
  IO.println s!"pub const {name}: [u8; {bytes.length}] = ["
  IO.println s!"    {String.intercalate ", " (bytes.map rustByte)},"
  IO.println "];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitClaimsMarketClosureV1Rust.lean; do not edit."
  IO.println s!"pub const CLAIMS_MARKET_CLOSURE_VERSION_V1: u16 = {version};"
  IO.println s!"pub const CLAIMS_MARKET_CLOSURE_ACTION_V1: u8 = {claimsAction};"
  IO.println s!"pub const CLAIMS_MARKET_CLOSURE_REQUEST_BYTES_V1: usize = {claimsRequestBytes};"
  IO.println s!"pub const CLAIMS_MARKET_CLOSURE_RECEIPT_BYTES_V1: usize = {claimsReceiptBytes};"
  emitBytes "CLAIMS_MARKET_CLOSURE_REQUEST_MAGIC_V1" claimsRequestMagic
  emitBytes "CLAIMS_MARKET_CLOSURE_RECEIPT_MAGIC_V1" claimsReceiptMagic
  emitBytes "CLAIMS_MARKET_CLOSURE_PRE_RESOURCE_DIGEST_DOMAIN_V1" claimsPreResourceDigestDomain
  emitBytes "CLAIMS_MARKET_CLOSURE_POST_RESOURCE_DIGEST_DOMAIN_V1" claimsPostResourceDigestDomain
  for field in claimsRequestLayout do
    IO.println s!"pub(crate) const {ClaimsRequestField.rustName field.spec.name}: usize = {field.offset};"
  for field in claimsReceiptLayout do
    IO.println s!"pub(crate) const {ClaimsReceiptField.rustName field.spec.name}: usize = {field.offset};"
