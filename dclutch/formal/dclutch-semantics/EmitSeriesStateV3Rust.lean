import DClutchSemantics.SeriesStateV3Abi

/-! Emit the Series root tail's ABI as Rust.

The width, the two `SeriesPhaseV3` tags, the two canonical-zero spans and the
coordinate of every word.  The header width is NOT emitted: it is numerically
the occurrence cursor's coordinate, and two Rust names for one coordinate is
the second author this emitter exists to remove.  Before this emitter `replay.rs` spelled each offset
twice, in `encode` and in `decode`, and nothing outside that file could name
the phase byte.  The magic and the family's schema and profile VALUES are
emitted elsewhere; only their coordinates in this record are emitted here. -/

open DClutch.SeriesStateV3Abi

def emitConst (name kind value doc : String) : IO Unit := do
  IO.println s!"/// {doc}"
  IO.println s!"pub const {name}: {kind} = {value};"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitSeriesStateV3Rust.lean; do not edit."
  emitConst "SERIES_STATE_BYTES_V3" "usize" (toString seriesStateBytes)
    "Exact width of the mutable Series tail inside the composite Trading root."
  for phase in Phase.all do
    emitConst (Phase.rustName phase) "u8" (toString (Phase.tag phase)) (Phase.doc phase)
  emitConst "SERIES_PHASE_LIMIT_V3" "u8" (toString phaseLimit)
    "One past the greatest phase tag: every phase indexes its own bit of a `u8`."
  emitConst "SERIES_STATE_HEAD_RESERVED_BYTES_V3" "usize"
    (toString (Field.width .headReserved))
    "Width of the canonical-zero span between the prepared flag and the occurrence cursor."
  emitConst "SERIES_STATE_TAIL_RESERVED_BYTES_V3" "usize"
    (toString (Field.width .tailReserved))
    "Width of the canonical-zero tail span."
  for field in Field.all do
    emitConst (Field.rustName field) "usize" (toString (Field.offset field))
      (Field.doc field)
