import DClutchSemantics.SourceStatisticSpecV1Abi
import DClutchSemantics.Codec

/-! Emit the StatisticSpecV1 preimage layout as Rust.

The record had one author and it wrote every coordinate as a bare argument:
`crates/dclutch-source-contract/src/lib.rs` spelled `16`, `48`, `80`, `96`,
`112` and `144` inside `decode` and again inside `to_bytes`, and named its two
canonical-zero spans only as the arguments of two `zero` calls.  When
`4cd2b9cb5` put `source_scale_exponent` into the first of those spans -- the
number that decides which cell a market pays -- it landed at an offset nothing
emitted.  Everything below is a placement now. -/

open DClutch
open DClutch.SourceStatisticSpecV1Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitConst (name kind value doc : String) : IO Unit := do
  IO.println s!"/// {doc}"
  IO.println s!"pub const {name}: {kind} = {value};"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitSourceStatisticSpecV1Rust.lean; do not edit."
  IO.println "/// Canonical statistic-specification magic: `DCLTSTA1`."
  IO.println s!"pub const STATISTIC_SPEC_MAGIC: [u8; {magic.length}] ="
  IO.println s!"    [{String.intercalate ", " (magic.map rustByte)}];"
  emitConst "STATISTIC_SPEC_BYTES" "usize" (toString statisticSpecBytes)
    "Exact width of a statistic-specification preimage."
  emitConst "STATISTIC_SPEC_MAGIC_BYTES_V1" "usize"
    (toString (Field.width .magic))
    "Exact magic width, so a prefix check stops borrowing the version's coordinate."
  emitConst "STATISTIC_SPEC_SOURCE_SCALE_EXPONENT_BYTES_V1" "usize"
    (toString (Field.width .sourceScaleExponent))
    "Width of the declared source-to-result shift, exactly the span it replaced."
  emitConst "STATISTIC_SPEC_BODY_RESERVED_BYTES_V1" "usize"
    (toString (Field.width .bodyReserved))
    "The one canonical-zero span this record still has."
  emitConst "STATISTIC_SPEC_UNITS_OFFSET_V1" "usize" (toString unitsOffset)
    "Where the two unit identities begin: the width of the header in front of them."
  for field in Field.all do
    emitConst (Field.rustName field) "usize" (toString (Field.offset field))
      (Field.doc field)
