import DClutchSemantics.ExecutionStrategyV2Abi
import DClutchSemantics.Codec

/-! Emit the Lean-owned Execution Strategy V2 fixed layouts. -/

open DClutch
open DClutch.AbiSchema
open DClutch.ExecutionStrategyV2Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitMagic (name : String) (magic : List UInt8) : IO Unit := do
  IO.println s!"pub const {name}: [u8; {magic.length}] = ["
  IO.println s!"    {String.intercalate ", " (magic.map rustByte)},"
  IO.println "];"

def emitOffsets {α : Type} (layout : List (PlacedField α)) (rustName : α → String) : IO Unit := do
  for field in layout do
    IO.println s!"pub const {rustName field.spec.name}: usize = {field.offset};"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitExecutionStrategyV2AbiRust.lean; do not edit."
  IO.println s!"pub const EXECUTION_STRATEGY_SCHEMA_VERSION_V2: u16 = {schemaVersion};"
  IO.println s!"pub const EXECUTION_STRATEGY_ARTIFACT_PROFILE_V2: u16 = {artifactProfile};"
  IO.println s!"pub const EXECUTION_STRATEGY_PROGRAM_BYTES_V2: usize = {strategyBytes};"
  IO.println s!"pub const EXECUTION_STRATEGY_CERTIFICATE_BYTES_V2: usize = {certificateBytes};"
  IO.println s!"pub const EXECUTION_STRATEGY_ADMISSION_BYTES_V2: usize = {admissionBytes};"
  IO.println s!"pub const ACCELERATOR_REQUEST_HEADER_BYTES_V2: usize = {requestHeaderBytes};"
  IO.println s!"pub const ACCELERATOR_ACK_HEADER_BYTES_V2: usize = {ackHeaderBytes};"
  IO.println s!"pub const SCRATCH_PAGE_HEADER_BYTES_V2: usize = {scratchHeaderBytes};"
  IO.println s!"pub const SVM_RETURN_DATA_BYTES_V2: usize = {returnDataBytes};"
  IO.println s!"pub const ACCELERATOR_CHUNK_PAYLOAD_BYTES_V2: usize = {chunkPayloadBytes};"
  emitMagic "EXECUTION_STRATEGY_PROGRAM_MAGIC_V2" strategyMagic
  emitMagic "EXECUTION_STRATEGY_CERTIFICATE_MAGIC_V2" certificateMagic
  emitMagic "EXECUTION_STRATEGY_ADMISSION_MAGIC_V2" admissionMagic
  emitMagic "ACCELERATOR_REQUEST_MAGIC_V2" requestMagic
  emitMagic "ACCELERATOR_ACK_MAGIC_V2" ackMagic
  emitMagic "SCRATCH_PAGE_MAGIC_V2" scratchMagic
  emitOffsets strategyLayout StrategyField.rustName
  emitOffsets certificateLayout CertificateField.rustName
  emitOffsets admissionLayout AdmissionField.rustName
  emitOffsets requestLayout RequestField.rustName
  emitOffsets ackLayout AckField.rustName
  emitOffsets scratchLayout ScratchField.rustName
