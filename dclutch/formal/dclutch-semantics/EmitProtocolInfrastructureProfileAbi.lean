import DClutchSemantics.Codec
import DClutchSemantics.ProtocolInfrastructureProfileAbi
import DClutchSemantics.TsEmit
import DClutchSemantics.RustEmit

open DClutch.RustEmit (emitBytes emitSlice)

/-! Emit the immutable protocol-infrastructure profile layout: `rust` (the
default) for `crates/dclutch-release-set-contract`, `ts` for the browser and
the SDK.  The TypeScript used to be a mirror of a mirror --
`generate-protocol-infrastructure.mjs` ran a regular expression over the
Lean-emitted Rust -- and broke the moment a coordinate moved from the
hand-written half of that crate into the generated half. -/

namespace Rust

open DClutch
open DClutch.AbiSchema
open DClutch.ProtocolInfrastructureProfileAbi

/-- Emit one PDA seed domain, and the Rust-side statement of its seed bound.

`pda_domains_are_admissible_single_seeds` proves `length <= 32` over the Lean
definition these bytes come from, and that proof is the author.  The emitted
`const _: () = assert!(..)` is the same bound restated where `cargo check`
reads it, so every consumer of this crate is told rather than only a run of
`check-generated.sh` -- which needs `lake` and is the tier that skips when a
host has none. -/
def emitSeedDomain (name : String) (value : List UInt8) : IO Unit := do
  emitSlice name value
  IO.println s!"const _: () = assert!({name}.len() <= 32);"

def run : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitProtocolInfrastructureProfileAbi.lean; do not edit."
  IO.println s!"pub const PROTOCOL_INFRASTRUCTURE_PROFILE_BYTES_V1: usize = {profileBytes};"
  IO.println s!"pub const PROTOCOL_INFRASTRUCTURE_PROFILE_SCHEMA_VERSION_V1: u16 = {schemaVersion};"
  IO.println s!"pub const PROTOCOL_INFRASTRUCTURE_PROFILE_ARTIFACT_PROFILE_V1: u16 = {artifactProfile};"
  emitBytes "PROTOCOL_INFRASTRUCTURE_PROFILE_MAGIC_V1" profileMagic
  for field in profileLayout do
    IO.println s!"pub const {ProfileField.rustName field.spec.name}: usize = {field.offset};"
  IO.println s!"pub const INITIALIZE_PROTOCOL_INFRASTRUCTURE_BYTES_V1: usize = {initializeBytes};"
  emitBytes "INITIALIZE_PROTOCOL_INFRASTRUCTURE_MAGIC_V1" initializeMagic
  for field in initializeLayout do
    IO.println s!"pub const {InitializeField.rustName field.spec.name}: usize = {field.offset};"
  IO.println s!"pub const PROTOCOL_INFRASTRUCTURE_PROFILE_BYTES_V2: usize = {profileBytesV2};"
  IO.println s!"pub const PROTOCOL_INFRASTRUCTURE_PROFILE_SCHEMA_VERSION_V2: u16 = {schemaVersionV2};"
  emitBytes "PROTOCOL_INFRASTRUCTURE_PROFILE_MAGIC_V2" profileMagicV2
  for field in profileLayoutV2 do
    IO.println s!"pub const {ProfileFieldV2.rustName field.spec.name}: usize = {field.offset};"
  IO.println s!"pub const INITIALIZE_PROTOCOL_INFRASTRUCTURE_BYTES_V2: usize = {initializeBytes};"
  emitBytes "INITIALIZE_PROTOCOL_INFRASTRUCTURE_MAGIC_V2" initializeMagicV2
  for field in initializeLayout do
    IO.println s!"pub const {InitializeField.rustNameV2 field.spec.name}: usize = {field.offset};"
  emitSeedDomain "PROTOCOL_INFRASTRUCTURE_PROFILE_PDA_DOMAIN_V1" profilePdaDomainV1
  emitSeedDomain "PROTOCOL_INFRASTRUCTURE_PROFILE_PDA_DOMAIN_V2" profilePdaDomainV2

end Rust

namespace Ts

open DClutch.AbiSchema
open DClutch.ProtocolInfrastructureProfileAbi
open DClutch.TsEmit

def run : IO Unit :=
  emit (header "EmitProtocolInfrastructureProfileAbi.lean" "abi:infrastructure") [
    [ nat "PROTOCOL_INFRASTRUCTURE_PROFILE_BYTES_V1" profileBytes,
      nat "PROTOCOL_INFRASTRUCTURE_PROFILE_SCHEMA_VERSION_V1" schemaVersion,
      nat "PROTOCOL_INFRASTRUCTURE_PROFILE_ARTIFACT_PROFILE_V1" artifactProfile ]
      ++ offsets ProfileField.rustName profileLayout,
    [ bytes "PROTOCOL_INFRASTRUCTURE_PROFILE_MAGIC_V1" profileMagic,
      domain "PROTOCOL_INFRASTRUCTURE_PROFILE_PDA_DOMAIN_V1" profilePdaDomainTextV1 ],
    [ nat "PROTOCOL_INFRASTRUCTURE_PROFILE_BYTES_V2" profileBytesV2,
      nat "PROTOCOL_INFRASTRUCTURE_PROFILE_SCHEMA_VERSION_V2" schemaVersionV2 ]
      ++ offsets ProfileFieldV2.rustName profileLayoutV2,
    [ bytes "PROTOCOL_INFRASTRUCTURE_PROFILE_MAGIC_V2" profileMagicV2,
      domain "PROTOCOL_INFRASTRUCTURE_PROFILE_PDA_DOMAIN_V2" profilePdaDomainTextV2 ]
  ]

end Ts

def main (args : List String) : IO Unit :=
  match args with
  | [] | ["rust"] => Rust.run
  | ["ts"] => Ts.run
  | _ => throw (IO.userError "usage: lake env lean --run EmitProtocolInfrastructureProfileAbi.lean [rust | ts]")
