import DClutchSemantics.CapabilityFundingLedgerV2

/-! Emit the funding-ledger activation decision corpus.

Vectors, not the rule: `FundingLedgerV2::activate_in_place` stays hand-written
and this is what makes it answerable to `CapabilityFundingLedgerV2.lean`. -/

open DClutch
open DClutch.CapabilityFundingLedgerV2

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitCapabilityFundingActivationCorpusRust.lean; do not edit."
  IO.println s!"pub const FUNDING_ACTIVATION_COMPARTMENTS: usize = {activationZeroed.length};"
  IO.println "/// Which compartments the activation release zeroes, and which it must"
  IO.println "/// leave exactly as it found them."
  IO.println s!"pub const FUNDING_ACTIVATION_ZEROED: [bool; {activationZeroed.length}] = [{String.intercalate ", " (activationZeroed.map toString)}];"
  IO.println ""
  IO.println "/// One activation decision case, as Lean decides it."
  IO.println "#[derive(Clone, Copy, Debug, Eq, PartialEq)]"
  IO.println "pub struct FundingActivationVectorV1 {"
  IO.println "    /// The decision case this vector stands for."
  IO.println "    pub name: &'static str,"
  IO.println "    /// Slot status tag: 0 Pending, 1 Active, 2 Closed."
  IO.println "    pub status: u8,"
  IO.println "    /// Whether `activate` admits this status."
  IO.println "    pub admits: bool,"
  IO.println "}"
  IO.println ""
  IO.println s!"pub const FUNDING_ACTIVATION_VECTORS_V1: [FundingActivationVectorV1; {activationVectors.length}] = ["
  for vector in activationVectors do
    IO.println "    FundingActivationVectorV1 {"
    IO.println s!"        name: \"{vector.name}\","
    IO.println s!"        status: {vector.status.tag},"
    IO.println s!"        admits: {vector.admits},"
    IO.println "    },"
  IO.println "];"
