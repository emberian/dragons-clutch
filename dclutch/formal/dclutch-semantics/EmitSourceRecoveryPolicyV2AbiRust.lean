import DClutchSemantics.SourceRecoveryPolicyV2Abi

open DClutch DClutch.SourceRecoveryPolicyV2Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (visibility name : String) (value : List UInt8) : IO Unit := do
  IO.println "#[rustfmt::skip]"
  IO.println s!"{visibility} const {name}: [u8; {value.length}] = ["
  for line in List.range ((value.length + 15) / 16) do
    let chunk := (value.drop (line * 16)).take 16
    IO.println s!"    {String.intercalate ", " (chunk.map rustByte)},"
  IO.println "];"

def emitSlice (name : String) (value : List UInt8) : IO Unit := do
  IO.println "#[rustfmt::skip]"
  IO.println s!"pub const {name}: &[u8] = &["
  IO.println s!"    {String.intercalate ", " (value.map rustByte)},"
  IO.println "];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitSourceRecoveryPolicyV2AbiRust.lean; do not edit."
  IO.println s!"pub const RECOVERY_ATTEMPT_BYTES_V2: usize = {attemptBytes};"
  IO.println s!"pub const RECOVERY_POLICY_BYTES_V2: usize = {bytes};"
  IO.println s!"pub const RECOVERY_POLICY_MAX_ATTEMPTS_V2: usize = {maxAttempts};"
  IO.println s!"pub const RECOVERY_POLICY_SCHEMA_VERSION_V2: u16 = {schemaVersion};"
  emitBytes "pub" "RECOVERY_POLICY_MAGIC_V2" magic
  emitSlice "RECOVERY_POLICY_SCHEMA_PREIMAGE_V2" schemaReleasePreimage
  emitBytes "pub" "RECOVERY_POLICY_SCHEMA_ID_V2" schemaReleaseId
  for field in attemptLayout do
    IO.println s!"pub const {AttemptField.rustName field.spec.name}: usize = {field.offset};"
  for field in layout do
    IO.println s!"pub const {Field.rustName field.spec.name}: usize = {field.offset};"
  IO.println "#[cfg(test)]"
  emitBytes "pub(crate)" "RECOVERY_POLICY_V2_EXAMPLE" (encode examplePolicy)
  IO.println "#[cfg(test)]"
  IO.println s!"pub(crate) const RECOVERY_POLICY_V2_REFUSAL_COUNT: usize = {refusalCorpus.length};"
  IO.println "#[cfg(test)]"
  IO.println "#[rustfmt::skip]"
  IO.println s!"pub(crate) const RECOVERY_POLICY_V2_REFUSAL_CORPUS: [[u8; {bytes}]; {refusalCorpus.length}] = ["
  for value in refusalCorpus do
    IO.println "    ["
    for line in List.range ((value.length + 15) / 16) do
      let chunk := (value.drop (line * 16)).take 16
      IO.println s!"        {String.intercalate ", " (chunk.map rustByte)},"
    IO.println "    ],"
  IO.println "];"
