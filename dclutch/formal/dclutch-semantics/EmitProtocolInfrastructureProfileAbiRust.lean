import DClutchSemantics.ProtocolInfrastructureProfileAbi
import DClutchSemantics.Codec

/-! Emit the Lean-owned immutable protocol-infrastructure profile layout. -/

open DClutch
open DClutch.AbiSchema
open DClutch.ProtocolInfrastructureProfileAbi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (name : String) (value : List UInt8) : IO Unit := do
  IO.println s!"pub const {name}: [u8; {value.length}] = ["
  IO.println s!"    {String.intercalate ", " (value.map rustByte)},"
  IO.println "];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitProtocolInfrastructureProfileAbiRust.lean; do not edit."
  IO.println s!"pub const PROTOCOL_INFRASTRUCTURE_PROFILE_BYTES_V1: usize = {profileBytes};"
  IO.println s!"pub const PROTOCOL_INFRASTRUCTURE_PROFILE_SCHEMA_VERSION_V1: u16 = {schemaVersion};"
  IO.println s!"pub const PROTOCOL_INFRASTRUCTURE_PROFILE_ARTIFACT_PROFILE_V1: u16 = {artifactProfile};"
  emitBytes "PROTOCOL_INFRASTRUCTURE_PROFILE_MAGIC_V1" profileMagic
  for field in profileLayout do
    IO.println s!"pub const {ProfileField.rustName field.spec.name}: usize = {field.offset};"
  IO.println s!"pub const INITIALIZE_PROTOCOL_INFRASTRUCTURE_BYTES_V1: usize = {initializeBytes};"
  emitBytes "INITIALIZE_PROTOCOL_INFRASTRUCTURE_MAGIC_V1" initializeMagic
  for field in initializeLayout do
    IO.println s!"pub const {InitializeField.rustName field.spec.name}: usize = {field.offset};"
