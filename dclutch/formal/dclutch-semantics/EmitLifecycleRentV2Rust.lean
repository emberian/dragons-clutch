import DClutchSemantics.LifecycleRentV2Abi
import DClutchSemantics.Codec
import DClutchSemantics.RustEmit

open DClutch.RustEmit (rustByte)

/-! Emit the lifecycle rent V2 ABI as Rust.

Thirty offsets, six widths, three magics, two seed domains and the action
alphabet, none of which had an author outside the crate that used them. -/

open DClutch
open DClutch.LifecycleRentV2Abi

def emitMagic (name doc : String) (value : List UInt8) : IO Unit := do
  IO.println s!"/// {doc}"
  IO.println s!"pub const {name}: [u8; {value.length}] ="
  IO.println s!"    [{String.intercalate ", " (value.map rustByte)}];"

def emitDomain (name doc value : String) : IO Unit := do
  IO.println s!"/// {doc}"
  IO.println s!"pub const {name}: &[u8] = b\"{value}\";"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitLifecycleRentV2Rust.lean; do not edit."
  IO.println "/// Implemented lifecycle rent schema version, shared by every record."
  IO.println s!"pub const LIFECYCLE_RENT_SCHEMA_VERSION_V2: u16 = {version};"
  IO.println "/// Persisted Market-scoped credit width."
  IO.println s!"pub const LIFECYCLE_RENT_CREDIT_BYTES_V2: usize = {stateBytes};"
  IO.println "/// Shared instruction prologue width."
  IO.println s!"pub const LIFECYCLE_RENT_INSTRUCTION_HEADER_BYTES_V2: usize = {instructionHeaderBytes};"
  IO.println "/// Create request width."
  IO.println s!"pub const CREATE_LIFECYCLE_RENT_CREDIT_BYTES_V2: usize = {createBytes};"
  IO.println "/// Sweep request width."
  IO.println s!"pub const SWEEP_LIFECYCLE_RENT_CREDIT_BYTES_V2: usize = {sweepBytes};"
  IO.println "/// Close request width: the prologue plus one Core retirement receipt."
  IO.println s!"pub const CLOSE_LIFECYCLE_RENT_CREDIT_BYTES_V2: usize = {closeBytes};"
  IO.println "/// Close receipt width."
  IO.println s!"pub const LIFECYCLE_RENT_CLOSE_RECEIPT_BYTES_V2: usize = {receiptBytes};"
  emitMagic "LIFECYCLE_RENT_CREDIT_MAGIC_V2" "Canonical persisted credit magic." creditMagic
  emitMagic "LIFECYCLE_RENT_INSTRUCTION_MAGIC_V2" "Canonical instruction magic." instructionMagic
  emitMagic "LIFECYCLE_RENT_CLOSE_RECEIPT_MAGIC_V2" "Canonical close-receipt magic."
    closeReceiptMagic
  emitDomain "LIFECYCLE_RENT_CREDIT_PDA_DOMAIN_V2"
    "Credit PDA seed domain: `[domain, market, release_set]`." creditPdaDomain
  emitDomain "LIFECYCLE_RENT_CORE_CLOSE_AUTHORITY_DOMAIN_V2"
    "Core-close authority seed domain: `[domain, market, release_set]`." coreCloseAuthorityDomain
  for action in Action.all do
    IO.println s!"/// {Action.doc action}"
    IO.println s!"pub const {Action.rustName action}: u8 = {Action.tag action};"
  for field in StateField.all do
    IO.println s!"pub(crate) const {StateField.rustName field}: usize = {StateField.offset field};"
  IO.println s!"pub(crate) const STATE_RESERVED_HEADER_BYTES: usize = {StateField.width .reservedHeader};"
  IO.println s!"pub(crate) const STATE_RESERVED_BODY_BYTES: usize = {StateField.width .reservedBody};"
  for field in InstructionField.all do
    IO.println s!"pub(crate) const {InstructionField.rustName field}: usize = {InstructionField.offset field};"
  IO.println s!"pub(crate) const INSTRUCTION_RESERVED_BYTES: usize = {InstructionField.width .reserved};"
  for field in CreateField.body do
    IO.println s!"pub(crate) const {CreateField.rustName field}: usize = {CreateField.offset field};"
  IO.println s!"pub(crate) const CREATE_RESERVED_BYTES: usize = {CreateField.width .createReserved};"
  for field in SweepField.body do
    IO.println s!"pub(crate) const {SweepField.rustName field}: usize = {SweepField.offset field};"
  for field in CloseField.body do
    IO.println s!"pub(crate) const {CloseField.rustName field}: usize = {CloseField.offset field};"
  for field in ReceiptField.all do
    IO.println s!"pub(crate) const {ReceiptField.rustName field}: usize = {ReceiptField.offset field};"
  IO.println s!"pub(crate) const RECEIPT_RESERVED_HEADER_BYTES: usize = {ReceiptField.width .reservedHeader};"
