import DClutchSemantics.RequestProfileV4Abi

/-! Emit the Lean-owned RequestProfile V4 wire constants. -/

open DClutch
open DClutch.RequestProfileV4Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (name : String) (value : List UInt8) : IO Unit := do
  IO.println s!"pub const {name}: [u8; {value.length}] = ["
  IO.println s!"    {String.intercalate ", " (value.map rustByte)},"
  IO.println "];"

def emitSlice (name : String) (value : List UInt8) : IO Unit := do
  IO.println s!"pub const {name}: &[u8] = &["
  IO.println s!"    {String.intercalate ", " (value.map rustByte)},"
  IO.println "];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitRequestProfileV4AbiRust.lean; do not edit."
  IO.println s!"pub const REQUEST_PROFILE_V4_HEADER_BYTES: usize = {headerBytes};"
  IO.println s!"pub const REQUEST_PROFILE_V4_ROW_OPERATION_BYTES: usize = {rowOperationBytes};"
  IO.println s!"pub const REQUEST_PROFILE_V4_MAX_BYTES: usize = {finalizedRecordMaxBytes};"
  IO.println s!"pub const REQUEST_PROFILE_V4_MAX_ROWS: u32 = {maxRows};"
  IO.println s!"pub const REQUEST_PROFILE_V4_MAX_ROW_BYTES: u32 = {maxRowBytes};"
  IO.println s!"pub const REQUEST_PROFILE_V4_SCHEMA_VERSION: u16 = {schemaVersion};"
  IO.println s!"pub const REQUEST_PROFILE_V4_ARTIFACT_PROFILE: u16 = {artifactProfile};"
  emitSlice "REQUEST_PROFILE_V4_SCHEMA_RELEASE_PREIMAGE" schemaReleasePreimage
  emitBytes "REQUEST_PROFILE_V4_SCHEMA_RELEASE_ID" schemaReleaseId
  emitBytes "REQUEST_PROFILE_V4_MAGIC" magic
  for field in headerLayout do
    IO.println s!"pub const {HeaderField.rustName field.spec.name}: usize = {field.offset};"
  for field in rowOperationLayout do
    IO.println s!"pub const {RowOperationField.rustName field.spec.name}: usize = {field.offset};"
  IO.println s!"pub const REQUEST_PROFILE_V4_TARGET_NONE: u8 = {RowTargetKind.none.tag.toNat};"
  IO.println s!"pub const REQUEST_PROFILE_V4_TARGET_SCALAR: u8 = {RowTargetKind.scalar.tag.toNat};"
  IO.println s!"pub const REQUEST_PROFILE_V4_TARGET_IDENTITY: u8 = {RowTargetKind.identity.tag.toNat};"
  IO.println s!"pub const REQUEST_PROFILE_V4_OP_REQUIRE_U8: u8 = {RowOperationKind.requireU8.tag.toNat};"
  IO.println s!"pub const REQUEST_PROFILE_V4_OP_REQUIRE_U16: u8 = {RowOperationKind.requireU16.tag.toNat};"
  IO.println s!"pub const REQUEST_PROFILE_V4_OP_REQUIRE_U32: u8 = {RowOperationKind.requireU32.tag.toNat};"
  IO.println s!"pub const REQUEST_PROFILE_V4_OP_REQUIRE_U64: u8 = {RowOperationKind.requireU64.tag.toNat};"
  IO.println s!"pub const REQUEST_PROFILE_V4_OP_REQUIRE_ZERO: u8 = {RowOperationKind.requireZero.tag.toNat};"
  IO.println s!"pub const REQUEST_PROFILE_V4_OP_PROJECT_U8: u8 = {RowOperationKind.projectU8.tag.toNat};"
  IO.println s!"pub const REQUEST_PROFILE_V4_OP_PROJECT_U16: u8 = {RowOperationKind.projectU16.tag.toNat};"
  IO.println s!"pub const REQUEST_PROFILE_V4_OP_PROJECT_U32: u8 = {RowOperationKind.projectU32.tag.toNat};"
  IO.println s!"pub const REQUEST_PROFILE_V4_OP_PROJECT_U64: u8 = {RowOperationKind.projectU64.tag.toNat};"
  IO.println s!"pub const REQUEST_PROFILE_V4_OP_PROJECT_IDENTITY: u8 = {RowOperationKind.projectIdentity.tag.toNat};"
