import DClutchSemantics.ProductAdmissionV2Abi
import DClutchSemantics.Codec

/-! Emit the Product V2 admission layouts as Rust.

`crates/dclutch-product-runtime-v2-admission/src/lib.rs` wrote all four layouts
as seventeen bare constants, six of which were not constants at all but
`offset + 32`, `offset + 64` and `offset + 96` spelled twice inside
`decode_coordinate` and `encode_coordinate`. Everything below is a placement. -/

open DClutch
open DClutch.ProductAdmissionV2Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitConst (name kind value doc : String) : IO Unit := do
  IO.println s!"/// {doc}"
  IO.println s!"pub const {name}: {kind} = {value};"

def emitDigest (name doc : String) (value : List UInt8) : IO Unit := do
  IO.println s!"/// {doc}"
  IO.println s!"pub const {name}: [u8; {value.length}] = ["
  for line in List.range ((value.length + 7) / 8) do
    let chunk := (value.drop (line * 8)).take 8
    IO.println s!"    {String.intercalate ", " (chunk.map rustByte)},"
  IO.println "];"

def emitPreimage (name doc value : String) : IO Unit := do
  IO.println s!"/// {doc}"
  IO.println s!"pub const {name}: &[u8] = b\"{value}\";"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitProductAdmissionV2Rust.lean; do not edit."
  emitConst "ADMISSION_VERSION_V2" "u16" (toString version)
    "Shared admission wire version."
  emitConst "ADMISSION_RECORD_COUNT_V2" "u8" (toString recordCount)
    "Number of finalized records in one complete admission."
  emitPreimage "ADMISSION_RECEIPT_PDA_DOMAIN_V2"
    "Admission-program PDA domain for one exact reference-only receipt."
    receiptPdaDomain
  emitConst "PRODUCT_RECORD_BYTES_V2" "usize" (toString bodyBytes)
    "Exact Product record width."
  emitConst "ADMISSION_REQUEST_BYTES_V2" "usize" (toString bodyBytes)
    "Exact admission request width: the Product record's shape, reused."
  emitConst "ADMISSION_RECEIPT_BYTES_V2" "usize" (toString receiptBytes)
    "Exact reference-only receipt width."
  emitConst "RECORD_COORDINATE_BYTES" "usize" (toString coordinateBytes)
    "Exact width of one finalized-record coordinate."
  emitDigest "PRODUCT_RECORD_MAGIC_V2" "Canonical Product record magic."
    productRecordMagic
  emitDigest "ADMISSION_REQUEST_MAGIC_V2" "Canonical admission request magic."
    requestMagic
  emitDigest "ADMISSION_RECEIPT_MAGIC_V2" "Canonical reference-only receipt magic."
    receiptMagic
  emitPreimage "PRODUCT_RECORD_SCHEMA_PREIMAGE_V2"
    "Product record schema label hashed into `PRODUCT_RECORD_SCHEMA_ID_V2`."
    productRecordSchemaPreimage
  emitDigest "PRODUCT_RECORD_SCHEMA_ID_V2"
    "SHA-256 of `PRODUCT_RECORD_SCHEMA_PREIMAGE_V2`." productRecordSchemaId
  emitPreimage "RESULT_DOMAIN_SCHEMA_PREIMAGE_V2"
    "Result-domain schema label hashed into `RESULT_DOMAIN_SCHEMA_ID_V2`."
    resultDomainSchemaPreimage
  emitDigest "RESULT_DOMAIN_SCHEMA_ID_V2"
    "SHA-256 of `RESULT_DOMAIN_SCHEMA_PREIMAGE_V2`." resultDomainSchemaId
  emitPreimage "PORTFOLIO_SCHEMA_PREIMAGE_V2"
    "Portfolio schema label hashed into `PORTFOLIO_SCHEMA_ID_V2`."
    portfolioSchemaPreimage
  emitDigest "PORTFOLIO_SCHEMA_ID_V2"
    "SHA-256 of `PORTFOLIO_SCHEMA_PREIMAGE_V2`." portfolioSchemaId
  emitPreimage "ADMISSION_RECEIPT_SCHEMA_PREIMAGE_V2"
    "Reference-only receipt schema label." receiptSchemaPreimage
  emitDigest "ADMISSION_RECEIPT_SCHEMA_ID_V2"
    "SHA-256 of `ADMISSION_RECEIPT_SCHEMA_PREIMAGE_V2`." receiptSchemaId
  IO.println "/// Public byte offset of the Product content identity inside one record."
  IO.println "///"
  IO.println "/// Account-profile generators project the identity from this coordinate; the"
  IO.println "/// hostile decoder remains the authority for accepting the whole record."
  IO.println s!"pub const PRODUCT_RECORD_PRODUCT_ID_OFFSET_V2: usize = {BodyField.offset .first};"
  emitConst "PRODUCT_ID_OFFSET" "usize" (toString (BodyField.offset .first))
    "First identity of the Product record and the request alike."
  emitConst "PRODUCT_DOMAIN_DIGEST_OFFSET" "usize"
    (toString (BodyField.offset .resultDomainDigest))
    "Result-domain digest coordinate, shared by the record and the request."
  emitConst "PRODUCT_PORTFOLIO_DIGEST_OFFSET" "usize"
    (toString (BodyField.offset .portfolioDigest))
    "Portfolio digest coordinate, shared by the record and the request."
  emitConst "ADMISSION_BODY_RESERVED_OFFSET_V2" "usize"
    (toString (BodyField.offset .reserved))
    "Canonical-zero span of the Product record and the request."
  emitConst "ADMISSION_BODY_RESERVED_BYTES_V2" "usize"
    (toString (BodyField.width .reserved))
    "Width of that span: six, one of which the receipt spends on its count."
  for field in ReceiptField.all do
    emitConst (ReceiptField.rustName field) "usize"
      (toString (ReceiptField.offset field)) (ReceiptField.doc field)
  emitConst "ADMISSION_RECEIPT_RESERVED_BYTES_V2" "usize"
    (toString (ReceiptField.width .reserved))
    "Canonical-zero remainder after the receipt takes its count byte."
  for field in CoordinateField.all do
    emitConst (CoordinateField.rustName field) "usize"
      (toString (CoordinateField.offset field)) (CoordinateField.doc field)
