import DClutchSemantics.SeriesExpireFrameV5Abi

/-! Emit the Series Expire V5 account frame as Rust.

The count, the five route windows, every named coordinate, the privileged
representatives and the alias table become projections of one slot list, so
the profile emitter, Trading's pre-Market authenticator, the operator and the
program-test fixture read one author.  Before this emitter the count had two
(`expire_funding_artifacts_v5.rs` said 82, `hot_v3/series_expiry.rs` said 81)
and every commit between them compiled. -/

open DClutch.SeriesExpireFrameV5Abi

def emitConst (name kind value doc : String) : IO Unit := do
  IO.println s!"/// {doc}"
  IO.println s!"pub const {name}: {kind} = {value};"

def natList (values : List Nat) : String :=
  "[" ++ ", ".intercalate (values.map toString) ++ "]"

def pairList (values : List (Nat × Nat)) : String :=
  "[" ++ ", ".intercalate (values.map fun (a, b) => s!"({a}, {b})") ++ "]"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitSeriesExpireFrameV5Rust.lean; do not edit."
  emitConst "SERIES_EXPIRE_FIXED_ACCOUNT_COUNT_V5" "u16" (toString fixedAccountCount)
    "Complete fixed-account width of the Series Expire outer invocation."
  emitConst "SERIES_EXPIRE_TICKET_COORDINATE_V5" "u16" (toString ticketCoordinate)
    "Outer writable Ticket replay representative retained after Expire."
  emitConst "SERIES_EXPIRE_ROUTE_STARTS_V5" "[u16; 5]" (natList routeStarts)
    "Fixed-account start of each of the five authenticated child routes."
  emitConst "SERIES_EXPIRE_ROUTE_COUNTS_V5" "[u16; 5]" (natList routeCounts)
    "Fixed-account width of each of the five authenticated child routes."
  emitConst "SERIES_EXPIRE_FUTURE_MARKET_COORDINATE_V5" "u16" (toString futureMarketCoordinate)
    "The VACANT future occurrence Market: every Custody window's `CoreMarket`, never the fixed Hot Market."
  emitConst "SERIES_EXPIRE_RENT_CREDIT_COORDINATE_V5" "u16" (toString rentCreditCoordinate)
    "Canonical lifecycle RentCredit representative supplied by the second Custody route."
  emitConst "SERIES_EXPIRE_CORE_ROUTE_START_V5" "u16" (toString coreRouteStart)
    "Start of Core's unallocated-permit precommit window."
  emitConst "SERIES_EXPIRE_CORE_ROUTE_COUNT_V5" "u16" (toString coreRouteCount)
    "Width of Core's unallocated-permit precommit window: the permissionless 25 plus the caller."
  emitConst "SERIES_EXPIRE_PERMIT_COORDINATE_V5" "u16" (toString permitCoordinate)
    "The still-unallocated, prefunded founding permit Core refunds."
  emitConst "SERIES_EXPIRE_CORE_RENT_CREDIT_COORDINATE_V5" "u16" (toString coreRentCreditCoordinate)
    "Core's alias of the lifecycle RentCredit."
  emitConst "SERIES_EXPIRE_RENT_PROGRAM_COORDINATE_V5" "u16" (toString rentProgramCoordinate)
    "The Rent program that owns the RentCredit."
  emitConst "SERIES_EXPIRE_ROOT_REPLAY_COORDINATE_V5" "u16" (toString rootReplayCoordinate)
    "Core's readonly alias of the outer Series root."
  emitConst "SERIES_EXPIRE_TICKET_REPLAY_COORDINATE_V5" "u16" (toString ticketReplayCoordinate)
    "Core's readonly alias of the outer Ticket replay state."
  emitConst "SERIES_EXPIRE_TEMPLATE_RAW_COORDINATE_V5" "u16" (toString templateRawCoordinate)
    "Core's alias of the Template record, which IS the config raw record."
  emitConst "SERIES_EXPIRE_TEMPLATE_STAGING_COORDINATE_V5" "u16" (toString templateStagingCoordinate)
    "The Template record's vacant staging cursor."
  emitConst "SERIES_EXPIRE_OCCURRENCE_RAW_COORDINATE_V5" "u16" (toString occurrenceRawCoordinate)
    "The finalized occurrence record."
  emitConst "SERIES_EXPIRE_OCCURRENCE_STAGING_COORDINATE_V5" "u16"
    (toString occurrenceStagingCoordinate) "The occurrence record's vacant staging cursor."
  emitConst "SERIES_EXPIRE_TICKET_RAW_COORDINATE_V5" "u16" (toString ticketRawCoordinate)
    "The finalized Ticket record."
  emitConst "SERIES_EXPIRE_TICKET_STAGING_COORDINATE_V5" "u16" (toString ticketStagingCoordinate)
    "The Ticket record's vacant staging cursor."
  emitConst "SERIES_EXPIRE_SYSTEM_PROGRAM_COORDINATE_V5" "u16" (toString systemProgramCoordinate)
    "The System program the permit refund transfers through."
  emitConst "SERIES_EXPIRE_PRECOMMIT_CALLER_COORDINATE_V5" "u16" (toString precommitCallerCoordinate)
    "Outer readonly caller PDA synthesized as a signer only for the Core CPI."
  emitConst "SERIES_EXPIRE_CUSTODY_PROGRAM_COORDINATE_V5" "u16" (toString custodyProgramCoordinate)
    "The activated Custody program: the callee of the four Custody routes, past every window."
  emitConst "SERIES_EXPIRE_WRITABLE_REPRESENTATIVES_V5"
    s!"[u16; {writableRepresentatives.length}]" (natList writableRepresentatives)
    "Coordinates that present their own account with the writable bit."
  emitConst "SERIES_EXPIRE_EXECUTABLE_REPRESENTATIVES_V5"
    s!"[u16; {executableRepresentatives.length}]" (natList executableRepresentatives)
    "Coordinates that present their own account with the executable bit."
  emitConst "SERIES_EXPIRE_ROUTE_ALIASES_V5" s!"[(u16, u16); {routeAliases.length}]"
    (pairList routeAliases)
    "Every route alias and the representative it stands for, in coordinate order."
