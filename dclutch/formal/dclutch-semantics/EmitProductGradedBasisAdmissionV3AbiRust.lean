import DClutchSemantics.ProductGradedBasisAdmissionV3Abi
import DClutchSemantics.RustEmit

open DClutch.RustEmit (emitBytesSkip emitSliceSkip)

open DClutch DClutch.ProductGradedBasisAdmissionV3Abi

def emitOffsets {name : Type} (layout : List (AbiSchema.PlacedField name))
    (rustName : name → String) : IO Unit := do
  for field in layout do
    IO.println s!"pub const {rustName field.spec.name}: usize = {field.offset};"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitProductGradedBasisAdmissionV3AbiRust.lean; do not edit."
  IO.println s!"pub const APPROXIMATION_CERTIFICATE_BYTES_V3: usize = {certificateBytes};"
  IO.println s!"pub const GRADED_BASIS_ADMISSION_BYTES_V3: usize = {admissionBytes};"
  IO.println s!"pub const GRADED_BASIS_REGISTRY_SCHEMA_VERSION_V3: u16 = {schemaVersion};"
  emitBytesSkip "APPROXIMATION_CERTIFICATE_MAGIC_V3" certificateMagic
  emitBytesSkip "GRADED_BASIS_ADMISSION_MAGIC_V3" admissionMagic
  emitSliceSkip "GRADED_BASIS_RECORD_SCHEMA_PREIMAGE_V3" basisSchemaPreimage
  emitBytesSkip "GRADED_BASIS_RECORD_SCHEMA_ID_V3" basisSchemaId
  emitSliceSkip "PRICE_GATE_RECORD_SCHEMA_PREIMAGE_V1" priceGateSchemaPreimage
  emitBytesSkip "PRICE_GATE_RECORD_SCHEMA_ID_V1" priceGateSchemaId
  emitSliceSkip "GRADED_BASIS_CERTIFICATE_SCHEMA_PREIMAGE_V3" certificateSchemaPreimage
  emitBytesSkip "GRADED_BASIS_CERTIFICATE_SCHEMA_ID_V3" certificateSchemaId
  emitSliceSkip "GRADED_BASIS_ADMISSION_SCHEMA_PREIMAGE_V3" admissionSchemaPreimage
  emitBytesSkip "GRADED_BASIS_ADMISSION_SCHEMA_ID_V3" admissionSchemaId
  emitOffsets certificateLayout CertificateField.rustName
  emitOffsets admissionLayout AdmissionField.rustName
