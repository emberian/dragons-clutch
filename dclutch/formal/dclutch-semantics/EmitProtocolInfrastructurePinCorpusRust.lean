import DClutchSemantics.ProtocolInfrastructure

/-! Emit the decision-0012 slot-pin decision-case corpus.

This emits VECTORS, not the rule. `core-sbf/src/infrastructure.rs` keeps its
hand-written mirror; the corpus is what makes the two answerable to each other.
-/

open DClutch
open DClutch.ProtocolInfrastructure

def rustAuthority : Option Identity → String
  | none => "None"
  | some identity => s!"Some({identity})"

def rustPolicyIsImmutable : UpgradePolicy → String
  | .immutable => "true"
  | .exactAuthority => "false"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitProtocolInfrastructurePinCorpusRust.lean; do not edit."
  IO.println "/// One decision-0012 slot-pin case, as Lean decides it."
  IO.println "#[derive(Clone, Copy, Debug, Eq, PartialEq)]"
  IO.println "pub struct SlotPinVectorV1 {"
  IO.println "    /// The Lean theorem or decision case this vector stands for."
  IO.println "    pub name: &'static str,"
  IO.println "    /// Bound upgrade policy: immutable, or one exact named authority."
  IO.println "    pub bound_policy_immutable: bool,"
  IO.println "    /// Authority fill byte the release bound, expanded to 32 bytes."
  IO.println "    pub bound_authority: Option<u8>,"
  IO.println "    /// Deployment slot the release bound."
  IO.println "    pub bound_slot: u64,"
  IO.println "    /// Authority fill byte observed on live ProgramData."
  IO.println "    pub observed_authority: Option<u8>,"
  IO.println "    /// Deployment slot observed on live ProgramData."
  IO.println "    pub observed_slot: u64,"
  IO.println "    /// Whether the release pairing is one of the two canonical shapes."
  IO.println "    pub canonical_release_shape: bool,"
  IO.println "    /// Expected outcome tag: 0 admit, 1 superseded, 2 infrastructure."
  IO.println "    pub outcome: u8,"
  IO.println "}"
  IO.println ""
  IO.println s!"pub const SLOT_PIN_OUTCOME_ADMIT: u8 = {PinOutcome.admit.tag};"
  IO.println s!"pub const SLOT_PIN_OUTCOME_REFUSE_SUPERSEDED: u8 = {PinOutcome.refuseSuperseded.tag};"
  IO.println s!"pub const SLOT_PIN_OUTCOME_REFUSE_INFRASTRUCTURE: u8 = {PinOutcome.refuseInfrastructure.tag};"
  IO.println ""
  IO.println s!"pub const SLOT_PIN_VECTORS_V1: [SlotPinVectorV1; {pinVectors.length}] = ["
  for vector in pinVectors do
    let pin := vector.pin
    IO.println "    SlotPinVectorV1 {"
    IO.println s!"        name: \"{vector.name}\","
    IO.println s!"        bound_policy_immutable: {rustPolicyIsImmutable pin.boundUpgradePolicy},"
    IO.println s!"        bound_authority: {rustAuthority pin.boundUpgradeAuthority},"
    IO.println s!"        bound_slot: {pin.boundDeploymentSlot},"
    IO.println s!"        observed_authority: {rustAuthority pin.observedUpgradeAuthority},"
    IO.println s!"        observed_slot: {pin.observedDeploymentSlot},"
    IO.println s!"        canonical_release_shape: {pin.canonicalReleaseShape},"
    IO.println s!"        outcome: {pin.outcome.tag},"
    IO.println "    },"
  IO.println "];"
