import DClutchSemantics.CustodyAbi
import DClutchSemantics.Codec
import DClutchSemantics.RustEmit

open DClutch.RustEmit (rustByte)

open DClutch DClutch.CustodyAbi

def emitOffset {Name : Type} [DecidableEq Name]
    (rustPrefix : String) (layout : List (AbiSchema.PlacedField Name))
    (name : String) (field : Name) : IO Unit :=
  let offset := ((AbiSchema.coordinate? field layout).getD (0, 0)).1
  IO.println s!"pub(crate) const {rustPrefix}_{name}_OFFSET: usize = {offset};"

def emitMagic (name : String) (value : List UInt8) : IO Unit :=
  IO.println
    s!"pub const {name}: [u8; {value.length}] = [{String.intercalate ", " (value.map rustByte)}];"

def emitDomain (name value : String) : IO Unit :=
  IO.println s!"pub const {name}: &[u8] = b\"{value}\";"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitCustodyAbiRust.lean; do not edit."
  IO.println s!"pub const ABI_VERSION_V1: u16 = {abiVersion};"
  IO.println s!"pub const CUSTODY_REQUEST_BYTES_V1: usize = {requestBytes};"
  IO.println s!"pub const CUSTODY_REPLAY_BYTES_V1: usize = {replayBytes};"
  IO.println s!"pub const CUSTODY_RECEIPT_BYTES_V1: usize = {receiptBytes};"
  emitMagic "CUSTODY_REQUEST_MAGIC_V1" requestMagic
  emitMagic "CUSTODY_REPLAY_MAGIC_V1" replayMagic
  emitMagic "CUSTODY_RECEIPT_MAGIC_V1" receiptMagic
  emitDomain "CUSTODY_AUTHORITY_PDA_DOMAIN_V1" authorityPdaDomain
  emitDomain "CUSTODY_REPLAY_PDA_DOMAIN_V1" replayPdaDomain
  emitDomain "CUSTODY_VAULT_PDA_DOMAIN_V1" vaultPdaDomain
  emitDomain "CUSTODY_POSTSTATE_DOMAIN_V1" poststateDomain
  for compartment in Compartment.all do
    IO.println s!"pub const {Compartment.rustName compartment}: u8 = {Compartment.tag compartment};"
  for (name, field) in [
      ("VERSION", RequestField.version), ("OPERATION", .operation),
      ("CALLER_ROLE", .callerRole), ("SOURCE_COMPARTMENT", .sourceCompartment),
      ("DESTINATION_COMPARTMENT", .destinationCompartment),
      ("TRANSFER_INDEX", .transferIndex), ("RELEASE_SET", .releaseSet),
      ("MARKET", .market), ("REALM", .realm), ("CONTEXT", .context),
      ("CALLER_PROGRAM", .callerProgram), ("CANDIDATE", .candidate),
      ("SOURCE_OWNER", .sourceOwner), ("DESTINATION_OWNER", .destinationOwner),
      ("ORDER", .order),
      ("PARENT_REQUEST_DIGEST", .parentRequestDigest), ("SOURCE", .source),
      ("DESTINATION", .destination), ("SOURCE_VAULT_CONTEXT", .sourceVaultContext),
      ("DESTINATION_VAULT_CONTEXT", .destinationVaultContext), ("MINT", .mint),
      ("TOKEN_PROGRAM", .tokenProgram), ("PAYER", .payer),
      ("RENT_REFUND", .rentRefund), ("EXPECTED_REVISION", .expectedRevision),
      ("RESULTING_REVISION", .resultingRevision), ("ORDER_NONCE", .orderNonce),
      ("GENERATION", .generation), ("AMOUNT", .amount),
      ("RENT_LAMPORTS", .rentLamports), ("PAGE_INDEX", .pageIndex),
      ("EXECUTION_INDEX", .executionIndex), ("RESERVED", .reserved)] do
    emitOffset "REQUEST" requestLayout name field
  for (name, field) in [
      ("VERSION", ReplayField.version), ("STATUS", .status),
      ("CALLER_ROLE", .callerRole), ("OPEN_VAULT_COUNT", .openVaultCount),
      ("RELEASE_SET", .releaseSet), ("MARKET", .market), ("REALM", .realm),
      ("CONTEXT", .context), ("CALLER_PROGRAM", .callerProgram),
      ("RENT_REFUND", .rentRefund), ("NEXT_REVISION", .nextRevision),
      ("GENERATION", .generation), ("LAST_REQUEST_DIGEST", .lastRequestDigest),
      ("LAST_POSTSTATE_COMMITMENT", .lastPoststateCommitment)] do
    emitOffset "REPLAY" replayLayout name field
  for (name, field) in [
      ("VERSION", ReceiptField.version), ("OPERATION", .operation),
      ("CALLER_ROLE", .callerRole), ("SOURCE_COMPARTMENT", .sourceCompartment),
      ("DESTINATION_COMPARTMENT", .destinationCompartment),
      ("TRANSFER_INDEX", .transferIndex), ("RELEASE_SET", .releaseSet),
      ("MARKET", .market), ("CONTEXT", .context),
      ("PARENT_REQUEST_DIGEST", .parentRequestDigest),
      ("REQUEST_DIGEST", .requestDigest), ("SOURCE", .source),
      ("DESTINATION", .destination), ("EXPECTED_REVISION", .expectedRevision),
      ("RESULTING_REVISION", .resultingRevision), ("SOURCE_BEFORE", .sourceBefore),
      ("SOURCE_AFTER", .sourceAfter), ("DESTINATION_BEFORE", .destinationBefore),
      ("DESTINATION_AFTER", .destinationAfter), ("AMOUNT", .amount),
      ("RENT_LAMPORTS", .rentLamports),
      ("POSTSTATE_COMMITMENT", .poststateCommitment),
      ("REPLAY_STATE_DIGEST", .replayStateDigest), ("RESERVED", .reserved)] do
    emitOffset "RECEIPT" receiptLayout name field
