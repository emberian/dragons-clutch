import DClutchSemantics.AccountProfileV2Abi
import DClutchSemantics.RustEmit

open DClutch.RustEmit (emitBytes emitSlice)

/-! Emit the Lean-owned AccountProfile V2 fixed ABI: identity, artifact
profiles, header cut points, record layouts, opcodes and tag vocabularies. -/

open DClutch
open DClutch.AccountProfileV2Abi

def emitUsize (name : String) (value : Nat) : IO Unit :=
  IO.println s!"pub const {name}: usize = {value};"

def emitU16 (name : String) (value : Nat) : IO Unit :=
  IO.println s!"pub const {name}: u16 = {value};"

def emitU8 (name : String) (value : Nat) : IO Unit :=
  IO.println s!"pub const {name}: u8 = {value};"

def emitBoolMatrix (name : String) (rows : List (List Bool)) : IO Unit := do
  let cols := (rows.head?.map List.length).getD 0
  IO.println s!"pub const {name}: [[bool; {cols}]; {rows.length}] = ["
  for row in rows do
    IO.println s!"    [{String.intercalate ", " (row.map toString)}],"
  IO.println "];"

def emitU8Array (name : String) (values : List Nat) : IO Unit := do
  IO.println s!"pub const {name}: [u8; {values.length}] = ["
  IO.println s!"    {String.intercalate ", " (values.map toString)},"
  IO.println "];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitAccountProfileV2AbiRust.lean; do not edit."
  emitBytes "ACCOUNT_PROFILE_V2_MAGIC" magic
  emitU16 "ACCOUNT_PROFILE_V2_VERSION" schemaVersion
  emitSlice "ACCOUNT_PROFILE_V2_SCHEMA_RELEASE_PREIMAGE" schemaReleasePreimage
  emitBytes "ACCOUNT_PROFILE_V2_SCHEMA_RELEASE_ID" schemaReleaseId

  emitU16 "ACCOUNT_PROFILE_V2_ARTIFACT_PROFILE" artifactProfile
  emitU16 "ACCOUNT_PROFILE_V2_SELECTED_WINDOW_ARTIFACT_PROFILE" selectedWindowArtifactProfile
  emitU16 "ACCOUNT_PROFILE_V2_TYPED_SCALAR_ARTIFACT_PROFILE" typedScalarArtifactProfile
  emitU16 "ACCOUNT_PROFILE_V2_TRUSTED_ENVIRONMENT_ARTIFACT_PROFILE" trustedEnvironmentArtifactProfile
  emitU16 "ACCOUNT_PROFILE_V2_LIFECYCLE_PRESTATE_ARTIFACT_PROFILE" lifecyclePrestateArtifactProfile
  emitU16 "ACCOUNT_PROFILE_V2_ADAPTER_AUTHENTICATED_VARIABLE_DATA_ARTIFACT_PROFILE"
    adapterAuthenticatedVariableDataArtifactProfile
  emitU16 "ACCOUNT_PROFILE_V2_TRUSTED_EXECUTING_PROGRAM_ARTIFACT_PROFILE"
    trustedExecutingProgramArtifactProfile
  emitU16 "ACCOUNT_PROFILE_V2_ADAPTER_AUTHENTICATED_VARIABLE_DATA_ALIAS_ARTIFACT_PROFILE"
    adapterAuthenticatedVariableDataAliasArtifactProfile
  emitU16 "ACCOUNT_PROFILE_V2_NONZERO_U64_TAIL_COUNT_ARTIFACT_PROFILE"
    nonzeroU64TailCountArtifactProfile
  emitU16 "ACCOUNT_PROFILE_V2_AUTHENTICATED_ROUTE_ALIAS_ARTIFACT_PROFILE"
    authenticatedRouteAliasArtifactProfile
  emitU16 "ACCOUNT_PROFILE_V2_NONZERO_U64_TAIL_ROWS_ARTIFACT_PROFILE"
    nonzeroU64TailRowsArtifactProfile
  emitU16 "ACCOUNT_PROFILE_V2_DYNAMIC_FIXED_SPAN_ARTIFACT_PROFILE"
    dynamicFixedSpanArtifactProfile

  emitUsize "ACCOUNT_PROFILE_V2_HEADER_BYTES" headerBytes
  emitUsize "ACCOUNT_PROFILE_V2_TRUSTED_EXECUTING_PROGRAM_HEADER_BYTES"
    trustedExecutingProgramHeaderBytes
  emitUsize "ACCOUNT_PROFILE_V2_AUTHENTICATED_ROUTE_ALIAS_HEADER_BYTES"
    authenticatedRouteAliasHeaderBytes
  emitUsize "ACCOUNT_PROFILE_V2_DYNAMIC_FIXED_SPAN_HEADER_BYTES"
    dynamicFixedSpanHeaderBytes
  emitUsize "ACCOUNT_RULE_V2_BYTES" ruleBytes
  emitUsize "ACCOUNT_OPERATION_V2_BYTES" operationBytes
  emitUsize "DYNAMIC_FIXED_SPAN_V2_ENTRY_BYTES" dynamicSpanEntryBytes

  for field in headerLayout do
    emitUsize (HeaderField.rustName field.spec.name) field.offset
  for field in ruleLayout do
    emitUsize (RuleField.rustName field.spec.name) field.offset
  for field in operationLayout do
    emitUsize (OperationField.rustName field.spec.name) field.offset
  for field in dynamicSpanLayout do
    emitUsize (DynamicSpanField.rustName field.spec.name) field.offset

  for kind in operationKinds do
    emitU8 (OperationKind.rustName kind) (OperationKind.tag kind)

  emitU8 "ACCOUNT_PROFILE_V2_TRUSTED_ENVIRONMENT_NONE" trustedEnvironmentNone
  emitU8 "ACCOUNT_PROFILE_V2_TRUSTED_ENVIRONMENT_CURRENT_SLOT" trustedEnvironmentCurrentSlot
  emitU8 "ACCOUNT_PROFILE_V2_TRUSTED_EXECUTING_PROGRAM_NONE" trustedExecutingProgramNone
  emitU8 "ACCOUNT_PROFILE_V2_TRUSTED_EXECUTING_PROGRAM_CURRENT" trustedExecutingProgramCurrent
  emitU8 "ACCOUNT_PROFILE_V2_TRUSTED_BUILTIN_NONE" trustedBuiltinNone
  emitU8 "ACCOUNT_PROFILE_V2_TRUSTED_BUILTIN_SYSTEM_PROGRAM" trustedBuiltinSystemProgram
  emitU8 "ACCOUNT_ALIAS_V2_SELF_COORDINATE" aliasSelfCoordinate
  emitU8 "ACCOUNT_ALIAS_V2_FIXED" aliasFixed
  emitU8 "ACCOUNT_ALIAS_V2_SAME_ITEM" aliasSameItem
  emitU8 "ACCOUNT_REGISTER_SPACE_V2_COMMON" registerSpaceCommon
  emitU8 "ACCOUNT_REGISTER_SPACE_V2_ITEM" registerSpaceItem
  emitU8 "ACCOUNT_PRESTATE_V2_EXACT" prestateExact
  emitU8 "ACCOUNT_PRESTATE_V2_LIFECYCLE_BOUND" prestateLifecycleBound
  emitU8 "ACCOUNT_PRESTATE_V2_ADAPTER_AUTHENTICATED_VARIABLE_DATA"
    prestateAdapterAuthenticatedVariableData
  emitU8 "ACCOUNT_PRESTATE_V2_ADAPTER_AUTHENTICATED_VARIABLE_DATA_ALIAS"
    prestateAdapterAuthenticatedVariableDataAlias
  emitU8 "ACCOUNT_PRESTATE_V2_AUTHENTICATED_ROUTE_ALIAS" prestateAuthenticatedRouteAlias
  emitU8 "ACCOUNT_PRESTATE_V2_AUTHENTICATED_OPAQUE_READONLY_DATA"
    prestateAuthenticatedOpaqueReadonlyData

  emitU16 "ACCOUNT_PRESTATE_V2_MIN_ARTIFACT_PROFILE" artifactProfile
  emitUsize "ACCOUNT_PRESTATE_V2_TAG_COUNT" prestateTags.length
  emitU8 "ACCOUNT_PRESTATE_V2_REFUSAL_NON_CANONICAL_RESERVED"
    PrestateRefusal.nonCanonicalReserved.tag
  emitU8 "ACCOUNT_PRESTATE_V2_REFUSAL_INVALID_LIFECYCLE_PRESTATE"
    PrestateRefusal.invalidLifecyclePrestate.tag
  emitU8 "ACCOUNT_PRESTATE_V2_REFUSAL_INVALID_VARIABLE_DATA_PRESTATE"
    PrestateRefusal.invalidVariableDataPrestate.tag
  emitBoolMatrix "ACCOUNT_PRESTATE_V2_ADMISSIBLE" admissibilityRows
  emitU8Array "ACCOUNT_PRESTATE_V2_REFUSAL_CLASS" refusalClasses
