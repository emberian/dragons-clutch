import DClutchSemantics.CapabilityProgramSetV2
import DClutchSemantics.RustEmit

open DClutch.RustEmit (rustByte emitBytes emitSlice)

/-! Emit the Lean-owned Capability Program Set V2 ABI and hostile corpus. -/

open DClutch
open DClutch.AbiSchema
open DClutch.CapabilityProgramSetV2

def emitHostileCorpus : IO Unit := do
  IO.println "#[cfg(test)]"
  IO.println s!"pub const CAPABILITY_PROGRAM_SET_HOSTILE_CORPUS_V2: [[u8; {canonicalExample.length}]; {hostileCorpus.length}] = ["
  for bytes in hostileCorpus do
    IO.println "    ["
    IO.println s!"        {String.intercalate ", " (bytes.map rustByte)},"
    IO.println "    ],"
  IO.println "];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitCapabilityProgramSetV2Rust.lean; do not edit."
  IO.println s!"pub const CAPABILITY_PROGRAM_SET_HEADER_BYTES_V2: usize = {headerBytes};"
  IO.println s!"pub const CAPABILITY_PROGRAM_SET_ENTRY_BYTES_V2: usize = {entryBytes};"
  IO.println s!"pub const CAPABILITY_PROGRAM_SET_MAX_BYTES_V2: usize = {maxBytes};"
  IO.println s!"pub const CAPABILITY_PROGRAM_SET_MAX_ENTRIES_V2: usize = {maxEntries};"
  IO.println s!"pub const CAPABILITY_PROGRAM_SET_SCHEMA_VERSION_V2: u16 = {schemaVersion};"
  IO.println s!"pub const CAPABILITY_PROGRAM_SET_ARTIFACT_PROFILE_V2: u16 = {artifactProfile};"
  IO.println s!"pub const CAPABILITY_PROGRAM_SET_CANONICAL_ENDIAN_V2: u8 = {canonicalEndian};"
  emitBytes "CAPABILITY_PROGRAM_SET_MAGIC_V2" magic
  emitSlice "CAPABILITY_PROGRAM_SET_SCHEMA_RELEASE_PREIMAGE_V2" schemaReleasePreimage
  emitBytes "CAPABILITY_PROGRAM_SET_SCHEMA_RELEASE_ID_V2" schemaReleaseId
  for field in headerLayout do
    IO.println s!"pub const {HeaderField.rustName field.spec.name}: usize = {field.offset};"
  for field in entryLayout do
    IO.println s!"pub const {EntryField.rustName field.spec.name}: usize = {field.offset};"
  IO.println "#[cfg(test)]"
  emitBytes "CAPABILITY_PROGRAM_SET_EXAMPLE_V2" canonicalExample
  emitHostileCorpus
