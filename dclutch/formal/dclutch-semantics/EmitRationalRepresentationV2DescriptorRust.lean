import DClutchSemantics.RationalRepresentationV2PhysicalAbi
import DClutchSemantics.Codec
import DClutchSemantics.RustEmit

open DClutch.RustEmit (emitBytes)

open DClutch
open DClutch.RationalRepresentationV2PhysicalAbi

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitRationalRepresentationV2DescriptorRust.lean; do not edit."
  emitBytes "DESCRIPTOR_MAGIC_V3" [0x44, 0x43, 0x52, 0x52, 0x44, 0x53, 0x43, 0x33]
  IO.println s!"pub const DESCRIPTOR_SCHEMA_VERSION_V3: u16 = {descriptorVersion};"
  IO.println s!"pub const DESCRIPTOR_HEADER_BYTES: usize = {descriptorHeaderBytes};"
  IO.println s!"pub const DESCRIPTOR_COEFFICIENT_BYTES: usize = {descriptorCoefficientBytes};"
  for field in DescriptorField.all do
    IO.println s!"pub const {DescriptorField.rustName field}: usize = {DescriptorField.offset field};"
