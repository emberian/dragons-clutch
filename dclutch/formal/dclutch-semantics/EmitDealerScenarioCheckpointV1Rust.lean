import DClutchSemantics.DealerScenarioCheckpointV1Abi
import DClutchSemantics.Codec

/-! Emit the Dealer scenario checkpoint's layout and tag ABI as Rust.

The five `DealerScenarioCheckpointPhaseV1` discriminants, the byte they are
persisted at, the record's magic and width, the two digest runs' lengths and
every coordinate in it.  Before this emitter all of them were
`scenario_checkpoint_v1.rs`'s -- a file-private block of thirty-one
`const *_OFFSET: usize`, which is a second offset table that agrees with the
record only by inspection. -/

open DClutch
open DClutch.DealerScenarioCheckpointV1Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitConst (name kind value doc : String) : IO Unit := do
  IO.println s!"/// {doc}"
  IO.println s!"pub const {name}: {kind} = {value};"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitDealerScenarioCheckpointV1Rust.lean; do not edit."
  IO.println "/// Canonical checkpoint magic: `DCLTDSC1`."
  -- One line, with formatting suppressed, because the SDK's state-machine
  -- generator reads a record magic with a single-line regex.
  IO.println "#[rustfmt::skip]"
  IO.println s!"pub const DEALER_SCENARIO_CHECKPOINT_MAGIC_V1: [u8; {magic.length}] = [{String.intercalate ", " (magic.map rustByte)}];"
  emitConst "DEALER_SCENARIO_CHECKPOINT_BYTES_V1" "usize" (toString checkpointBytes)
    "Exact checkpoint account-data width."
  emitConst "DEALER_SCENARIO_CHECKPOINT_VERSION_V1" "u16" (toString schemaVersion)
    "Implemented checkpoint schema version."
  for phase in Phase.all do
    emitConst (Phase.rustName phase) "u8" (toString (Phase.tag phase))
      (Phase.doc phase)
  emitConst "DEALER_SCENARIO_CHECKPOINT_PHASE_LIMIT_V1" "u8" (toString phaseLimit)
    "One past the greatest phase tag; the machine numbers from one, so bit zero is never occupied."
  emitConst "DEALER_SCENARIO_PREPARATION_PAGES_V1" "usize" (toString preparationPages)
    "Maximum canonical preparation pages for one Dealer scenario."
  emitConst "DEALER_SCENARIO_CHECKPOINT_RESERVATION_SLOTS_V1" "usize"
    (toString reservationSlots)
    "Reservation receipt slots this record carries, one per admissible effect."
  emitConst "DEALER_SCENARIO_CHECKPOINT_DIGEST_BYTES_V1" "usize" (toString digestBytes)
    "Width of one digest or content identity in this record."
  emitConst "DEALER_SCENARIO_CHECKPOINT_PAGE_RECEIPT_DIGESTS_BYTES_V1" "usize"
    (toString (Field.width .pageReceiptDigests))
    "Width of the whole page receipt run: the page count times the digest width."
  emitConst "DEALER_SCENARIO_CHECKPOINT_RESERVATION_RECEIPT_DIGESTS_BYTES_V1" "usize"
    (toString (Field.width .reservationReceiptDigests))
    "Width of the whole reservation receipt run, which closes the record."
  emitConst "DEALER_SCENARIO_CHECKPOINT_CLOCK_OFFSET_V1" "usize" (toString clockOffset)
    "Where the four lifecycle words begin: the width of the header in front of them."
  emitConst "DEALER_SCENARIO_CHECKPOINT_INPUT_OFFSET_V1" "usize" (toString inputOffset)
    "Where the scenario's identities and prestates begin."
  emitConst "DEALER_SCENARIO_CHECKPOINT_EVALUATION_OFFSET_V1" "usize"
    (toString evaluationOffset)
    "Where the admitted evaluation's commitments begin."
  for field in Field.all do
    emitConst (Field.rustName field) "usize" (toString (Field.offset field))
      (Field.doc field)
