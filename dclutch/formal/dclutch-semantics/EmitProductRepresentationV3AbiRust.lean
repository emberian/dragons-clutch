import DClutchSemantics.ProductRepresentationV3Abi
import DClutchSemantics.Codec

open DClutch
open DClutch.ProductRepresentationV3Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (name : String) (value : List UInt8) : IO Unit :=
  IO.println s!"pub const {name}: [u8; {value.length}] = [{String.intercalate ", " (value.map rustByte)}];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitProductRepresentationV3AbiRust.lean; do not edit."
  IO.println "#[rustfmt::skip]"
  emitBytes "PRODUCT_REPRESENTATION_ADMISSION_MAGIC_V3" magic
  IO.println s!"pub const PRODUCT_REPRESENTATION_ADMISSION_VERSION_V3: u16 = {version};"
  IO.println s!"pub const PRODUCT_REPRESENTATION_ADMISSION_BYTES_V3: usize = {bytes};"
  IO.println s!"pub const PRODUCT_REPRESENTATION_CATEGORICAL_KIND_V3: u8 = {categoricalKind};"
  IO.println s!"pub const PRODUCT_REPRESENTATION_GRADED_KIND_V3: u8 = {gradedKind};"
  for field in Field.all do
    IO.println s!"pub const {Field.rustName field}: usize = {Field.offset field};"
