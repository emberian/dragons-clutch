import DClutchSemantics.ClaimsLiabilityBasisStateV2Abi
import DClutchSemantics.Codec
import DClutchSemantics.RustEmit

open DClutch.RustEmit (rustByte)

/-! Emit the Claims LiabilityBasisV2 state ABI as Rust.

The crate declared itself the sole owner of these layouts and then wrote sixteen
offsets as decimal literals, with the five prologue coordinates written as bare
arguments inside `require_prefix`, the encoder and `require_zero`. Everything
below is a placement now. -/

open DClutch
open DClutch.ClaimsLiabilityBasisStateV2Abi

def emitMagic (name doc : String) (value : List UInt8) : IO Unit := do
  IO.println s!"/// {doc}"
  IO.println s!"pub const {name}: [u8; {value.length}] ="
  IO.println s!"    [{String.intercalate ", " (value.map rustByte)}];"

def emitSeed (name doc value : String) : IO Unit := do
  IO.println s!"/// {doc}"
  IO.println s!"pub const {name}: &[u8] = b\"{value}\";"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitClaimsLiabilityBasisStateV2Rust.lean; do not edit."
  IO.println "/// Implemented state ABI version, shared by both records."
  IO.println s!"pub const LIABILITY_BASIS_STATE_VERSION_V2: u16 = {version};"
  IO.println "/// Aggregate header bytes before the `u64[claim_count]` supplies."
  IO.println s!"pub const LIABILITY_BASIS_MARKET_HEADER_BYTES_V2: usize = {marketHeaderBytes};"
  IO.println "/// Position header bytes before the `u64[claim_count]` balances."
  IO.println s!"pub const LIABILITY_BASIS_POSITION_HEADER_BYTES_V2: usize = {positionHeaderBytes};"
  IO.println "/// One claim atom in either runtime tail: a little-endian `u64`."
  IO.println s!"pub const LIABILITY_BASIS_CLAIM_STRIDE_V2: usize = {claimStride};"
  emitMagic "LIABILITY_BASIS_MARKET_MAGIC_V2" "Canonical aggregate magic." marketMagic
  emitMagic "LIABILITY_BASIS_POSITION_MAGIC_V2" "Canonical Position magic." positionMagic
  emitSeed "LIABILITY_BASIS_MARKET_SEED_V2"
    "Canonical Claims aggregate PDA seed domain: `[seed, logical_market]`." marketSeed
  emitSeed "LIABILITY_BASIS_POSITION_SEED_V2"
    "Canonical Position PDA seed domain: `[seed, aggregate, owner]`." positionSeed
  IO.println "/// Offset of the aggregate's own canonical PDA bump: the FIRST byte of the"
  IO.println "/// reserved header span. See this module's header for what a zero there means."
  IO.println s!"pub const LIABILITY_BASIS_MARKET_BUMP_OFFSET_V2: usize = {MarketField.rustName .reserved};"
  IO.println "/// Offset of a Position's own canonical PDA bump: the FIRST byte of the"
  IO.println "/// reserved tail span, the same carry the aggregate makes in its header."
  IO.println s!"pub const LIABILITY_BASIS_POSITION_BUMP_OFFSET_V2: usize = {PositionField.rustName .reservedTail};"
  for field in MarketField.all do
    IO.println s!"pub(crate) const {MarketField.rustName field}: usize = {MarketField.offset field};"
  IO.println s!"pub(crate) const MARKET_RESERVED_BYTES: usize = {MarketField.width .reserved};"
  for field in PositionField.all do
    IO.println s!"pub(crate) const {PositionField.rustName field}: usize = {PositionField.offset field};"
  IO.println s!"pub(crate) const POSITION_RESERVED_HEADER_BYTES: usize = {PositionField.width .reservedHeader};"
  IO.println s!"pub(crate) const POSITION_RESERVED_BYTES: usize = {PositionField.width .reservedTail};"
