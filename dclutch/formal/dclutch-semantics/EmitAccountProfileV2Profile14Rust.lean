import DClutchSemantics.AccountProfileV2Profile14

/-! Emit Profile 14's Lean-owned fixed ABI constants. -/

open DClutch
open DClutch.AccountProfileV2Profile14

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (name : String) (value : List UInt8) : IO Unit := do
  IO.println s!"pub const {name}: [u8; {value.length}] = ["
  IO.println s!"    {String.intercalate ", " (value.map rustByte)},"
  IO.println "];"

def emitSlice (name : String) (value : List UInt8) : IO Unit := do
  IO.println s!"pub const {name}: &[u8] = &["
  IO.println s!"    {String.intercalate ", " (value.map rustByte)},"
  IO.println "];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitAccountProfileV2Profile14Rust.lean; do not edit."
  IO.println s!"pub const FIXED_DATA_PREDICATE_ARTIFACT_PROFILE: u16 = {artifactProfile};"
  IO.println s!"pub const FIXED_DATA_PREDICATE_HEADER_BYTES: usize = {headerBytes};"
  IO.println s!"pub const FIXED_DATA_PREDICATE_DYNAMIC_SPAN_ENTRY_BYTES: usize = {dynamicSpanEntryBytes};"
  IO.println s!"pub const FIXED_DATA_PREDICATE_BYTES: usize = {predicateBytes};"
  IO.println s!"pub const FIXED_DATA_PREDICATE_DYNAMIC_SPAN_COUNT_OFFSET: usize = {dynamicSpanCountOffset};"
  IO.println s!"pub const FIXED_DATA_PREDICATE_COUNT_OFFSET: usize = {predicateCountOffset};"
  IO.println s!"pub const FIXED_DATA_PREDICATE_HEADER_RESERVED_OFFSET: usize = {headerReservedOffset};"
  IO.println s!"pub const FIXED_DATA_PREDICATE_REQUIRE_U8: u8 = {PredicateKind.opcode .requireDataU8};"
  IO.println s!"pub const FIXED_DATA_PREDICATE_REQUIRE_U16: u8 = {PredicateKind.opcode .requireDataU16};"
  IO.println s!"pub const FIXED_DATA_PREDICATE_REQUIRE_U32: u8 = {PredicateKind.opcode .requireDataU32};"
  IO.println s!"pub const FIXED_DATA_PREDICATE_REQUIRE_U64: u8 = {PredicateKind.opcode .requireDataU64};"
  IO.println s!"pub const FIXED_DATA_PREDICATE_REQUIRE_ZERO_RANGE: u8 = {PredicateKind.opcode .requireZeroRange};"
  for field in predicateLayout do
    IO.println s!"pub const {PredicateField.rustName field.spec.name}: usize = {field.offset};"
  emitSlice "FIXED_DATA_PREDICATE_PROFILE_PREIMAGE" profilePreimage
  emitBytes "FIXED_DATA_PREDICATE_PROFILE_ID" profileId
