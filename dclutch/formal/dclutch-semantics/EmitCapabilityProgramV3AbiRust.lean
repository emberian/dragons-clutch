import DClutchSemantics.CapabilityProgramV3Abi
import DClutchSemantics.Codec

/-! Emit the Lean-owned fixed Capability Program V3 descriptor layout. -/

open DClutch
open DClutch.AbiSchema
open DClutch.CapabilityProgramV3Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitCapabilityProgramV3AbiRust.lean; do not edit."
  IO.println s!"pub const CAPABILITY_PROGRAM_V3_BYTES: usize = {bytes};"
  IO.println s!"pub const CAPABILITY_PROGRAM_V3_SCHEMA_VERSION: u16 = {schemaVersion};"
  IO.println s!"pub const CAPABILITY_PROGRAM_V3_ARTIFACT_PROFILE: u16 = {artifactProfile};"
  IO.println s!"pub const CAPABILITY_PROGRAM_V3_TRANSITION_SCHEMA_VERSION: u16 = {transitionSchemaVersion};"
  IO.println s!"pub const CAPABILITY_PROGRAM_V3_REQUEST_PROFILE_SCHEMA_VERSION: u16 = {requestProfileSchemaVersion};"
  IO.println s!"pub const CAPABILITY_PROGRAM_V3_MAGIC: [u8; {magic.length}] = ["
  IO.println s!"    {String.intercalate ", " (magic.map rustByte)},"
  IO.println "];"
  for field in layout do
    IO.println s!"pub const {Field.rustName field.spec.name}: usize = {field.offset};"
