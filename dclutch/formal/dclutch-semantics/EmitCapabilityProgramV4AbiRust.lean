import DClutchSemantics.CapabilityProgramV4Abi
import DClutchSemantics.Codec

/-! Emit the Lean-owned fixed Capability Program V4 descriptor layout. -/

open DClutch
open DClutch.AbiSchema
open DClutch.CapabilityProgramV4Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitCapabilityProgramV4AbiRust.lean; do not edit."
  IO.println s!"pub const CAPABILITY_PROGRAM_V4_BYTES: usize = {bytes};"
  IO.println s!"pub const CAPABILITY_PROGRAM_V4_SCHEMA_VERSION: u16 = {schemaVersion};"
  IO.println s!"pub const CAPABILITY_PROGRAM_V4_ARTIFACT_PROFILE: u16 = {artifactProfile};"
  IO.println s!"pub const CAPABILITY_PROGRAM_V4_MAGIC: [u8; {magic.length}] = ["
  IO.println s!"    {String.intercalate ", " (magic.map rustByte)},"
  IO.println "];"
  for field in layout do
    IO.println s!"pub const {Field.rustName field.spec.name}: usize = {field.offset};"
