import DClutchSemantics.SeriesTicketStateV3Abi

/-! Emit the occurrence-ticket replay state's tag ABI as Rust.

The three `TicketPhaseV3` discriminants, the byte they are persisted at, the
record's width and its two canonical-zero spans.  Before this emitter the tags
were `replay.rs`'s alone and the phase coordinate had no name at all -- the SDK
generator recovered it by matching two bare expressions and agreeing, one of
which belonged to `SeriesStateV3` rather than to this record.

The magic is deliberately absent: `SERIES_TICKET_STATE_MAGIC_V3` is emitted by
`EmitSeriesOccurrenceV3Rust.lean` and one fact gets one author.  So are the
schema and profile VALUES, which are the family's; what is emitted here are the
coordinates this record writes them at. -/

open DClutch.SeriesTicketStateV3Abi

def emitConst (name kind value doc : String) : IO Unit := do
  IO.println s!"/// {doc}"
  IO.println s!"pub const {name}: {kind} = {value};"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitSeriesTicketStateV3Rust.lean; do not edit."
  emitConst "SERIES_TICKET_STATE_BYTES_V3" "usize" (toString ticketStateBytes)
    "Exact width of one Trading-owned mutable occurrence-ticket state."
  for phase in Phase.all do
    emitConst (Phase.rustName phase) "u8" (toString (Phase.tag phase))
      (Phase.doc phase)
  emitConst "SERIES_TICKET_PHASE_LIMIT_V3" "u8" (toString phaseLimit)
    "One past the greatest phase tag: every phase indexes its own bit of a `u8`."
  emitConst "SERIES_TICKET_STATE_BODY_OFFSET_V3" "usize" (toString bodyOffset)
    "Where the replay body begins: the width of the shared header in front of it."
  emitConst "SERIES_TICKET_STATE_HEAD_RESERVED_BYTES_V3" "usize"
    (toString (Field.width .headReserved))
    "Width of the canonical-zero span between the phase byte and the revision."
  emitConst "SERIES_TICKET_STATE_TAIL_RESERVED_BYTES_V3" "usize"
    (toString (Field.width .tailReserved))
    "Width of the canonical-zero tail span."
  for field in Field.all do
    emitConst (Field.rustName field) "usize" (toString (Field.offset field))
      (Field.doc field)
