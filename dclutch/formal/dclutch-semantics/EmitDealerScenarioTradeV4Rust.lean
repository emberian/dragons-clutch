import DClutchSemantics.DealerScenarioTradeV4Abi
import DClutchSemantics.Codec

/-! Emit the selector-9 Dealer scenario trade request header as Rust.

`programs/dclutch-trading-sbf/src/dealer/v3_trade.rs` was the author of this
header.  Five of its twenty-eight coordinates had names; the other twenty-three
were bare decimal literals written once in the encoder and once again in the
decoder.  Everything below is a placement now, and the three numbers the Rust
derived by hand -- the selector offset, the selector buffer width, and the
candidate vector's start -- are projections of the layout rather than
independent declarations. -/

open DClutch
open DClutch.DealerScenarioTradeV4Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitConst (name kind value doc : String) : IO Unit := do
  IO.println s!"/// {doc}"
  IO.println s!"pub const {name}: {kind} = {value};"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitDealerScenarioTradeV4Rust.lean; do not edit."
  IO.println "/// Canonical exact-fill request magic: `DCLDST03`."
  IO.println s!"pub const DEALER_SCENARIO_TRADE_MAGIC_V3: [u8; {magic.length}] ="
  IO.println s!"    [{String.intercalate ", " (magic.map rustByte)}];"
  emitConst "DEALER_SCENARIO_TRADE_MAGIC_BYTES_V4" "usize"
    (toString (Field.width .magic))
    "Exact magic width, so a prefix check stops borrowing the version's coordinate."
  emitConst "DEALER_SCENARIO_TRADE_VERSION_V3" "u16" (toString version)
    "Implemented request version. Five, because the header grew by eight bytes."
  emitConst "DEALER_SCENARIO_TRADE_ACTION_V3" "u16" (toString action)
    "Sole exact-fill action in the global Dealer selector space."
  emitConst "DEALER_SCENARIO_TRADE_HEADER_BYTES_V4" "usize" (toString headerBytes)
    "Exact fixed header before the `u64[N]` candidate and SignedDeltaV3 witness."
  emitConst "DEALER_SCENARIO_TRADE_OBLIGATIONS_OFFSET_V4" "usize"
    (toString obligationsOffset)
    "First exact candidate-obligation `u64`: the header's end, and `u64`-aligned."
  emitConst "DEALER_SCENARIO_TRADE_SELECTOR_OFFSET_V3" "u32"
    (toString selectorOffset)
    "Family-neutral CapabilityProgramSet selector offset: the `action` coordinate."
  emitConst "DEALER_SCENARIO_TRADE_SELECTOR_BYTES_V4" "usize"
    (toString selectorBytes)
    "Selector buffer width: exactly this header's magic, version and action."
  emitConst "DEALER_SCENARIO_TRADE_ROUTE_SPAN_COUNT_V4" "usize"
    (toString routeSpanCount)
    "Exact number of optional Custody routes selector 9 can enable."
  emitConst "DEALER_SCENARIO_TRADE_ROUTE_SPAN_WIDTH_V4" "u8"
    (toString routeSpanWidth)
    "One enabled optional Custody route's exact account width, as a request byte."
  emitConst "DEALER_SCENARIO_TRADE_IDENTITY_BYTES_V4" "usize"
    (toString identityBytes)
    "Fixed identity width shared by every address and digest coordinate."
  emitConst "DEALER_SCENARIO_TRADE_CANDIDATE_STRIDE_V4" "usize"
    (toString candidateStride)
    "One candidate obligation in the runtime tail: a little-endian `u64`."
  emitConst "DEALER_SCENARIO_TRADE_RESERVED_BYTES_V4" "usize"
    (toString (Field.width .reserved))
    "Canonical-zero alignment pad: the smallest span that aligns the tail."
  for field in Field.all do
    emitConst (Field.rustName field) "usize" (toString (Field.offset field))
      (Field.doc field)
