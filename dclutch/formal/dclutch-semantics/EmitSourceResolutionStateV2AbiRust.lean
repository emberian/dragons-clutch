import DClutchSemantics.SourceResolutionStateV2Abi

open DClutch DClutch.SourceResolutionStateV2Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (visibility name : String) (value : List UInt8) : IO Unit := do
  IO.println "#[rustfmt::skip]"
  IO.println s!"{visibility} const {name}: [u8; {value.length}] = ["
  for line in List.range ((value.length + 15) / 16) do
    let chunk := (value.drop (line * 16)).take 16
    IO.println s!"    {String.intercalate ", " (chunk.map rustByte)},"
  IO.println "];"

def emitSlice (visibility name : String) (value : List UInt8) : IO Unit := do
  IO.println "#[rustfmt::skip]"
  IO.println s!"{visibility} const {name}: &[u8] = &["
  IO.println s!"    {String.intercalate ", " (value.map rustByte)},"
  IO.println "];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitSourceResolutionStateV2AbiRust.lean; do not edit."
  IO.println s!"pub const SOURCE_RESOLUTION_STATE_V2_BYTES: usize = {bytes};"
  IO.println s!"pub const SOURCE_RESOLUTION_STATE_V2_SCHEMA_VERSION: u16 = {schemaVersion};"
  emitBytes "pub" "SOURCE_RESOLUTION_STATE_V2_MAGIC" magic
  emitSlice "pub" "SOURCE_RESOLUTION_STATE_PDA_DOMAIN_V2_GENERATED" pdaDomain
  for field in layout do
    IO.println s!"pub const {Field.rustName field.spec.name}: usize = {field.offset};"
  for phase in Phase.all do
    IO.println s!"/// {Phase.doc phase}"
    IO.println s!"pub const {Phase.rustName phase}: u8 = {Phase.tag phase};"
  IO.println "/// One past the greatest phase tag."
  IO.println s!"pub const SOURCE_RESOLUTION_PHASE_LIMIT_V1: u8 = {phaseLimit};"
  IO.println "/// The greatest number of funded recovery attempts a market can buy, and"
  IO.println "/// therefore the exclusive bound on the record's `active_attempt` byte."
  IO.println "///"
  IO.println "/// It is the recovery policy's own capacity rather than a second number"
  IO.println "/// chosen beside it: an `active_attempt` the policy cannot fund is an attempt"
  IO.println "/// nothing paid for."
  IO.println s!"pub const SOURCE_RESOLUTION_MAX_RECOVERY_ATTEMPTS_V2: u8 = {maxRecoveryAttempts};"
  IO.println "#[cfg(test)]"
  emitBytes "pub(crate)" "SOURCE_RESOLUTION_STATE_V2_FRESH_EXAMPLE" (encode freshExample)
  IO.println "#[cfg(test)]"
  emitBytes "pub(crate)" "SOURCE_RESOLUTION_STATE_V2_WIDE_TERMINAL_EXAMPLE" (encode wideTerminalExample)
  IO.println "#[cfg(test)]"
  IO.println s!"pub(crate) const SOURCE_RESOLUTION_STATE_V2_REFUSAL_COUNT: usize = {refusalCorpus.length};"
  IO.println "#[cfg(test)]"
  IO.println "#[rustfmt::skip]"
  IO.println s!"pub(crate) const SOURCE_RESOLUTION_STATE_V2_REFUSAL_CORPUS: [[u8; {bytes}]; {refusalCorpus.length}] = ["
  for value in refusalCorpus do
    IO.println "    ["
    for line in List.range ((value.length + 15) / 16) do
      let chunk := (value.drop (line * 16)).take 16
      IO.println s!"        {String.intercalate ", " (chunk.map rustByte)},"
    IO.println "    ],"
  IO.println "];"
