import DClutchSemantics.Codec
import DClutchSemantics.DirectIntentV2Codec

/-! Emit the runtime-width Direct successor signed-intent ABI. -/

open DClutch
open DClutch.DirectIntentV2Codec

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (visibility name : String) (value : List UInt8) : IO Unit := do
  IO.println s!"{visibility} const {name}: [u8; {value.length}] = ["
  for line in List.range ((value.length + 15) / 16) do
    let chunk := (value.drop (line * 16)).take 16
    IO.println s!"    {String.intercalate ", " (chunk.map rustByte)},"
  IO.println "];"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitDirectIntentV2Rust.lean; do not edit."
  IO.println s!"pub const COMPACT_INTENT_VERSION_V2: u16 = {intentVersionV2};"
  IO.println s!"pub const COMPACT_INTENT_BYTES_V2: usize = {compactIntentBytesV2};"
  IO.println s!"pub const COMPACT_INTENT_SIGNED_PREIMAGE_BYTES_V2: usize = {signedPreimageBytesV2};"
  emitBytes "pub" "COMPACT_INTENT_MAGIC_V2" intentMagicV2
  emitBytes "pub" "COMPACT_INTENT_SIGNATURE_DOMAIN_ID_V2" signatureDomainIdV2
  for field in intentLayoutV2 do
    IO.println s!"pub(crate) const {IntentFieldV2.rustName field.spec.name}: usize = {field.offset};"
  IO.println s!"pub const CANCEL_THROUGH_BYTES_V2: usize = {cancelThroughBytesV2};"
  IO.println s!"pub const CANCEL_THROUGH_SIGNED_PREIMAGE_BYTES_V2: usize = {cancelThroughSignedPreimageBytesV2};"
  emitBytes "pub" "CANCEL_THROUGH_MAGIC_V2" cancelThroughMagicV2
  emitBytes "pub" "CANCEL_THROUGH_SIGNATURE_DOMAIN_ID_V2" cancelThroughSignatureDomainIdV2
  for field in cancelThroughLayoutV2 do
    IO.println s!"pub(crate) const {CancelThroughFieldV2.rustName field.spec.name}: usize = {field.offset};"
  IO.println ""
  IO.println "#[cfg(test)]"
  emitBytes "pub(crate)" "COMPACT_INTENT_EXAMPLE_V2" (encodeCompactIntentV2 Examples.intent)
  IO.println "#[cfg(test)]"
  emitBytes "pub(crate)" "COMPACT_INTENT_SIGNED_EXAMPLE_V2" (signedPreimageV2 Examples.intent)
  IO.println "#[cfg(test)]"
  emitBytes "pub(crate)" "CANCEL_THROUGH_EXAMPLE_V2" (encodeCancelThroughV2 Examples.cancelThrough)
  IO.println "#[cfg(test)]"
  emitBytes "pub(crate)" "CANCEL_THROUGH_SIGNED_EXAMPLE_V2"
    (signedCancelThroughPreimageV2 Examples.cancelThrough)
