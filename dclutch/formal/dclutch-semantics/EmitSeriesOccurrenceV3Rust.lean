  emitOffset "SERIES_TEMPLATE_CAPABILITY_TEMPLATE_OFFSET_V3" TemplateOffset.capabilityTemplate
  emitOffset "SERIES_TEMPLATE_PRODUCT_DERIVATION_OFFSET_V3" TemplateOffset.productDerivation
  emitOffset "SERIES_TEMPLATE_OCCURRENCE_DERIVATION_OFFSET_V3" TemplateOffset.occurrenceDerivation
  emitOffset "SERIES_TEMPLATE_CAPABILITY_DERIVATION_OFFSET_V3" TemplateOffset.capabilityDerivation
