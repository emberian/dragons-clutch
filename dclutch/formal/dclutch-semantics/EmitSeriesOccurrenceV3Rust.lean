import DClutchSemantics.SeriesOccurrenceV3Abi

/-!
Emit only the fixed Series V3 record constants and one exact semantic agreement
corpus.  The Rust adapter owns hostile byte decoding and SHA-256/Merkle
physicalization; it does not own a second schedule or occurrence ontology.
-/

open DClutch
open DClutch.SeriesOccurrenceV3
open DClutch.SeriesOccurrenceV3.Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def rustBytes (bytes : List UInt8) : String :=
  s!"[{String.intercalate ", " (bytes.map rustByte)}]"

def emitOffset (name : String) (value : Nat) : IO Unit :=
  IO.println s!"pub const {name}: usize = {value};"

def emitBytes (name : String) (bytes : List UInt8) : IO Unit := do
  IO.println "#[rustfmt::skip]"
  IO.println s!"pub const {name}: [u8; {bytes.length}] = {rustBytes bytes};"

def emitSizedBytes (name sizeName : String) (bytes : List UInt8) : IO Unit := do
  IO.println "#[rustfmt::skip]"
  IO.println s!"pub const {name}: [u8; {sizeName}] = {rustBytes bytes};"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitSeriesOccurrenceV3Rust.lean; do not edit."
  IO.println s!"pub const SERIES_TEMPLATE_SCHEMA_V3: u16 = {schemaVersion};"
  IO.println s!"pub const SERIES_TEMPLATE_PROFILE_V3: u16 = {profile};"
  IO.println s!"pub const SERIES_TEMPLATE_BYTES_V3: usize = {templateBytes};"
  IO.println s!"pub const SERIES_OCCURRENCE_BYTES_V3: usize = {occurrenceBytes};"
  IO.println s!"pub const SERIES_TICKET_BYTES_V3: usize = {ticketBytes};"
  IO.println s!"pub const SERIES_MAXIMUM_MERKLE_HEIGHT_V3: usize = {maximumMerkleHeight};"
  emitBytes "SERIES_TEMPLATE_MAGIC_V3" templateMagic
  emitBytes "SERIES_OCCURRENCE_MAGIC_V3" occurrenceMagic
  emitBytes "SERIES_TICKET_MAGIC_V3" ticketMagic
  emitBytes "SERIES_TEMPLATE_SCHEMA_RELEASE_PREIMAGE_V3" templateSchemaReleasePreimage
  emitBytes "SERIES_TEMPLATE_SCHEMA_RELEASE_ID_V3" templateSchemaReleaseId
  emitBytes "SERIES_OCCURRENCE_SCHEMA_RELEASE_PREIMAGE_V3" occurrenceSchemaReleasePreimage
  emitBytes "SERIES_OCCURRENCE_SCHEMA_RELEASE_ID_V3" occurrenceSchemaReleaseId
  emitBytes "SERIES_TICKET_SCHEMA_RELEASE_PREIMAGE_V3" ticketSchemaReleasePreimage
  emitBytes "SERIES_TICKET_SCHEMA_RELEASE_ID_V3" ticketSchemaReleaseId
  emitBytes "SERIES_TEMPLATE_CONTENT_DOMAIN_V3" templateContentDomain
  emitBytes "SERIES_OCCURRENCE_CONTENT_DOMAIN_V3" occurrenceContentDomain
  emitBytes "SERIES_TICKET_CONTENT_DOMAIN_V3" ticketContentDomain
  emitBytes "SERIES_PROJECTION_NODE_DOMAIN_V3" projectionNodeDomain
  emitBytes "SERIES_FUNDING_LIST_DOMAIN_V3" fundingListDomain
  emitOffset "SERIES_TEMPLATE_OCCURRENCE_COUNT_OFFSET_V3" TemplateOffset.occurrenceCount
  emitOffset "SERIES_TEMPLATE_FIRST_SLOT_OFFSET_V3" TemplateOffset.firstSlot
  emitOffset "SERIES_TEMPLATE_PERIOD_SLOTS_OFFSET_V3" TemplateOffset.periodSlots
  emitOffset "SERIES_TEMPLATE_RETRY_WINDOW_OFFSET_V3" TemplateOffset.retryWindow
  emitOffset "SERIES_TEMPLATE_CLOSE_RENT_OFFSET_V3" TemplateOffset.closeRent
