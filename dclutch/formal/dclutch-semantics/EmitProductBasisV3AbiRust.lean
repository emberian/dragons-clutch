import DClutchSemantics.ProductBasisV3Abi

open DClutch DClutch.ProductBasisV3Abi

def rustByte (byte : UInt8) : String := s!"0x{Codec.byteHex byte}"

def emitBytes (name : String) (value : List UInt8) : IO Unit := do
  IO.println "#[rustfmt::skip]"
  IO.println s!"pub const {name}: [u8; {value.length}] = ["
  for line in List.range ((value.length + 15) / 16) do
    let chunk := (value.drop (line * 16)).take 16
    IO.println s!"    {String.intercalate ", " (chunk.map rustByte)},"
  IO.println "];"

def emitSlice (name : String) (value : List UInt8) : IO Unit := do
  IO.println "#[rustfmt::skip]"
  IO.println s!"pub const {name}: &[u8] = &["
  IO.println s!"    {String.intercalate ", " (value.map rustByte)},"
  IO.println "];"

def emitOffsets {name : Type} (layout : List (AbiSchema.PlacedField name))
    (rustName : name → String) : IO Unit := do
  for field in layout do
    IO.println s!"pub const {rustName field.spec.name}: usize = {field.offset};"

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitProductBasisV3AbiRust.lean; do not edit."
  emitBytes "BASIS_MAGIC_V3" basisMagic
  IO.println s!"pub const BASIS_SCHEMA_V3: u16 = {basisSchemaVersion};"
  IO.println s!"pub const BASIS_HEADER_BYTES_V3: usize = {headerBytes};"
  IO.println s!"pub const KNOT_BYTES_V3: usize = {knotBytes};"
  IO.println s!"pub const TERM_BYTES_V3: usize = {termBytes};"
  IO.println s!"pub const BASIS_CATEGORICAL_KIND_V3: u8 = {categoricalKind};"
  IO.println s!"pub const BASIS_GRADED_COMPLEMENT_KIND_V3: u8 = {gradedExactComplementKind};"
  IO.println s!"pub const BASIS_SPLINE_DEGREE_2_TO_3_KIND_V3: u8 = {splineDegree2To3Kind};"
  IO.println s!"pub const BASIS_SPLINE_MINIMUM_DEGREE_V3: u8 = {splineMinimumDegree};"
  IO.println s!"pub const BASIS_SPLINE_MAXIMUM_DEGREE_V3: u8 = {splineMaximumDegree};"
  IO.println s!"pub const EXACT_CATEGORICAL_BOUNDARY_V3: u8 = {exactCategoricalBoundary};"
  IO.println
    s!"pub const TERM_FLOOR_EXACT_COMPLEMENT_BOUNDARY_V3: u8 = {termFloorExactComplementBoundary};"
  IO.println s!"pub const TERM_CONSTANT_SHAPE_V3: u8 = {constantShape};"
  IO.println s!"pub const TERM_RAMP_UP_SHAPE_V3: u8 = {rampUpShape};"
  IO.println s!"pub const TERM_RAMP_DOWN_SHAPE_V3: u8 = {rampDownShape};"
  IO.println s!"pub const TERM_TENT_SHAPE_V3: u8 = {tentShape};"
  emitSlice "SEMANTIC_BASIS_CONTENT_DOMAIN_V3" semanticContentDomain
  emitSlice "LINKED_BASIS_CONTENT_DOMAIN_V3" linkedContentDomain
  emitOffsets headerLayout HeaderField.rustName
  emitOffsets termLayout TermField.rustName
