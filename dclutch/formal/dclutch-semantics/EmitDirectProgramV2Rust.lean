import DClutchSemantics.DirectProgramV2
import DClutchSemantics.RustEmit

open DClutch.RustEmit (rustByte)

open DClutch

def main : IO Unit := do
  let bytes := TransitionVMV2.Codec.encodeProgram DirectProgramV2.program
  IO.println "// @generated by formal/dclutch-semantics/EmitDirectProgramV2Rust.lean; do not edit."
  for register in DirectProgram.ScalarSlot.all do
    IO.println s!"pub const {DirectProgram.ScalarSlot.rustName register}: usize = {DirectProgram.ScalarSlot.index register};"
  for register in DirectProgram.IdentitySlot.all do
    IO.println s!"pub const {DirectProgram.IdentitySlot.rustName register}: usize = {DirectProgram.IdentitySlot.index register};"
  IO.println s!"pub const DIRECT_PROGRAM_V2_BYTES: usize = {bytes.length};"
  IO.println s!"pub const DIRECT_PROGRAM_V2_SCALARS: u16 = {DirectProgramV2.program.scalarWidth};"
  IO.println s!"pub const DIRECT_PROGRAM_V2_IDENTITIES: u16 = {DirectProgramV2.program.identityWidth};"
  IO.println "pub const DIRECT_PROGRAM_V2: [u8; DIRECT_PROGRAM_V2_BYTES] = ["
  for line in List.range ((bytes.length + 11) / 12) do
    let chunk := (bytes.drop (line * 12)).take 12
    IO.println s!"    {String.intercalate ", " (chunk.map rustByte)},"
  IO.println "];"
