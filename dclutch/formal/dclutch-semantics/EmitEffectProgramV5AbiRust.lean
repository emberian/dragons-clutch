import DClutchSemantics.EffectProgramV5Abi
import DClutchSemantics.RustEmit

open DClutch.RustEmit (emitBytes emitSlice)

/-! Emit only Lean-owned DCE6 constants and witness/refusal bytes. -/

open DClutch
open DClutch.EffectProgramV5Abi

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitEffectProgramV5AbiRust.lean; do not edit."
  emitBytes "EFFECT_V5_MAGIC_LEAN" magic
  IO.println s!"pub const EFFECT_V5_VERSION_LEAN: u8 = {version};"
  IO.println s!"pub const EFFECT_V5_MAX_FUNDING_ACTIONS_LEAN: u16 = {maxFundingActions};"
  IO.println s!"pub const EFFECT_V5_MAX_FUNDING_SEEDS_LEAN: u16 = {maxFundingSeeds};"
  IO.println s!"pub const EFFECT_V5_MAX_ACTION_SEEDS_LEAN: u8 = {maxActionSeeds};"
  IO.println s!"pub const EFFECT_V5_UNUSED_COORDINATE_LEAN: u16 = {unusedCoordinate};"
  IO.println s!"pub const EFFECT_V5_OPCODE_CREATE_LEAN: u8 = {opcodeCreate};"
  IO.println s!"pub const EFFECT_V5_OPCODE_CLOSE_LEAN: u8 = {opcodeClose};"
  IO.println s!"pub const EFFECT_V5_OPCODE_FUND_LEAN: u8 = {opcodeFund};"
  IO.println s!"pub const EFFECT_V5_SEED_LITERAL_LEAN: u8 = {seedLiteral};"
  IO.println s!"pub const EFFECT_V5_SEED_COMMON_SCALAR_LEAN: u8 = {seedCommonScalar};"
  IO.println s!"pub const EFFECT_V5_SEED_COMMON_IDENTITY_LEAN: u8 = {seedCommonIdentity};"
  IO.println s!"pub const EFFECT_V5_SEED_CANONICAL_BUMP_LEAN: u8 = {seedCanonicalBump};"
  IO.println s!"pub const EFFECT_V5_HEADER_BYTES_LEAN: usize = {headerBytes};"
  IO.println s!"pub const EFFECT_V5_FUNDING_ACTION_BYTES_LEAN: usize = {actionBytes};"
  IO.println s!"pub const EFFECT_V5_FUNDING_SEED_BYTES_LEAN: usize = {seedBytes};"
  emitSlice "EFFECT_V5_SCHEMA_RELEASE_PREIMAGE_LEAN" schemaReleasePreimage
  emitBytes "EFFECT_V5_SCHEMA_RELEASE_ID_LEAN" schemaReleaseId
  for field in headerLayout do
    IO.println s!"pub const {HeaderField.rustName field.spec.name}: usize = {field.offset};"
  for field in actionLayout do
    IO.println s!"pub const {ActionField.rustName field.spec.name}: usize = {field.offset};"
  for field in seedLayout do
    IO.println s!"pub const {SeedField.rustName field.spec.name}: usize = {field.offset};"
  IO.println "#[cfg(test)]"
  emitBytes "EFFECT_V5_ONE_FUND_HEADER_WITNESS" oneFundHeaderWitness
  IO.println "#[cfg(test)]"
  emitBytes "EFFECT_V5_FUND_ACTION_WITNESS" fundActionWitness
  IO.println "#[cfg(test)]"
  emitBytes "EFFECT_V5_FUND_WITH_SEEDS_REFUSAL" hostileFundWithSeeds
  IO.println "#[cfg(test)]"
  emitBytes "EFFECT_V5_FUND_WITH_WIDTH_REFUSAL" hostileFundWithWidth
  IO.println "#[cfg(test)]"
  emitBytes "EFFECT_V5_FUND_WITH_REFUND_REFUSAL" hostileFundWithRefund
