import DClutchSemantics.DealerScenarioSolvency

/-! Emit the Dealer scenario netting decision corpus.

Vectors, not the rule: `plan_scenario_netting` stays hand-written and this is
what makes it answerable to `DealerScenarioSolvency.lean`. -/

open DClutch
open DClutch.DealerScenarioSolvency

def main : IO Unit := do
  IO.println "// @generated by formal/dclutch-semantics/EmitDealerScenarioNettingCorpusRust.lean; do not edit."
  IO.println "/// One Dealer netting decision case, as Lean decides it."
  IO.println "#[derive(Clone, Copy, Debug, Eq, PartialEq)]"
  IO.println "pub struct DealerNettingVectorV1 {"
  IO.println "    /// The decision case this vector stands for."
  IO.println "    pub name: &'static str,"
  IO.println "    /// Per-coordinate inventory held before the transition."
  IO.println "    pub inventory: &'static [u64],"
  IO.println "    /// Per-coordinate Claims acquired by the transition."
  IO.println "    pub acquired: &'static [u64],"
  IO.println "    /// Per-coordinate Claims delivered by the transition."
  IO.println "    pub delivered: &'static [u64],"
  IO.println "    /// Least equal complete-set split covering every delivery."
  IO.println "    pub minimum_split: u64,"
  IO.println "    /// Largest equal complete-set merge no coordinate over-delivers."
  IO.println "    pub maximum_merge: u64,"
  IO.println "}"
  IO.println ""
  IO.println s!"pub const DEALER_NETTING_VECTORS_V1: [DealerNettingVectorV1; {nettingVectors.length}] = ["
  for vector in nettingVectors do
    let field (project : Scenario -> Nat) : String :=
      String.intercalate ", " (vector.book.map (fun scenario => toString (project scenario)))
    IO.println "    DealerNettingVectorV1 {"
    IO.println s!"        name: \"{vector.name}\","
    IO.println s!"        inventory: &[{field Scenario.inventory}],"
    IO.println s!"        acquired: &[{field Scenario.acquired}],"
    IO.println s!"        delivered: &[{field Scenario.delivered}],"
    IO.println s!"        minimum_split: {vector.split},"
    IO.println s!"        maximum_merge: {vector.merge},"
    IO.println "    },"
  IO.println "];"
