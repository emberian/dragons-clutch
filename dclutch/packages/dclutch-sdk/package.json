{
  "name": "@dclutch/sdk",
  "version": "0.1.0",
  "private": true,
  "description": "Read-first client SDK for dClutch: generated ABI modules, hostile decoders, exact previews, and only caller-complete transaction surfaces.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "exports": {
    ".": "./index.ts",
    "./directInlineV3": "./lib/directInlinePublicV3.ts",
    "./walletHandoff": "./lib/walletInspection.ts",
    "./directTransaction": null,
    "./directCodec": null,
    "./registeredDirect": null,
    "./generated/registeredDirect": null,
    "./*": "./lib/*.ts",
    "./generated/*": "./lib/generated/*.ts",
    "./fixtures/*": "./fixtures/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint lib scripts index.ts",
    "test": "vitest run --config vitest.config.ts",
    "abi:claims-replay": "node scripts/generate-claims-custody-replay.mjs",
    "abi:claims-replay:verify": "node scripts/generate-claims-custody-replay.mjs --check",
    "abi:wallet-terminal": "node scripts/generate-wallet-terminal-payout-v3.mjs",
    "abi:wallet-terminal:verify": "node scripts/generate-wallet-terminal-payout-v3.mjs --check",
    "abi:registered": "node scripts/lean-emit.mjs DClutchSemantics.DirectLifecycleAbi,DClutchSemantics.RegisteredControllerAbi EmitRegisteredDirectTs.lean lib/generated/registeredDirect.ts",
    "abi:registered:verify": "node scripts/lean-emit.mjs DClutchSemantics.DirectLifecycleAbi,DClutchSemantics.RegisteredControllerAbi EmitRegisteredDirectTs.lean lib/generated/registeredDirect.ts --check",
    "abi:infrastructure": "node scripts/lean-emit.mjs DClutchSemantics.ProtocolInfrastructureProfileAbi EmitProtocolInfrastructureTs.lean lib/generated/protocolInfrastructure.ts",
    "abi:infrastructure:verify": "node scripts/lean-emit.mjs DClutchSemantics.ProtocolInfrastructureProfileAbi EmitProtocolInfrastructureTs.lean lib/generated/protocolInfrastructure.ts --check",
    "abi:general-v5": "node scripts/generate-general-successor-v5.mjs",
    "abi:general-v5:verify": "node scripts/generate-general-successor-v5.mjs --check",
    "abi:found": "node scripts/generate-core-found.mjs",
    "abi:found:verify": "node scripts/generate-core-found.mjs --check",
    "abi:generic-founding": "node scripts/generate-generic-founding.mjs",
    "abi:generic-founding:verify": "node scripts/generate-generic-founding.mjs --check",
    "abi:principal-capacity": "node scripts/generate-principal-capacity.mjs",
    "abi:principal-capacity:verify": "node scripts/generate-principal-capacity.mjs --check",
    "abi:hot-bump-hint-slots": "node scripts/generate-hot-bump-hint-slots.mjs",
    "abi:hot-bump-hint-slots:verify": "node scripts/generate-hot-bump-hint-slots.mjs --check",
    "abi:direct-v3": "node scripts/generate-direct-inline-v3.mjs",
    "abi:direct-v3:verify": "node scripts/generate-direct-inline-v3.mjs --check",
    "abi:direct-participant": "node scripts/generate-direct-participant-v1.mjs",
    "abi:direct-participant:verify": "node scripts/generate-direct-participant-v1.mjs --check",
    "abi:dealer-v3": "node scripts/generate-dealer-equity-v3.mjs",
    "abi:dealer-v3:verify": "node scripts/generate-dealer-equity-v3.mjs --check",
    "abi:rational-terminal-v3": "node scripts/lean-emit.mjs DClutchSemantics.RationalRepresentationV2PhysicalAbi,DClutchSemantics.RationalTerminalHotV3Abi EmitRationalTerminalHotV3Ts.lean lib/generated/rationalTerminalHotV3.ts",
    "abi:rational-terminal-v3:verify": "node scripts/lean-emit.mjs DClutchSemantics.RationalRepresentationV2PhysicalAbi,DClutchSemantics.RationalTerminalHotV3Abi EmitRationalTerminalHotV3Ts.lean lib/generated/rationalTerminalHotV3.ts --check",
    "abi:rational-open-wasm": "node scripts/generate-rational-open-wasm.mjs",
    "abi:rational-open-wasm:verify": "node scripts/generate-rational-open-wasm.mjs --check",
    "abi:source-resolution-state-v2": "node scripts/generate-source-resolution-state-v2.mjs",
    "abi:source-resolution-state-v2:verify": "node scripts/generate-source-resolution-state-v2.mjs --check",
    "abi:resolution-certificate-v2": "node scripts/generate-resolution-certificate-v2.mjs",
    "abi:resolution-certificate-v2:verify": "node scripts/generate-resolution-certificate-v2.mjs --check",
    "abi:aggregate-retirement": "node scripts/generate-aggregate-retirement-v1.mjs",
    "abi:aggregate-retirement:verify": "node scripts/generate-aggregate-retirement-v1.mjs --check",
    "abi:product-v2-payoff": "node scripts/generate-product-v2-payoff.mjs",
    "abi:product-v2-payoff:verify": "node scripts/generate-product-v2-payoff.mjs --check",
    "abi:product-runtime-v2-admission": "node scripts/generate-product-runtime-v2-admission.mjs",
    "abi:product-runtime-v2-admission:verify": "node scripts/generate-product-runtime-v2-admission.mjs --check",
    "abi:realm-position": "node scripts/lean-emit.mjs DClutchSemantics.RealmPositionAbi EmitRealmPositionAbiTs.lean lib/generated/realmPositionV1.ts",
    "abi:realm-position:verify": "node scripts/lean-emit.mjs DClutchSemantics.RealmPositionAbi EmitRealmPositionAbiTs.lean lib/generated/realmPositionV1.ts --check",
    "abi:capability-manifest": "node scripts/lean-emit.mjs DClutchSemantics.CapabilityManifestV1Abi EmitCapabilityManifestV1AbiTs.lean lib/generated/capabilityManifestV1.ts",
    "abi:capability-manifest:verify": "node scripts/lean-emit.mjs DClutchSemantics.CapabilityManifestV1Abi EmitCapabilityManifestV1AbiTs.lean lib/generated/capabilityManifestV1.ts --check",
    "abi:refusal-bands": "node scripts/lean-emit.mjs DClutchSemantics.RefusalBandsV1 EmitRefusalBandsV1Ts.lean lib/generated/refusalBandsV1.ts",
    "abi:refusal-bands:verify": "node scripts/lean-emit.mjs DClutchSemantics.RefusalBandsV1 EmitRefusalBandsV1Ts.lean lib/generated/refusalBandsV1.ts --check",
    "abi:refusal-registry": "node scripts/generate-refusal-registry.mjs",
    "abi:refusal-registry:verify": "node scripts/generate-refusal-registry.mjs --check",
    "abi:phase-admission": "node scripts/generate-market-phase-admission.mjs",
    "abi:phase-admission:verify": "node scripts/generate-market-phase-admission.mjs --check",
    "abi:relay-transport": "node scripts/generate-relay-transport.mjs",
    "abi:relay-transport:verify": "node scripts/generate-relay-transport.mjs --check",
    "abi:state-machines": "node scripts/generate-state-machines-v1.mjs",
    "abi:state-machines:verify": "node scripts/generate-state-machines-v1.mjs --check",
    "abi:route-census": "node scripts/generate-route-census.mjs",
    "abi:route-census:verify": "node scripts/generate-route-census.mjs --check",
    "abi:coverage": "node scripts/abi-coverage.mjs"
  },
  "dependencies": {
    "@solana/web3.js": "1.98.4"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "eslint": "9.39.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4",
    "vitest": "4.0.17"
  }
}
