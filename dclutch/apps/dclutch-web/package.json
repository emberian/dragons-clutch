{
  "name": "dclutch-web",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "test": "vitest run --config vitest.config.ts",
    "abi:partition-quality-wasm": "node scripts/generate-partition-quality-wasm.mjs",
    "abi:partition-quality-wasm:verify": "node scripts/generate-partition-quality-wasm.mjs --check",
    "abi:source-readiness": "node scripts/generate-source-readiness-wasm.mjs",
    "abi:source-readiness:verify": "node scripts/generate-source-readiness-wasm.mjs --check",
    "abi:wallet-terminal-payout": "node scripts/generate-wallet-terminal-payout-wasm.mjs",
    "abi:wallet-terminal-payout:verify": "node scripts/generate-wallet-terminal-payout-wasm.mjs --check",
    "abi:wallet-terminal-input": "node scripts/generate-wallet-terminal-input-wasm.mjs",
    "abi:wallet-terminal-input:verify": "node scripts/generate-wallet-terminal-input-wasm.mjs --check",
    "abi:user-position-admission": "node scripts/generate-user-position-admission-wasm.mjs",
    "abi:user-position-admission:verify": "node scripts/generate-user-position-admission-wasm.mjs --check",
    "abi:source-provider": "node scripts/generate-source-provider-wasm.mjs",
    "abi:source-provider:verify": "node scripts/generate-source-provider-wasm.mjs --check",
    "abi:product-payoff-v2-wasm": "node scripts/generate-product-payoff-v2-wasm.mjs",
    "abi:product-payoff-v2-wasm:verify": "node scripts/generate-product-payoff-v2-wasm.mjs --check",
    "abi:capability-surface": "node scripts/generate-capability-surface.mjs",
    "abi:capability-surface:verify": "node scripts/generate-capability-surface.mjs --check",
    "abi:sbf-runtime": "node scripts/generate-sbf-runtime.mjs",
    "abi:sbf-runtime:verify": "node scripts/generate-sbf-runtime.mjs --check",
    "abi:coverage": "node ../../tools/abi-coverage/abi-coverage.mjs",
    "explorer:coverage": "node scripts/explorer-coverage.mjs",
    "a11y:coverage": "node scripts/a11y-coverage.mjs",
    "sbom": "python3 ../../tools/sbom/sbom_check.py",
    "sbom:verify": "python3 ../../tools/sbom/sbom_check.py --verify"
  },
  "dependencies": {
    "@dclutch/sdk": "file:../../packages/dclutch-sdk",
    "@solana/wallet-standard-features": "1.4.0",
    "@solana/web3.js": "1.98.4",
    "@wallet-standard/app": "1.1.1",
    "@wallet-standard/features": "1.1.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "next": "16.3.3",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.1",
    "@cloudflare/workers-types": "5.20260828.1",
    "@openai/sites-vite-plugin": "0.2.0",
    "@tailwindcss/postcss": "4.2.1",
    "@types/jsdom": "30.0.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.34",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.3",
    "jsdom": "30.0.1",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.8",
    "vite": "8.2.2",
    "vitest": "4.1.11",
    "wrangler": "4.127.0"
  },
  "type": "module",
  "overrides": {
    "utf-8-validate": "^6.0.6"
  }
}
