#!/bin/sh
# Lean emission guard, as a pre-push hook.
#
# Two tiers, because they cost very different amounts:
#
#   1. The census (milliseconds, no toolchain). Always runs. Fails the push if
#      tools/emission-guard/COVERAGE.md is stale -- which happens when a
#      generated file arrives or disappears, and most importantly when a new
#      emission arrives with NO check script behind it. That is the case this
#      hook exists to make un-ignorable.
#
#   2. The byte-identity checks (needs `lake` and `rustfmt`; a Lean build).
#      Runs ONLY over the guards a pushed range could actually have moved. A
#      push that touches no Lean source and no generated file pays nothing.
#
# Escape hatch, deliberately provided: SKIP_EMISSION_GUARD=1 git push. A hook
# that cannot be skipped is a hook that gets uninstalled, and then nothing is
# guarded at all. Skipping is visible in the log below.
#
# Installed by tools/emission-guard/install-hooks.sh -- see the README for
# what that does to git config and why it is opt-in.

set -eu

repository_dir=$(git rev-parse --show-toplevel)
guard="$repository_dir/tools/emission-guard/emission_guard.py"

if [ ! -f "$guard" ]; then
  exit 0  # not this repository, or a checkout that predates the guard
fi

if [ "${SKIP_EMISSION_GUARD:-}" = "1" ]; then
  echo "emission-guard: SKIPPED by SKIP_EMISSION_GUARD=1" >&2
  exit 0
fi

if ! python3 "$guard" --verify; then
  echo >&2
  echo "emission-guard: the generated-file census is stale." >&2
  echo "  Run: tools/emission-guard/emission_guard.py --write" >&2
  echo "  Then READ the diff. If the unguarded count went UP, a generated" >&2
  echo "  file just arrived with nothing checking its bytes." >&2
  exit 1
fi

# git feeds pre-push one line per ref: <local ref> <local sha> <remote ref> <remote sha>
zero='0000000000000000000000000000000000000000'
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue  # a deletion pushes no content

  if [ "$remote_sha" = "$zero" ]; then
    # A new branch. Comparing against the whole of history would select every
    # guard on every first push of a branch, which is exactly the cost that
    # gets a hook disabled. The merge-base against the default branch is the
    # honest range: the commits this push actually adds.
    base=$(git merge-base "$local_sha" HEAD@{upstream} 2>/dev/null \
        || git merge-base "$local_sha" main 2>/dev/null \
        || echo '')
    [ -z "$base" ] && continue
    range="$base..$local_sha"
  else
    range="$remote_sha..$local_sha"
  fi

  python3 "$guard" --run "$range" || status=1
done

if [ "$status" -ne 0 ]; then
  echo >&2
  echo "emission-guard: a generated file does not match what its Lean" >&2
  echo "  emitter produces. Regenerate it from Lean -- do NOT edit the" >&2
  echo "  generated file to make this pass. Push anyway with" >&2
  echo "  SKIP_EMISSION_GUARD=1 if you know why." >&2
fi
exit "$status"
