  "required_commits": {
    "closure-burn": {
      "rev": "7d45d6ba3",
      "why": "the closure burns the failure column no certificate pays, so a refunding market can reach BeginRetiring; Claims and Core both move"
    },
    "host-retirement-tail": {
      "rev": "42c3bb931",
      "why": "the retirement journal derives its two account shapes and threads the linked basis record, so a refunding retirement is buildable at all"
    },
    "general-liability-basis": {
      "rev": "1dd18be91",
      "why": "the General account profile projects the portfolio's LIABILITY basis at offset 128, which is what the accelerator's config binds; it moves the published artifact and no link"
    },
    "profile-checkpoints": {
      "rev": "fc39a5bc7",
      "why": "the hot-cu checkpoints reach the strategy, the lifecycle preplan and the caller authority; the OpenBatch walls were localized with them"
    },
    "caller-authority-seed": {
      "rev": "1cae26fd6",
      "why": "the caller-authority seed change the General route needs; step 03 on chain is its only proof"
    },
    "statistic-source-scale": {
      "rev": "4cd2b9cb5",
      "why": "StatisticSpecV1 carries source_scale_exponent, so cuts in dollars mean what they say"
    },
    "one-accelerator": {
      "rev": "5b4fe2313",
      "why": "the folded accelerator link -- General, Dealer and series-shadow in one program"
    },
    "recovery-ladder-alternative": {
      "rev": "beca9243e",
      "why": "the ladder's alternative source can be observed and a market answered on its second rung"
    },
    "funded-rent-rate": {
      "rev": "c0a1586b1",
      "why": "the funding ledger header records the exemption-scaled rent rate it was funded at"
    },
    "failure-arm": {
      "rev": "82bbb10c1",
      "why": "the exhausted terminal is a driven act: dclutch_operator::deadline_failure_v1 authors the 22-account CommitDeadlineFailure frame, the successor carries devnet-commit-deadline-failure-v1 and devnet-admit-terminal-v1, and the Claims link carries ClaimsSbfError::Overdraw (0x5012) so an overstated terminal payout quantity refuses by name rather than as Economic. The Claims ELF moves for it"
    }
  },
