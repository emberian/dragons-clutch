#!/usr/bin/env bash
# Fresh deterministic localhost profile: real dClutch + Pyth + SPL Token programs.
set -euo pipefail

readonly LAUNCHER_VERSION="1"
readonly DCLUTCH_ID="5oEzAP4izB65uRm2yDAEf9oALGwHpWkDfyKb8zBY3euC"
readonly RECEIVER_ID="rec2HHDDnjLfj4kE7VyEtFA1HPGQLK33259532cRyHp"
readonly ROUTER_ID="HDw2E7P8X1SkCyjvoGsfBGAVUutKcj874bXjHrpVYrVL"
readonly TOKEN_ID="TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA"
readonly TOKEN_2022_ID="TokenzQdBNbLqP5VEhdkAS6EPFLC1PHnBqCXEpPxuEb"
readonly RPC_PORT="19890"
readonly FAUCET_PORT="19892"
readonly GOSSIP_PORT="19893"
readonly DYNAMIC_PORT_RANGE="19900-19931"
readonly MINT_PUBKEY="11111111111111111111111111111111"

SCRIPT_DIR=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
REPO_ROOT=$(cd -- "$SCRIPT_DIR/../.." && pwd -P)
FIXTURE_DIR="$REPO_ROOT/fixtures/pyth/local-upgraded-2026-08-22"
PROFILE_NAME="dclutch-integrated-validator-profile.json"
SENTINEL_NAME=".dclutch-integrated-validator-owner"
PID_NAME="dclutch-integrated-validator.pid"

die() { printf 'dclutch-integrated-validator: %s\n' "$*" >&2; exit 1; }

usage() {
  cat <<'EOF'
Usage:
  dclutch-integrated-validator start --ledger ABSOLUTE_NEW_DIR \
    --dclutch-elf PATH --dclutch-sha256 SHA256 \
    --source-commit GIT_COMMIT --source-archive-sha256 SHA256 \
    --sbf-attestation ABSOLUTE_JSON
  dclutch-integrated-validator status --ledger ABSOLUTE_DIR
  dclutch-integrated-validator stop --ledger ABSOLUTE_DIR

The profile binds only to 127.0.0.1 on deterministic ports 19890-19931. It
never reads Solana CLI configuration or caller wallets. Validator, faucet,
vote, and stake keys may exist only inside the explicitly scoped fresh ledger.
EOF
}

sha256() { shasum -a 256 "$1" | awk '{print $1}'; }
require_command() { command -v "$1" >/dev/null 2>&1 || die "required command not found: $1"; }
is_sha256() { [[ "$1" =~ ^[0-9a-f]{64}$ ]]; }
is_commit() { [[ "$1" =~ ^[0-9a-f]{40}$ ]]; }

canonical_existing_file() {
  [[ -f "$1" ]] || die "not a regular file: $1"
  local parent base
  parent=$(cd -- "$(dirname -- "$1")" && pwd -P)
  base=$(basename -- "$1")
  printf '%s/%s\n' "$parent" "$base"
}

canonical_new_ledger() {
  [[ "$1" = /* ]] || die "--ledger must be absolute"
  [[ ! -e "$1" && ! -L "$1" ]] || die "ledger must be a fresh nonexistent path: $1"
  local parent base
  parent=$(cd -- "$(dirname -- "$1")" && pwd -P) || die "ledger parent does not exist"
  base=$(basename -- "$1")
  [[ -n "$base" && "$base" != "." && "$base" != ".." && "$parent" != "/" ]] || die "unsafe ledger path"
  printf '%s/%s\n' "$parent" "$base"
}

canonical_owned_ledger() {
  [[ "$1" = /* && -d "$1" && ! -L "$1" ]] || die "not an integrated ledger directory: $1"
  local ledger
  ledger=$(cd -- "$1" && pwd -P)
  [[ -f "$ledger/$SENTINEL_NAME" ]] || die "refusing a directory without this tool's sentinel"
  [[ "$(<"$ledger/$SENTINEL_NAME")" = "dclutch-integrated-validator-ledger-v1" ]] || die "invalid ledger sentinel"
  printf '%s\n' "$ledger"
}

json_string() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  value=${value//$'\n'/\\n}
  printf '"%s"' "$value"
}

rpc_ready() {
  curl --fail --silent --show-error --max-time 1 \
    -H 'content-type: application/json' \
    --data '{"jsonrpc":"2.0","id":1,"method":"getHealth"}' \
    "http://127.0.0.1:$RPC_PORT" | grep -q '"result":"ok"'
}

pid_is_ours() {
  local ledger=$1 pid=$2 command_line
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  kill -0 "$pid" 2>/dev/null || return 1
  command_line=$(ps -p "$pid" -o command= 2>/dev/null || true)
  [[ "$command_line" == *"solana-test-validator"* && "$command_line" == *"--ledger $ledger"* && "$command_line" == *"--rpc-port $RPC_PORT"* ]]
}

validate_attestation() {
  local attestation=$1 elf=$2 elf_hash=$3 source_commit=$4 archive_hash=$5
  jq -e \
    --arg commit "$source_commit" \
    --arg archive "$archive_hash" \
    --arg elf "$elf" \
    --arg elf_hash "$elf_hash" \
    --arg program_id "$DCLUTCH_ID" \
    '.commit == $commit and
     .archive_sha256 == $archive and
     .elf_path == $elf and
     .elf_sha256 == $elf_hash and
     .program_id == $program_id and
     (.cargo_build_sbf_version | type == "string" and length > 0) and
     (.platform_tools_version | type == "string" and length > 0) and
     (.rustc_version | type == "string" and length > 0) and
     (.build_command | type == "string" and length > 0) and
     (.build_log_sha256 | type == "string" and test("^[0-9a-f]{64}$")) and
     .verifier.status == "clean" and
     .verifier.diagnostic_count == 0' \
    "$attestation" >/dev/null || die "SBF attestation is missing, malformed, non-clean, or not bound to the exact source/ELF/program pins"
}

write_profile() {
  local ledger=$1 elf=$2 elf_hash=$3 source_commit=$4 archive_hash=$5 attestation=$6 attestation_hash=$7 validator=$8 version=$9
  {
    printf '{\n'
    printf '  "schema": "dclutch-integrated-local-validator-profile-v1",\n'
    printf '  "launcher_version": "%s",\n' "$LAUNCHER_VERSION"
    printf '  "network": {"bind_address":"127.0.0.1","rpc_url":"http://127.0.0.1:%s","rpc_port":%s,"websocket_port":%s,"faucet_port":%s,"gossip_port":%s,"dynamic_port_range":"%s"},\n' "$RPC_PORT" "$RPC_PORT" "$((RPC_PORT + 1))" "$FAUCET_PORT" "$GOSSIP_PORT" "$DYNAMIC_PORT_RANGE"
    printf '  "config_path": "/dev/null",\n'
    printf '  "key_policy": "No caller keypair is read. Validator-internal keys remain in this fresh ledger; bootstrap payer and action keys are ephemeral in process memory.",\n'
    printf '  "artifact_admission": "ELF magic/SHA-256 and a source/ELF/program-bound clean-verifier attestation are checked before launch. Validator genesis acceptance and the guarded RPC health probe are a second gate; verifier failure exits before ready and is refused as an integrated profile.",\n'
    printf '  "validator": {"path":'; json_string "$validator"; printf ',"version":'; json_string "$version"; printf '},\n'
    printf '  "ledger": '; json_string "$ledger"; printf ',\n'
    printf '  "dclutch_source": {"commit":"%s","archive_sha256":"%s","elf_sha256":"%s"},\n' "$source_commit" "$archive_hash" "$elf_hash"
    printf '  "sbf_attestation": {"path":'; json_string "$attestation"; printf ',"sha256":"%s","verifier_status":"clean","diagnostic_count":0},\n' "$attestation_hash"
    printf '  "programs": [\n'
    printf '    {"name":"dclutch","program_id":"%s","elf_path":' "$DCLUTCH_ID"; json_string "$elf"; printf ',"elf_sha256":"%s","loader":"upgradeable","upgrade_authority":"none"},\n' "$elf_hash"
    printf '    {"name":"pyth-receiver","program_id":"%s","elf_path":' "$RECEIVER_ID"; json_string "$FIXTURE_DIR/receiver.so"; printf ',"elf_sha256":"c5079559864fc34dbd5fe87b4aa9fba3a1ed22690363ec490449e8660e73af64","loader":"upgradeable","upgrade_authority":"none"},\n'
    printf '    {"name":"pyth-router","program_id":"%s","elf_path":' "$ROUTER_ID"; json_string "$FIXTURE_DIR/router.so"; printf ',"elf_sha256":"f9061f03a81b89db29f4603677e3b3d89b3bbf08d67827b2832f18a4e2b61acb","loader":"upgradeable","upgrade_authority":"none"},\n'
    printf '    {"name":"spl-token","program_id":"%s","source":"solana-test-validator genesis","loader":"upgradeable"},\n' "$TOKEN_ID"
    printf '    {"name":"spl-token-2022","program_id":"%s","source":"solana-test-validator genesis","loader":"upgradeable"}\n' "$TOKEN_2022_ID"
    printf '  ],\n'
    printf '  "loader_time_boundary": "Local validator regenerates Loader V3 headers, deployment slots, and current clock. Bootstrap evidence must verify ELF tails and must not claim captured provider release identity or time-valid dClutch resolution."\n'
    printf '}\n'
  } > "$ledger/$PROFILE_NAME"
}

start() {
  local ledger_arg='' elf_arg='' expected_hash='' source_commit='' archive_hash='' attestation_arg=''
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --ledger) ledger_arg=${2-}; shift 2 ;;
      --dclutch-elf) elf_arg=${2-}; shift 2 ;;
      --dclutch-sha256) expected_hash=${2-}; shift 2 ;;
      --source-commit) source_commit=${2-}; shift 2 ;;
      --source-archive-sha256) archive_hash=${2-}; shift 2 ;;
      --sbf-attestation) attestation_arg=${2-}; shift 2 ;;
      *) die "unknown start option: $1" ;;
    esac
  done
  [[ -n "$ledger_arg" && -n "$elf_arg" && -n "$expected_hash" && -n "$source_commit" && -n "$archive_hash" && -n "$attestation_arg" ]] || die "start requires all artifact, provenance, and verifier-attestation options"
  is_sha256 "$expected_hash" || die "--dclutch-sha256 must be lowercase SHA-256"
  is_sha256 "$archive_hash" || die "--source-archive-sha256 must be lowercase SHA-256"
  is_commit "$source_commit" || die "--source-commit must be a full lowercase Git commit"
  require_command shasum
  require_command curl
  require_command jq
  require_command solana-test-validator
  "$SCRIPT_DIR/dclutch-local-validator" verify-fixtures >/dev/null
  local ledger elf observed_hash attestation attestation_hash validator version magic
  ledger=$(canonical_new_ledger "$ledger_arg")
  elf=$(canonical_existing_file "$elf_arg")
  magic=$(od -An -tx1 -N4 "$elf" | tr -d '[:space:]')
  [[ "$magic" = "7f454c46" ]] || die "dClutch artifact is not an ELF"
  observed_hash=$(sha256 "$elf")
  [[ "$observed_hash" = "$expected_hash" ]] || die "dClutch ELF SHA-256 mismatch"
  attestation=$(canonical_existing_file "$attestation_arg")
  validate_attestation "$attestation" "$elf" "$observed_hash" "$source_commit" "$archive_hash"
  attestation_hash=$(sha256 "$attestation")
  validator=$(canonical_existing_file "$(command -v solana-test-validator)")
  version=$("$validator" --version 2>&1 | head -n 1)
  [[ "$version" == solana-test-validator\ 4.0.2\ * ]] || die "requires solana-test-validator 4.0.2; found $version"

  mkdir -- "$ledger"
  printf 'dclutch-integrated-validator-ledger-v1\n' > "$ledger/$SENTINEL_NAME"
  write_profile "$ledger" "$elf" "$observed_hash" "$source_commit" "$archive_hash" "$attestation" "$attestation_hash" "$validator" "$version"
  nohup "$validator" \
    --config /dev/null \
    --ledger "$ledger" \
    --mint "$MINT_PUBKEY" \
    --bind-address 127.0.0.1 \
    --rpc-port "$RPC_PORT" \
    --faucet-port "$FAUCET_PORT" \
    --gossip-port "$GOSSIP_PORT" \
    --dynamic-port-range "$DYNAMIC_PORT_RANGE" \
    --upgradeable-program "$DCLUTCH_ID" "$elf" none \
    --upgradeable-program "$RECEIVER_ID" "$FIXTURE_DIR/receiver.so" none \
    --upgradeable-program "$ROUTER_ID" "$FIXTURE_DIR/router.so" none \
    > "$ledger/launcher.log" 2>&1 < /dev/null &
  local pid=$!
  printf '%s\n' "$pid" > "$ledger/$PID_NAME"
  local _
  for _ in $(seq 1 45); do
    if rpc_ready; then
      printf 'ready: http://127.0.0.1:%s\npid: %s\nprofile: %s\n' "$RPC_PORT" "$pid" "$ledger/$PROFILE_NAME"
      return 0
    fi
    if ! kill -0 "$pid" 2>/dev/null; then
      die "validator exited before readiness; inspect $ledger/launcher.log"
    fi
    sleep 1
  done
  kill "$pid" 2>/dev/null || true
  die "validator did not become ready; inspect $ledger/launcher.log"
}

status() {
  [[ $# -eq 2 && "$1" = "--ledger" ]] || die "usage: status --ledger ABSOLUTE_DIR"
  local ledger pid=''
  ledger=$(canonical_owned_ledger "$2")
  [[ -f "$ledger/$PID_NAME" ]] && pid=$(<"$ledger/$PID_NAME")
  if pid_is_ours "$ledger" "$pid" && rpc_ready; then
    printf '{"status":"ready","pid":%s,"rpc_url":"http://127.0.0.1:%s","profile":' "$pid" "$RPC_PORT"; json_string "$ledger/$PROFILE_NAME"; printf '}\n'
  else
    printf '{"status":"not-ready","pid":'; [[ "$pid" =~ ^[0-9]+$ ]] && printf '%s' "$pid" || printf 'null'; printf '}\n'
    return 1
  fi
}

stop() {
  [[ $# -eq 2 && "$1" = "--ledger" ]] || die "usage: stop --ledger ABSOLUTE_DIR"
  local ledger pid
  ledger=$(canonical_owned_ledger "$2")
  [[ -f "$ledger/$PID_NAME" ]] || die "missing managed validator pid"
  pid=$(<"$ledger/$PID_NAME")
  pid_is_ours "$ledger" "$pid" || die "refusing to signal stale or unrecognized pid"
  kill "$pid"
  printf 'sent TERM to managed validator pid %s\n' "$pid"
}

main() {
  [[ $# -ge 1 ]] || { usage >&2; exit 1; }
  case "$1" in
    start) shift; start "$@" ;;
    status) shift; status "$@" ;;
    stop) shift; stop "$@" ;;
    -h|--help|help) usage ;;
    *) die "unknown command: $1" ;;
  esac
}

main "$@"
