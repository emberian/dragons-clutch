{
  "_": [
    "tools/gate citations -- every commit-shaped token this register does not adjudicate must resolve.",
    "A row is an ADJUDICATION, not a suppression: it says what the token is instead of a commit of this tree,",
    "and the gate refuses if the token starts resolving, or if no document cites it any more."
  ],
  "classes": {
    "compost-commit": "a commit of ~/dev/dragons-clutch -- the compost and publication repository -- and never of this tree; `tools/cut.sh` cut shas and pre-successor history both land here",
    "harness-session": "a Claude Code session id, not a commit; the founding sessions predate this repository and are in no git object database",
    "release-set-id": "a TRUNCATED release-set identity, and the document that cites it exists to record that the truncation is unrecoverable",
    "schema-digest": "a per-action record digest in decision 0010's width table, hex by construction and never a commit",
    "artifact-digest": "a SHA-1/SHA-256 digest or its prefix -- an ELF, a git tree, a seed, a record body -- named as an artifact identity, not a commit",
    "magnitude": "a decimal amount, slot, unix time, run id or address that is hex-shaped by accident",
    "wire-bytes": "a literal byte string quoted from a wire or account body, hex by definition"
  },
